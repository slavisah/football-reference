---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { withBase } from '../lib/url';
import { t, type Locale } from '../lib/i18n';

interface Props {
  title: string;
  description?: string;
  /** Defaults to 'en'; only pages with a translation pass this. */
  locale?: Locale;
  /** The equivalent page in the other language, if one exists. */
  alternateHref?: string;
}

const { title, description, locale = 'en', alternateHref } = Astro.props;
const fullTitle =
  title === 'The Ultimate Football Reference'
    ? title
    : `${title} · The Ultimate Football Reference`;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase('/favicon.svg')} />
    <link rel="manifest" href={withBase('/manifest.webmanifest')} />
    <link rel="apple-touch-icon" href={withBase('/icons/icon-192.png')} />
    <meta name="theme-color" content="#1f6f4f" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Football Reference" />
    <meta name="color-scheme" content="light dark" />

    {/* Apply the saved theme before paint to avoid a flash. */}
    <script is:inline>
      (function () {
        try {
          var saved = localStorage.getItem('theme');
          if (saved === 'light' || saved === 'dark') {
            document.documentElement.dataset.theme = saved;
          }
        } catch (e) {}
      })();
    </script>

    {/* Offline reading + installability. Only registered for production
    builds (import.meta.env.PROD) - in dev the site isn't static, and a
    caching service worker would just get in the developer's way. */}
    {
      import.meta.env.PROD && (
        <script
          is:inline
          define:vars={{
            swUrl: withBase('/sw.js'),
            swScope: withBase('/'),
          }}
        >
          if ('serviceWorker' in navigator) {
            window.addEventListener('load', () => {
              navigator.serviceWorker.register(swUrl, { scope: swScope }).catch(() => {});
            });
          }
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{t(locale, 'skipToContent')}</a>
    <Nav locale={locale} alternateHref={alternateHref} />
    <main id="main" tabindex="-1">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer locale={locale} />
  </body>
</html>
