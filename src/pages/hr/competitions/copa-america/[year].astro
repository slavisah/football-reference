---
// Croatian translation of src/pages/competitions/copa-america/[year].astro -
// one page per Copa América edition. Loads the exact same content as the
// English route so the placings and final result can't drift between
// languages; only this page's own chrome (column labels, prose) is Croatian,
// the same convention every other hr competition/edition page here follows.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import EditionView from '../../../../components/EditionView.astro';
import References from '../../../../components/References.astro';
import { loadCompetition } from '../../../../lib/competition';
import { buildYearStories } from '../../../../lib/editions';
import { buildEditionProfiles, editionSlug, type EditionProfile } from '../../../../lib/editionProfile';
import { buildAllCountryRecords } from '../../../../lib/compare';
import { loadTeamCompetitions } from '../../../../lib/teamCompetitions';
import { teamProfileSlug } from '../../../../lib/teamProfile';
import type { SourceLink } from '../../../../lib/sources';
import { absolutePageUrl, withBase } from '../../../../lib/url';
import { buildEditionSportsEvent } from '../../../../lib/jsonLd';

// Croatian column-label translations, matching hr/competitions/copa-america.astro's own map.
const HEADER_LABELS: Record<string, string> = {
  'Host / format': 'Domaćin / format',
  Champion: 'Prvak',
  'Runner-up': 'Drugoplasirani',
  Third: 'Treći',
  Fourth: 'Četvrti',
  Format: 'Format',
  'Final date': 'Datum finala',
};

export async function getStaticPaths() {
  // Matches hr/competitions/copa-america.astro's own hand-translated
  // "Nezaboravni trenuci" bullets, kept in sync with that page.
  const CROATIAN_MOMENTS = [
    'Argentina, Brazil, Čile i Urugvaj sudjelovali su na prvom izdanju 1916. godine.',
    'Bolivija je osvojila svoju jedinu titulu kao domaćin 1963. godine.',
    'Kolumbija je osvojila svoju prvu titulu 2001. godine.',
    'Čile je osvojio svoje prve dvije titule u uzastopnim izdanjima, 2015. i 2016.',
    'Argentina je 2024. preuzela vodstvo kao najuspješnija reprezentacija natjecanja.',
  ];

  const [data, teamData] = await Promise.all([
    loadCompetition('copa-america', {
      editionsHeading: 'Champions timeline',
      sourcesHeading: 'Copa América',
      allowDuplicateYears: ['1959'],
    }),
    loadTeamCompetitions(),
  ]);

  const teamSlugs = new Set(
    buildAllCountryRecords(teamData.competitions).map((record) => teamProfileSlug(record.id)),
  );
  const stories = buildYearStories(data.editions, CROATIAN_MOMENTS);

  return buildEditionProfiles(data.editions, teamSlugs).map((profile) => ({
    params: { year: profile.slug },
    props: {
      profile,
      story: stories.get(profile.year),
      sources: data.sources,
      lastReviewed: data.lastReviewed,
      status: data.status,
    },
  }));
}

type Props = {
  profile: EditionProfile;
  story?: string;
  sources: SourceLink[];
  lastReviewed: string;
  status: string;
};

const { profile, story, sources, lastReviewed, status } = Astro.props as Props;
const statusText = status === 'verified' ? 'Provjereno' : 'U pregledu';

const isDisambiguated = profile.slug !== editionSlug(profile.year);
const yearLabel = isDisambiguated && profile.host ? `${profile.year}. (${profile.host})` : `${profile.year}.`;

const runnerUp = profile.facts.find((fact) => /runner-up/i.test(fact.label))?.value;
const title = `Copa América ${yearLabel}`;
const description = [
  `Copa América ${yearLabel}:`,
  profile.champion ? `prvak ${profile.champion}${runnerUp ? `, drugoplasirani ${runnerUp}` : ''}.` : '',
  profile.host ? `Domaćin: ${profile.host}.` : '',
  'Potpuni plasmani i rezultat finala tog izdanja.',
]
  .filter(Boolean)
  .join(' ');

const pageUrl = absolutePageUrl(Astro.url, Astro.site);
const jsonLd = [buildEditionSportsEvent(profile, { pageUrl, name: title })];
---

<BaseLayout
  title={title}
  description={description}
  locale="hr"
  alternateHref={withBase(`/competitions/copa-america/${profile.slug}`)}
  breadcrumbTrail={[{ name: 'Copa América', url: withBase('/hr/competitions/copa-america') }]}
  jsonLd={jsonLd}
>
  <EditionView
    profile={profile}
    competitionPath="/hr/competitions/copa-america"
    competitionTitle="Copa América"
    story={story}
    locale="hr"
    headerLabels={HEADER_LABELS}
    eyebrow="Generirano iz tablice natjecanja"
    headingTemplate={`${yearLabel} {competition}`}
    introTemplate="Sve što tablica izdanja bilježi o ovom izdanju, uz poveznicu na potpunu povijest svake reprezentacije."
    pagerLabel="Ostala izdanja"
    previousLabel="Prethodno izdanje"
    nextLabel="Sljedeće izdanje"
    backLabel="Sva izdanja natjecanja {competition}"
    teamProfileHintTemplate="{team} — potpuna povijest"
    storyHeading="Priča o ovom izdanju"
    glanceHeading={`${yearLabel} na prvi pogled`}
    pdfSlug={`edition-copa-america-${profile.slug}-hr`}
    pdfLabel="Preuzmi PDF za ispis"
    pdfHint="A4 položeno, potpuni plasmani i rezultat finala ovog izdanja."
  >
    <References
      sources={sources}
      lastReviewed={lastReviewed}
      status={status}
      heading="Izvori i provjera"
      statusPrefix="Status:"
      statusText={statusText}
      lastReviewedPrefix="Zadnja provjera:"
      dateLocale="hr-HR"
      noSourcesText="Za ovu stranicu još nisu navedene poveznice na izvore."
    />
  </EditionView>
</BaseLayout>
