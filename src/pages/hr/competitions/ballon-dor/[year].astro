---
// Croatian translation of src/pages/competitions/ballon-dor/[year].astro -
// one page per Men's Ballon d'Or edition. Loads the exact same content as
// the English route so the winner and national team can't drift between
// languages; only this page's own chrome (column labels, prose) is
// Croatian, the same convention every other hr competition/edition page here
// follows.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import EditionView from '../../../../components/EditionView.astro';
import References from '../../../../components/References.astro';
import { loadCompetition } from '../../../../lib/competition';
import { buildYearStories, distinctWinners, isPlaceholderWinner } from '../../../../lib/editions';
import { buildEditionProfiles, type EditionProfile } from '../../../../lib/editionProfile';
import { buildAllCountryRecords } from '../../../../lib/compare';
import { loadTeamCompetitions } from '../../../../lib/teamCompetitions';
import { teamProfileSlug } from '../../../../lib/teamProfile';
import { playerProfileSlug } from '../../../../lib/playerProfile';
import type { SourceLink } from '../../../../lib/sources';
import { absolutePageUrl, withBase } from '../../../../lib/url';
import { buildEditionSportsEvent } from '../../../../lib/jsonLd';

// Croatian column-label translations, matching hr/competitions/ballon-dor.astro's own headerLabels map.
const HEADER_LABELS: Record<string, string> = {
  Winner: 'Pobjednik',
  'National team': 'Reprezentacija',
  'Ceremony date': 'Datum svečanosti',
};

export async function getStaticPaths() {
  // The Croatian Memorable-moments bullets, matching the hr competition
  // page's own hand-translation (kept in sync with that page's `Nezaboravni
  // trenuci`). Declared inside getStaticPaths since Astro runs it in an
  // isolated scope that can't see the module's other frontmatter consts.
  const CROATIAN_MOMENTS = [
    'Stanley Matthews osvojio je prvu ikad dodijeljenu Zlatnu loptu 1956. godine.',
    'George Weah je 1995. postao prvi afrički dobitnik Zlatne lopte.',
    'Kaká je 2007. osvojio Zlatnu loptu prve godine u kojoj je nagrada postala u potpunosti globalna, otvorena igračima bilo koje nacionalnosti i kluba.',
    'Lionel Messi osvojio je 2009. prvu od svojih osam Zlatnih lopti - više nego ijedan drugi igrač u povijesti nagrade.',
    'Luka Modrić je 2018. postao jedini hrvatski dobitnik Zlatne lopte.',
    'Zlatna lopta za 2020. godinu jedino je izdanje koje nije dodijeljeno otkako je nagrada pokrenuta 1956.',
  ];

  const [data, teamData] = await Promise.all([
    loadCompetition('ballon-dor', { editionsHeading: 'Winners', sourcesHeading: "Ballon d'Or" }),
    loadTeamCompetitions(),
  ]);

  const teamSlugs = new Set(
    buildAllCountryRecords(teamData.competitions).map((record) => teamProfileSlug(record.id)),
  );
  const playerSlugs = new Set(distinctWinners(data.editions).map((name) => playerProfileSlug(name)));
  const stories = buildYearStories(data.editions, CROATIAN_MOMENTS);

  return buildEditionProfiles(data.editions, teamSlugs, { playerSlugs }).map((profile) => ({
    params: { year: profile.slug },
    props: {
      profile,
      story: stories.get(profile.year),
      sources: data.sources,
      lastReviewed: data.lastReviewed,
      status: data.status,
    },
  }));
}

type Props = {
  profile: EditionProfile;
  story?: string;
  sources: SourceLink[];
  lastReviewed: string;
  status: string;
};

const { profile, story, sources, lastReviewed, status } = Astro.props as Props;
const statusText = status === 'verified' ? 'Provjereno' : 'U pregledu';

const nationalTeam = profile.facts.find((fact) => /national team/i.test(fact.label))?.value;
const title = `Zlatna lopta ${profile.year}.`;
const description = isPlaceholderWinner(profile.champion)
  ? `Zlatna lopta ${profile.year}. nije dodijeljena. Puni podaci iz tablice dobitnika te godine.`
  : [
      `Zlatna lopta ${profile.year}.:`,
      `pobjednik ${profile.champion}${nationalTeam && nationalTeam !== '—' ? ` (${nationalTeam})` : ''}.`,
      'Puni podaci iz tablice nagrade, s poveznicom na potpunu povijest nagrada tog igrača.',
    ].join(' ');

const pageUrl = absolutePageUrl(Astro.url, Astro.site);
const jsonLd = [buildEditionSportsEvent(profile, { pageUrl, name: title })];
---

<BaseLayout
  title={title}
  description={description}
  locale="hr"
  alternateHref={withBase(`/competitions/ballon-dor/${profile.slug}`)}
  breadcrumbTrail={[{ name: 'Zlatna lopta', url: withBase('/hr/competitions/ballon-dor') }]}
  jsonLd={jsonLd}
>
  <EditionView
    profile={profile}
    competitionPath="/hr/competitions/ballon-dor"
    competitionTitle="Zlatna lopta"
    story={story}
    locale="hr"
    headerLabels={HEADER_LABELS}
    eyebrow="Generirano iz tablice nagrade"
    headingTemplate="{competition} {year}."
    introTemplate="Sve što tablica nagrade bilježi o izdanju {year}., s poveznicom na pobjednikovu potpunu povijest nagrada i na njegovu reprezentaciju."
    pagerLabel="Ostala izdanja"
    previousLabel="Prethodno izdanje"
    nextLabel="Sljedeće izdanje"
    backLabel="Sva izdanja natjecanja {competition}"
    teamProfileHintTemplate="{team} — potpuna povijest"
    playerProfileHintTemplate="{player} — potpuna povijest nagrada"
    storyHeading="Priča o ovom izdanju"
    glanceHeading="Izdanje {year}. na prvi pogled"
    pdfSlug={`edition-ballon-dor-${profile.slug}-hr`}
    pdfLabel="Preuzmi PDF za ispis"
    pdfHint="A4 položeno, potpuni podaci ovog izdanja nagrade."
  >
    <References
      sources={sources}
      lastReviewed={lastReviewed}
      status={status}
      heading="Izvori i provjera"
      statusPrefix="Status:"
      statusText={statusText}
      lastReviewedPrefix="Zadnja provjera:"
      dateLocale="hr-HR"
      noSourcesText="Za ovu stranicu još nisu navedene poveznice na izvore."
    />
  </EditionView>
</BaseLayout>
