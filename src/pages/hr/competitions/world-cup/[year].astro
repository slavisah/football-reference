---
// Croatian translation of src/pages/competitions/world-cup/[year].astro - one
// page per FIFA World Cup edition. Loads the exact same content as the English
// route so the placings, final result and top scorer can't drift between
// languages; only this page's own chrome (column labels, prose) is Croatian,
// the same convention every other hr competition page here follows.
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import EditionView from '../../../../components/EditionView.astro';
import References from '../../../../components/References.astro';
import { loadCompetition } from '../../../../lib/competition';
import { buildTopScorerFacts, buildYearStories } from '../../../../lib/editions';
import { buildEditionProfiles, type EditionProfile } from '../../../../lib/editionProfile';
import { buildAllCountryRecords } from '../../../../lib/compare';
import { loadTeamCompetitions } from '../../../../lib/teamCompetitions';
import { teamProfileSlug } from '../../../../lib/teamProfile';
import type { SourceLink } from '../../../../lib/sources';
import { withBase } from '../../../../lib/url';

// Croatian column-label translations, the same map the hr world-cup table page uses.
const HEADER_LABELS: Record<string, string> = {
  'Host(s)': 'Domaćin(i)',
  Teams: 'Momčadi',
  Winner: 'Prvak',
  'Runner-up': 'Drugoplasirani',
  Third: 'Treći',
  'Fourth / other semifinalist': 'Četvrti / drugi polufinalist',
  Final: 'Finale',
  'Final date': 'Datum finala',
};

export async function getStaticPaths() {
  // The Croatian Memorable-moments bullets, matching the hr competition page's
  // own hand-translation (kept in sync with that page's `Nezaboravni
  // trenuci`). Declared inside getStaticPaths since Astro runs it in an
  // isolated scope that can't see the module's other frontmatter consts.
  const CROATIAN_MOMENTS = [
    'Urugvaj je pobijedio Brazil u odlučujućoj utakmici 1950. na Maracani, rezultat koji se pamti kao *Maracanazo*.',
    'Brazilska momčad iz 1970. postala je prva koja je osvojila tri Svjetska prvenstva.',
    'Diego Maradona predvodio je Argentinu do naslova 1986.',
    'Hrvatska je 2018. stigla do svog prvog finala.',
    'Argentina i Francuska odigrale su finale 3:3 2022., a Argentina je slavila nakon jedanaesteraca.',
    'Španjolska je 2026. osvojila svoj drugi naslov.',
  ];

  const [data, goldenBoot, teamData] = await Promise.all([
    loadCompetition('fifa-world-cup', { editionsHeading: 'Editions', sourcesHeading: 'FIFA World Cup' }),
    loadCompetition('golden-boot', {
      editionsHeading: 'FIFA World Cup top scorers',
      sourcesHeading: 'FIFA World Cup',
    }),
    loadTeamCompetitions(),
  ]);

  const teamSlugs = new Set(
    buildAllCountryRecords(teamData.competitions).map((record) => teamProfileSlug(record.id)),
  );
  const stories = buildYearStories(data.editions, CROATIAN_MOMENTS);
  const topScorers = buildTopScorerFacts(goldenBoot.editions, 'hr');

  return buildEditionProfiles(data.editions, teamSlugs).map((profile) => ({
    params: { year: profile.slug },
    props: {
      profile,
      story: stories.get(profile.year),
      topScorer: topScorers.get(profile.year),
      sources: data.sources,
      lastReviewed: data.lastReviewed,
      status: data.status,
    },
  }));
}

type Props = {
  profile: EditionProfile;
  story?: string;
  topScorer?: string;
  sources: SourceLink[];
  lastReviewed: string;
  status: string;
};

const { profile, story, topScorer, sources, lastReviewed, status } = Astro.props as Props;
const statusText = status === 'verified' ? 'Provjereno' : 'U pregledu';

const runnerUp = profile.facts.find((fact) => /runner-up/i.test(fact.label))?.value;
const description = [
  `FIFA Svjetsko prvenstvo ${profile.year}.:`,
  profile.champion ? `prvak ${profile.champion}${runnerUp ? `, drugoplasirani ${runnerUp}` : ''}.` : '',
  profile.host ? `Domaćin: ${profile.host}.` : '',
  'Potpuni plasmani, rezultat finala i najbolji strijelac tog izdanja.',
]
  .filter(Boolean)
  .join(' ');
---

<BaseLayout
  title={`FIFA Svjetsko prvenstvo ${profile.year}.`}
  description={description}
  locale="hr"
  alternateHref={withBase(`/competitions/world-cup/${profile.slug}`)}
  breadcrumbTrail={[{ name: 'FIFA Svjetsko prvenstvo', url: withBase('/hr/competitions/world-cup') }]}
>
  <EditionView
    profile={profile}
    competitionPath="/hr/competitions/world-cup"
    competitionTitle="FIFA Svjetsko prvenstvo"
    story={story}
    topScorer={topScorer}
    topScorerLabel="Najbolji strijelac"
    locale="hr"
    headerLabels={HEADER_LABELS}
    eyebrow="Generirano iz tablice natjecanja"
    headingTemplate="{competition} {year}."
    introTemplate="Sve što tablica izdanja bilježi o izdanju {year}., uz poveznicu na potpunu povijest svake reprezentacije."
    pagerLabel="Ostala izdanja"
    previousLabel="Prethodno izdanje"
    nextLabel="Sljedeće izdanje"
    backLabel="Sva izdanja natjecanja {competition}"
    teamProfileHintTemplate="{team} — potpuna povijest"
    storyHeading="Priča o ovom izdanju"
    glanceHeading="Izdanje {year}. na prvi pogled"
  >
    <References
      sources={sources}
      lastReviewed={lastReviewed}
      status={status}
      heading="Izvori i provjera"
      statusPrefix="Status:"
      statusText={statusText}
      lastReviewedPrefix="Zadnja provjera:"
      dateLocale="hr-HR"
      noSourcesText="Za ovu stranicu još nisu navedene poveznice na izvore."
    />
  </EditionView>
</BaseLayout>
