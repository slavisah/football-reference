---
// Croatian translation of src/pages/competitions/copa-america.astro. First of
// the six competition/award pages localized - see docs/PROJECT_STATUS.md for
// why this one was picked first and what's left for the other five. Loads the
// exact same `loadCompetition('copa-america', ...)` call as the English page,
// so the table data, generated champions summary and reference links can
// never drift between languages - only this page's own chrome (filters, sort
// labels, status text, column headers) and a hand-translated intro/notes
// paragraph are Croatian. This page composes its own layout by hand (like
// hr/records.astro and hr/compare.astro) rather than through the shared
// English-only CompetitionView, so the five untouched English competition
// pages needed no changes beyond the new optional locale props on
// TournamentTable/PrintDownloadLink (defaulted to the original English text).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TournamentTable from '../../../components/TournamentTable.astro';
import PodiumCards from '../../../components/PodiumCards.astro';
import ChampionsSummary from '../../../components/ChampionsSummary.astro';
import HostMap from '../../../components/HostMap.astro';
import EditorialNotes from '../../../components/EditorialNotes.astro';
import References from '../../../components/References.astro';
import PrintDownloadLink from '../../../components/PrintDownloadLink.astro';
import { loadCompetition } from '../../../lib/competition';
import { buildPodiums, buildYearStories, buildHostMapPoints } from '../../../lib/editions';
import { buildEditionLinks, buildEditionProfiles } from '../../../lib/editionProfile';
import { COPA_AMERICA_HOST_COORDINATES, COPA_AMERICA_REGION_ORDER } from '../../../lib/hostCoordinates';
import { absolutePageUrl, withBase } from '../../../lib/url';
import {
  buildChampionsItemList,
  buildCollectionPageJsonLd,
  buildLatestEditionSportsEvent,
  type JsonLdObject,
} from '../../../lib/jsonLd';
import type { NoteSection } from '../../../lib/notes';

const data = await loadCompetition('copa-america', {
  editionsHeading: 'Champions timeline',
  sourcesHeading: 'Copa América',
  allowDuplicateYears: ['1959'],
});

const podium = buildPodiums(data.editions);
const hostMap = buildHostMapPoints(data.editions, COPA_AMERICA_HOST_COORDINATES, COPA_AMERICA_REGION_ORDER);
const yearLinks = buildEditionLinks(buildEditionProfiles(data.editions), '/hr/competitions/copa-america');
const hostRegionLabels: Record<string, string> = {
  'South America': 'Južna Amerika',
  'North America': 'Sjeverna Amerika',
};

const statusText = data.status === 'verified' ? 'Provjereno' : 'U pregledu';

const pageUrl = absolutePageUrl(Astro.url, Astro.site);
const championsName = `${data.title} - prvaci po broju naslova`;
const jsonLd = [
  buildCollectionPageJsonLd(buildChampionsItemList(data.champions, { pageUrl, name: championsName }), {
    pageUrl,
    name: championsName,
  }),
  buildLatestEditionSportsEvent(data.editions, data.title),
].filter((item): item is JsonLdObject => item !== undefined);

// Hand-translated from content/copa-america.md's "How it works" and
// "Memorable moments" sections.
// content/ itself stays untouched and English (the single editorial source of
// truth); this is presentation-layer text local to this page only, the same
// way hr/records.astro hand-writes its own Croatian prose rather than
// generating it from an English source at build time.
