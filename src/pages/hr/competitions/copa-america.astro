// "Dodirni godinu za priču": joins the Croatian Memorable-moments bullets
// above onto the matching edition row by year, same as the English page's
// CompetitionView does with the English bullets - see buildYearStories() in
// src/lib/editions.ts.
const stories = buildYearStories(
  data.editions,
  notes.find((section) => section.heading === 'Nezaboravni trenuci')?.items ?? [],
);

const headerLabels: Record<string, string> = {
  Year: 'Godina',
  'Host / format': 'Domaćin / format',
  Champion: 'Prvak',
  'Runner-up': 'Drugoplasirani',
  Third: 'Treći',
  Fourth: 'Četvrti',
  Format: 'Format',
  'Final date': 'Datum finala',
};
---

<BaseLayout
  title={data.title}
  description="Svaki prvak Copa Américe od 1916., domaćini i drugoplasirani, uz generirani broj naslova. Filtriraj po prvaku, godini, domaćinu i reprezentaciji."
  locale="hr"
  alternateHref={withBase('/competitions/copa-america')}
  jsonLd={jsonLd}
>
  <article class="competition stack">
    <header class="competition__header">
      <p class="eyebrow badge">{statusText}</p>
      <h1>{data.title}</h1>
      <p class="competition__intro">
        Copa América je pokrenuta 1916. godine i najstarije je kontinentalno
        natjecanje muških nacionalnih reprezentacija koje se i danas igra. Do
        1975. bila je poznata kao Južnoameričko prvenstvo.
      </p>
      <PrintDownloadLink
        slug="copa-america-hr"
        label="Preuzmi PDF za ispis"
        hint="A4 položeno, ista tablica i zbrojevi kao na ovoj stranici."
      />
    </header>

    <TournamentTable
      id="copa-america"
      caption="Prvaci Copa Américe, od 1916. do danas"
      table={data.table}
      editions={data.editions}
      winners={data.winners}
      hosts={data.hosts}
      teams={data.teams}
      locale="hr"
      headerLabels={headerLabels}
      winnerLabel="Prvak"
      winnerAllLabel="Svi prvaci"
      yearLabel="Godina"
      yearAllLabel="Sve godine"
      hostLabel="Domaćin"
      hostAllLabel="Svi domaćini"
      teamLabel="Reprezentacija"
      teamAllLabel="Sve reprezentacije"
      sortByLabel="Sortiraj po"
      resetLabel="Poništi"
      filterAriaLabel="Filtriraj prvake Copa Américe"
      showingAllTemplate="Prikazano svih {n} izdanja."
      showingFilteredTemplate="Prikazano {shown} od {total} izdanja ({bits})."
      bitWinnerPrefix="prvak"
      bitYearPrefix="godina"
      bitHostPrefix="domaćin"
      bitTeamPrefix="reprezentacija"
      emptyText="Nijedno izdanje ne odgovara odabranim filterima."
      clearFiltersLabel="Očisti filtere"
      storyColumn={stories.size > 0 ? { label: 'Priča', values: stories } : undefined}
      storySummaryLabel="📖 Dodirni za priču"
      yearLinks={yearLinks}
    />

    <PodiumCards
      entries={podium}
      id="copa-america-podium"
      heading="Pobjednici po izdanju"
      hostedByLabel="Domaćin:"
      championLabel="Prvak"
      runnerUpLabel="Drugoplasirani"
      thirdLabel="Treći"
      fourthLabel="Četvrti"
    />

    <ChampionsSummary
      champions={data.champions}
      scaleMax={data.editions.length}
      heading="Prvaci po broju naslova"
      description="Automatski generirano iz gornje tablice izdanja. Zbrojevi grupiraju naciju s njezinim sportskim nasljednikom samo tamo gdje to čini izvorni sadržaj (Njemačka uključuje Zapadnu Njemačku); svaki drugi naziv broji se onako kako je zapisan."
      unit={['naslov', 'naslova']}
      winningYearsLabel="Godine osvajanja: "
      ofLabel="od"
    />

    <HostMap
      points={hostMap}
      id="copa-america-host-map"
      heading="Gdje je Copa América igrala domaćinu"
      description="Približan položaj svakog domaćina na jednostavnoj mreži zemljopisne dužine i širine, grupiran po regijama u popisu ispod - ne tvrdimo točne granice, samo otprilike gdje se u svijetu igralo pojedino izdanje. Veće točke znače da je zemlja bila domaćin više puta."
      unit={['put', 'puta']}
      hostingYearsLabel="Godine domaćinstva: "
      regionLabels={hostRegionLabels}
    />

    <EditorialNotes sections={notes} />

    <References
      sources={data.sources}
      lastReviewed={data.lastReviewed}
      status={data.status}
      heading="Izvori i provjera"
      statusPrefix="Status:"
      statusText={statusText}
      lastReviewedPrefix="Zadnja provjera:"
      dateLocale="hr-HR"
      noSourcesText="Za ovu stranicu još nisu navedene poveznice na izvore."
      noteText="Prednost imaju primarni izvori. Povijesni formati i nazivi reprezentacija bilježe se onako kako su korišteni u to vrijeme; kontekst potražite u napomenama uz svako izdanje."
    />
  </article>
</BaseLayout>

<style>
  .competition__header {
    margin-bottom: 0.5rem;
  }

  .eyebrow {
    margin-bottom: 0.6rem;
  }

  .competition__header h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }

  .competition__intro {
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 1.05rem;
  }
</style>
