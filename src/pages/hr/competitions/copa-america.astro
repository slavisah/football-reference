---
// Croatian translation of src/pages/competitions/copa-america.astro. First of
// the six competition/award pages localized - see docs/PROJECT_STATUS.md for
// why this one was picked first and what's left for the other five. Loads the
// exact same `loadCompetition('copa-america', ...)` call as the English page,
// so the table data, generated champions summary and reference links can
// never drift between languages - only this page's own chrome (filters, sort
// labels, status text, column headers) and a hand-translated intro/notes
// paragraph are Croatian. This page composes its own layout by hand (like
// hr/records.astro and hr/compare.astro) rather than through the shared
// English-only CompetitionView, so the five untouched English competition
// pages needed no changes beyond the new optional locale props on
// TournamentTable/PrintDownloadLink (defaulted to the original English text).
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TournamentTable from '../../../components/TournamentTable.astro';
import PodiumCards from '../../../components/PodiumCards.astro';
import ChampionsSummary from '../../../components/ChampionsSummary.astro';
import HostMap from '../../../components/HostMap.astro';
import EditorialNotes from '../../../components/EditorialNotes.astro';
import References from '../../../components/References.astro';
import PrintDownloadLink from '../../../components/PrintDownloadLink.astro';
import { loadCompetition } from '../../../lib/competition';
import { buildPodiums, buildYearStories, buildHostMapPoints } from '../../../lib/editions';
import { buildEditionLinks, buildEditionProfiles } from '../../../lib/editionProfile';
import { COPA_AMERICA_HOST_COORDINATES, COPA_AMERICA_REGION_ORDER } from '../../../lib/hostCoordinates';
import { absolutePageUrl, withBase } from '../../../lib/url';
import {
  buildChampionsItemList,
  buildLatestEditionSportsEvent,
  type JsonLdObject,
} from '../../../lib/jsonLd';
import type { NoteSection } from '../../../lib/notes';

const data = await loadCompetition('copa-america', {
  editionsHeading: 'Champions timeline',
  sourcesHeading: 'Copa América',
  allowDuplicateYears: ['1959'],
});

const podium = buildPodiums(data.editions);
const hostMap = buildHostMapPoints(data.editions, COPA_AMERICA_HOST_COORDINATES, COPA_AMERICA_REGION_ORDER);
const yearLinks = buildEditionLinks(buildEditionProfiles(data.editions), '/hr/competitions/copa-america');
const hostRegionLabels: Record<string, string> = {
  'South America': 'Južna Amerika',
  'North America': 'Sjeverna Amerika',
};

const statusText = data.status === 'verified' ? 'Provjereno' : 'U pregledu';

const pageUrl = absolutePageUrl(Astro.url, Astro.site);
const jsonLd = [
  buildChampionsItemList(data.champions, {
    pageUrl,
    name: `${data.title} - prvaci po broju naslova`,
  }),
  buildLatestEditionSportsEvent(data.editions, data.title),
].filter((item): item is JsonLdObject => item !== undefined);

// Hand-translated from content/copa-america.md's "How it works" and
// "Memorable moments" sections.
// content/ itself stays untouched and English (the single editorial source of
// truth); this is presentation-layer text local to this page only, the same
// way hr/records.astro hand-writes its own Croatian prose rather than
// generating it from an English source at build time.
const notes: NoteSection[] = [
  {
    heading: 'Kako funkcionira',
    items: [
      'Deset južnoameričkih reprezentacija članica CONMEBOL-a natječe se jedna protiv druge, a od 1993. povremeno im se pridružuju i pozvane gostujuće momčadi izvan regije.',
      'Format natjecanja mijenjao se više nego kod ijednog drugog natjecanja na ovoj stranici: neka rana izdanja prvaka su određivala konačnim poretkom lige, druga dvomečem kod kuće i u gostima, a većina izdanja od 1990-ih skupnom fazom nakon koje slijedi nokaut sustav.',
      'Copa América, za razliku od Svjetskog prvenstva ili EURA, nije uvijek imala fiksni četverogodišnji ciklus.',
    ],
  },
  {
    heading: 'Nezaboravni trenuci',
    items: [
      'Argentina, Brazil, Čile i Urugvaj sudjelovali su na prvom izdanju 1916. godine.',
      'Bolivija je osvojila svoju jedinu titulu kao domaćin 1963. godine.',
      'Kolumbija je osvojila svoju prvu titulu 2001. godine.',
      'Čile je osvojio svoje prve dvije titule u uzastopnim izdanjima, 2015. i 2016.',
      'Argentina je 2024. preuzela vodstvo kao najuspješnija reprezentacija natjecanja.',
    ],
  },
];

// "Dodirni godinu za priču": joins the Croatian Memorable-moments bullets
// above onto the matching edition row by year, same as the English page's
// CompetitionView does with the English bullets - see buildYearStories() in
// src/lib/editions.ts.
const stories = buildYearStories(
  data.editions,
  notes.find((section) => section.heading === 'Nezaboravni trenuci')?.items ?? [],
);

const headerLabels: Record<string, string> = {
  Year: 'Godina',
  'Host / format': 'Domaćin / format',
  Champion: 'Prvak',
  'Runner-up': 'Drugoplasirani',
  Third: 'Treći',
  Fourth: 'Četvrti',
  Format: 'Format',
  'Final date': 'Datum finala',
};
---

<BaseLayout
  title={data.title}
  description="Svaki prvak Copa Américe od 1916., domaćini i drugoplasirani, uz generirani broj naslova. Filtriraj po prvaku, godini, domaćinu i reprezentaciji."
  locale="hr"
  alternateHref={withBase('/competitions/copa-america')}
  jsonLd={jsonLd}
>
  <article class="competition stack">
    <header class="competition__header">
      <p class="eyebrow badge">{statusText}</p>
      <h1>{data.title}</h1>
      <p class="competition__intro">
        Copa América je pokrenuta 1916. godine i najstarije je kontinentalno
        natjecanje muških nacionalnih reprezentacija koje se i danas igra. Do
        1975. bila je poznata kao Južnoameričko prvenstvo.
      </p>
      <PrintDownloadLink
        slug="copa-america-hr"
        label="Preuzmi PDF za ispis"
        hint="A4 položeno, ista tablica i zbrojevi kao na ovoj stranici."
      />
    </header>

    <TournamentTable
      id="copa-america"
      caption="Prvaci Copa Américe, od 1916. do danas"
      table={data.table}
      editions={data.editions}
      winners={data.winners}
      hosts={data.hosts}
      teams={data.teams}
      locale="hr"
      headerLabels={headerLabels}
      winnerLabel="Prvak"
      winnerAllLabel="Svi prvaci"
      yearLabel="Godina"
      yearAllLabel="Sve godine"
      hostLabel="Domaćin"
      hostAllLabel="Svi domaćini"
      teamLabel="Reprezentacija"
      teamAllLabel="Sve reprezentacije"
      sortByLabel="Sortiraj po"
      resetLabel="Poništi"
      filterAriaLabel="Filtriraj prvake Copa Américe"
      showingAllTemplate="Prikazano svih {n} izdanja."
      showingFilteredTemplate="Prikazano {shown} od {total} izdanja ({bits})."
      bitWinnerPrefix="prvak"
      bitYearPrefix="godina"
      bitHostPrefix="domaćin"
      bitTeamPrefix="reprezentacija"
      emptyText="Nijedno izdanje ne odgovara odabranim filterima."
      clearFiltersLabel="Očisti filtere"
      storyColumn={stories.size > 0 ? { label: 'Priča', values: stories } : undefined}
      storySummaryLabel="📖 Dodirni za priču"
      yearLinks={yearLinks}
    />

    <PodiumCards
      entries={podium}
      id="copa-america-podium"
      heading="Pobjednici po izdanju"
      hostedByLabel="Domaćin:"
      championLabel="Prvak"
      runnerUpLabel="Drugoplasirani"
      thirdLabel="Treći"
      fourthLabel="Četvrti"
    />

    <ChampionsSummary
      champions={data.champions}
      scaleMax={data.editions.length}
      heading="Prvaci po broju naslova"
      description="Automatski generirano iz gornje tablice izdanja. Zbrojevi grupiraju naciju s njezinim sportskim nasljednikom samo tamo gdje to čini izvorni sadržaj (Njemačka uključuje Zapadnu Njemačku); svaki drugi naziv broji se onako kako je zapisan."
      unit={['naslov', 'naslova']}
      winningYearsLabel="Godine osvajanja: "
      ofLabel="od"
    />

    <HostMap
      points={hostMap}
      id="copa-america-host-map"
      heading="Gdje je Copa América igrala domaćinu"
      description="Približan položaj svakog domaćina na jednostavnoj mreži zemljopisne dužine i širine, grupiran po regijama u popisu ispod - ne tvrdimo točne granice, samo otprilike gdje se u svijetu igralo pojedino izdanje. Veće točke znače da je zemlja bila domaćin više puta."
      unit={['put', 'puta']}
      hostingYearsLabel="Godine domaćinstva: "
      regionLabels={hostRegionLabels}
    />

    <EditorialNotes sections={notes} />

    <References
      sources={data.sources}
      lastReviewed={data.lastReviewed}
      status={data.status}
      heading="Izvori i provjera"
      statusPrefix="Status:"
      statusText={statusText}
      lastReviewedPrefix="Zadnja provjera:"
      dateLocale="hr-HR"
      noSourcesText="Za ovu stranicu još nisu navedene poveznice na izvore."
      noteText="Prednost imaju primarni izvori. Povijesni formati i nazivi reprezentacija bilježe se onako kako su korišteni u to vrijeme; kontekst potražite u napomenama uz svako izdanje."
    />
  </article>
</BaseLayout>

<style>
  .competition__header {
    margin-bottom: 0.5rem;
  }

  .eyebrow {
    margin-bottom: 0.6rem;
  }

  .competition__header h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }

  .competition__intro {
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 1.05rem;
  }
</style>
