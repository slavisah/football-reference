---
// Croatian translation of ../../../../competitions/golden-boot/euro/
// [year].astro - one page per UEFA EURO Golden Boot edition. See that file's
// sibling, world-cup/[year].astro (this file's own English/Croatian
// counterpart), for the full context on Golden Boot's two-route-tree,
// tied-scorer-splitting edition-page rollout.
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import EditionView from '../../../../../components/EditionView.astro';
import References from '../../../../../components/References.astro';
import { loadCompetition } from '../../../../../lib/competition';
import { buildYearStories, isPlaceholderWinner } from '../../../../../lib/editions';
import { buildEditionProfiles, type EditionProfile } from '../../../../../lib/editionProfile';
import { buildAllCountryRecords } from '../../../../../lib/compare';
import { loadTeamCompetitions } from '../../../../../lib/teamCompetitions';
import { teamProfileSlug } from '../../../../../lib/teamProfile';
import {
  buildAllPlayerProfiles,
  playerProfileSlug,
  type PlayerAwardSource,
} from '../../../../../lib/playerProfile';
import type { SourceLink } from '../../../../../lib/sources';
import { absolutePageUrl, withBase } from '../../../../../lib/url';
import { buildEditionSportsEvent } from '../../../../../lib/jsonLd';

const HEADER_LABELS: Record<string, string> = {
  'Player(s)': 'Igrač(i)',
  Team: 'Reprezentacija',
  Goals: 'Golovi',
};

export async function getStaticPaths() {
  // The Croatian Memorable-moments bullets, matching the hr golden-boot
  // page's own hand-translation (kept in sync with that page's
  // `Nezaboravni trenuci - EURO`). Declared inside getStaticPaths since
  // Astro runs it in an isolated scope that can't see the module's other
  // frontmatter consts.
  const CROATIAN_MOMENTS = [
    'Prva ikad dodijeljena Zlatna kopačka EURA, 1960., podijeljena je između pet igrača s po dva gola.',
    'Devet golova Michela Platinija u pet utakmica za Francusku 1984. i danas je rekordan broj golova jednog igrača na jednom EURU.',
    'Cristiano Ronaldo osvojio je Zlatnu kopačku EURA 2020. s pet golova, na turniru odgođenom za 2021.',
    'Šest igrača podijelilo je Zlatnu kopačku EURA 2024. s po tri gola - najnovije izdanje ovog natjecanja.',
  ];

  const [ballonDor, worldCupGoldenBoot, euroGoldenBoot, teamData] = await Promise.all([
    loadCompetition('ballon-dor', { editionsHeading: 'Winners', sourcesHeading: "Ballon d'Or" }),
    loadCompetition('golden-boot', {
      editionsHeading: 'FIFA World Cup top scorers',
      sourcesHeading: 'FIFA World Cup',
    }),
    loadCompetition('golden-boot', {
      editionsHeading: 'UEFA EURO top scorers',
      sourcesHeading: 'UEFA EURO',
    }),
    loadTeamCompetitions(),
  ]);

  const teamSlugs = new Set(
    buildAllCountryRecords(teamData.competitions).map((record) => teamProfileSlug(record.id)),
  );
  const playerSources: PlayerAwardSource[] = [
    { title: "Ballon d'Or", slug: 'ballon-dor', editions: ballonDor.editions },
    { title: 'FIFA World Cup Golden Boot', slug: 'golden-boot', editions: worldCupGoldenBoot.editions },
    { title: 'UEFA EURO Golden Boot', slug: 'golden-boot', editions: euroGoldenBoot.editions },
  ];
  const playerSlugs = new Set(
    buildAllPlayerProfiles(playerSources).map((profile) => playerProfileSlug(profile.id)),
  );

  const data = euroGoldenBoot;
  const stories = buildYearStories(data.editions, CROATIAN_MOMENTS);

  return buildEditionProfiles(data.editions, teamSlugs, { playerSlugs }).map((profile) => ({
    params: { year: profile.slug },
    props: {
      profile,
      story: stories.get(profile.year),
      sources: data.sources,
      lastReviewed: data.lastReviewed,
      status: data.status,
    },
  }));
}

type Props = {
  profile: EditionProfile;
  story?: string;
  sources: SourceLink[];
  lastReviewed: string;
  status: string;
};

const { profile, story, sources, lastReviewed, status } = Astro.props as Props;
const statusText = status === 'verified' ? 'Provjereno' : 'U pregledu';

const title = `Zlatna kopačka EURA ${profile.year}.`;
const description = isPlaceholderWinner(profile.champion)
  ? `Zlatna kopačka EURA ${profile.year}. nije dodijeljena. Puni podaci iz tablice najboljih strijelaca te godine.`
  : [
      `Zlatna kopačka EURA ${profile.year}.:`,
      `pobjednik ${profile.champion}.`,
      'Puni podaci iz tablice najboljih strijelaca, s poveznicom na potpunu povijest nagrada svakog igrača.',
    ].join(' ');

const pageUrl = absolutePageUrl(Astro.url, Astro.site);
const jsonLd = [buildEditionSportsEvent(profile, { pageUrl, name: title })];
---

<BaseLayout
  title={title}
  description={description}
  locale="hr"
  alternateHref={withBase(`/competitions/golden-boot/euro/${profile.slug}`)}
  breadcrumbTrail={[{ name: 'Zlatna kopačka', url: withBase('/hr/competitions/golden-boot') }]}
  jsonLd={jsonLd}
>
  <EditionView
    profile={profile}
    competitionPath="/hr/competitions/golden-boot/euro"
    backPath="/hr/competitions/golden-boot"
    competitionTitle="Zlatna kopačka EURA"
    story={story}
    locale="hr"
    headerLabels={HEADER_LABELS}
    eyebrow="Generirano iz tablice nagrade"
    headingTemplate="{competition} {year}."
    introTemplate="Sve što tablica najboljih strijelaca bilježi o izdanju {year}., sa svakim strijelcem povezanim na njegovu potpunu povijest nagrada i reprezentaciju odvojeno. Izjednačeni strijelci prikazani su zajedno, točno onako kako ih navodi izvorna tablica."
    pagerLabel="Ostala izdanja"
    previousLabel="Prethodno izdanje"
    nextLabel="Sljedeće izdanje"
    backLabel="Sva izdanja natjecanja {competition}"
    teamProfileHintTemplate="{team} — potpuna povijest"
    playerProfileHintTemplate="{player} — potpuna povijest nagrada"
    storyHeading="Priča o ovom izdanju"
    glanceHeading="Izdanje {year}. na prvi pogled"
    pdfSlug={`edition-golden-boot-euro-${profile.slug}-hr`}
    pdfLabel="Preuzmi PDF za ispis"
    pdfHint="A4 položeno, potpuni podaci ovog izdanja nagrade."
  >
    <References
      sources={sources}
      lastReviewed={lastReviewed}
      status={status}
      heading="Izvori i provjera"
      statusPrefix="Status:"
      statusText={statusText}
      lastReviewedPrefix="Zadnja provjera:"
      dateLocale="hr-HR"
      noSourcesText="Za ovu stranicu još nisu navedene poveznice na izvore."
    />
  </EditionView>
</BaseLayout>
