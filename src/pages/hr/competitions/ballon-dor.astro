---
// Croatian translation of src/pages/competitions/ballon-dor.astro. Third of
// the six competition/award pages localized (Copa América and Nations League
// came first) - see docs/PROJECT_STATUS.md for the rollout plan and what's
// left. Loads the exact same `loadCompetition('ballon-dor', ...)` call as the
// English page, so the table data, generated champions summary and reference
// links can never drift between languages - only this page's own chrome
// (filters, sort labels, status text, column headers) and a hand-translated
// intro/notes paragraph are Croatian. Composes its own layout by hand (like
// hr/competitions/copa-america.astro and hr/competitions/nations-league.astro)
// rather than through the shared English-only CompetitionView, so the English
// page needed no changes beyond the locale props already added for the Copa
// América slice. Unlike the two team competitions done so far, this table has
// no host column (an individual award, not hosted) - `hosts` stays the
// TournamentTable default `[]`, which already omits the host filter/label for
// free, so no new prop plumbing was needed here.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import TournamentTable from '../../../components/TournamentTable.astro';
import ChampionsSummary from '../../../components/ChampionsSummary.astro';
import EditorialNotes from '../../../components/EditorialNotes.astro';
import References from '../../../components/References.astro';
import PrintDownloadLink from '../../../components/PrintDownloadLink.astro';
import { loadCompetition } from '../../../lib/competition';
import { buildYearStories } from '../../../lib/editions';
import { buildEditionLinks, buildEditionProfiles } from '../../../lib/editionProfile';
import { absolutePageUrl, withBase } from '../../../lib/url';
import {
  buildChampionsItemList,
  buildCollectionPageJsonLd,
  buildLatestEditionSportsEvent,
  type JsonLdObject,
} from '../../../lib/jsonLd';
import type { NoteSection } from '../../../lib/notes';

const data = await loadCompetition('ballon-dor', {
  editionsHeading: 'Winners',
  sourcesHeading: "Ballon d'Or",
});

const yearLinks = buildEditionLinks(buildEditionProfiles(data.editions), '/hr/competitions/ballon-dor');

const statusText = data.status === 'verified' ? 'Provjereno' : 'U pregledu';

// Croatian display name for the award, matching the name already established
// on the Croatian home page (homeCards.ts's CARD_TEXT) - data.title itself
// stays the raw English front-matter value ("Men's Ballon d'Or").
const title = 'Zlatna lopta';

const pageUrl = absolutePageUrl(Astro.url, Astro.site);
const championsName = `${title} - najviše nagrada`;
const jsonLd = [
  buildCollectionPageJsonLd(buildChampionsItemList(data.champions, { pageUrl, name: championsName }), {
    pageUrl,
    name: championsName,
  }),
  buildLatestEditionSportsEvent(data.editions, title),
].filter((item): item is JsonLdObject => item !== undefined);

// Hand-translated from content/ballon-dor.md's "How it works", "Memorable
// moments" and "Notes" sections. content/ itself stays untouched and English
// (the single editorial source of truth); this is presentation-layer text
// local to this page only, the same way hr/competitions/copa-america.astro
// and hr/competitions/nations-league.astro hand-write their own Croatian
// prose.
const CROATIAN_MOMENTS = [
  'Stanley Matthews osvojio je prvu ikad dodijeljenu Zlatnu loptu 1956. godine.',
  'George Weah je 1995. postao prvi afrički dobitnik Zlatne lopte.',
  'Kaká je 2007. osvojio Zlatnu loptu prve godine u kojoj je nagrada postala u potpunosti globalna, otvorena igračima bilo koje nacionalnosti i kluba.',
  'Lionel Messi osvojio je 2009. prvu od svojih osam Zlatnih lopti - više nego ijedan drugi igrač u povijesti nagrade.',
  'Luka Modrić je 2018. postao jedini hrvatski dobitnik Zlatne lopte.',
  'Zlatna lopta za 2020. godinu jedino je izdanje koje nije dodijeljeno otkako je nagrada pokrenuta 1956.',
];

const notes: NoteSection[] = [
  {
    heading: 'Kako funkcionira',
    items: [
      'Zlatna lopta nagrađuje najboljeg pojedinačnog muškog igrača godine - nije riječ o momčadskom natjecanju ni nagradi za reprezentaciju.',
      'Skupina novinara, po jedan iz svake zemlje s pravom glasa, rangira svoje najbolje igrače; glasovi se zbrajaju u konačni poredak.',
      'Uvjeti prihvatljivosti proširivali su se tijekom vremena: isprva samo Europljani, zatim od 1995. igrači bilo koje nacionalnosti u europskim klubovima, a od 2007. nagrada je potpuno globalna (pogledajte uvod iznad).',
      'Pobjednik se objavljuje na svečanosti krajem godine koju organizira magazin France Football.',
    ],
  },
  {
    heading: 'Dobitnici nagrade Kopa Trophy',
    items: [
      'France Football dodjeljuje nagradu Kopa Trophy, popratnu nagradu za "najboljeg mladog igrača" svijeta u dobi od 21 godine ili mlađe, uz Zlatnu loptu svake godine od 2018., osim 2020. - jedine godine u kojoj ni sama Zlatna lopta nije dodijeljena.',
      '2018.: Kylian Mbappé (Francuska) - prvi dobitnik nagrade.',
      '2019.: Matthijs de Ligt (Nizozemska).',
      '2020.: Nije dodijeljena.',
      '2021.: Pedri (Španjolska).',
      '2022.: Gavi (Španjolska).',
      '2023.: Jude Bellingham (Engleska).',
      '2024.: Lamine Yamal (Španjolska).',
      '2025.: Lamine Yamal (Španjolska) - prvi igrač koji je nagradu Kopa Trophy osvojio dva puta.',
    ],
  },
  {
    heading: 'Dobitnici nagrade Yashin Trophy',
    items: [
      'France Football dodjeljuje i nagradu Yashin Trophy, popratnu nagradu za "najboljeg vratara" nazvanu po Lavu Jašinu, uz Zlatnu loptu svake godine od 2019., osim 2020. - jedine godine u kojoj ni sama Zlatna lopta nije dodijeljena.',
      '2019.: Alisson (Brazil) - prvi dobitnik nagrade.',
      '2020.: Nije dodijeljena.',
      '2021.: Gianluigi Donnarumma (Italija).',
      '2022.: Thibaut Courtois (Belgija).',
      '2023.: Emiliano Martínez (Argentina).',
      '2024.: Emiliano Martínez (Argentina) - prvi vratar koji je nagradu Yashin Trophy osvojio dvije uzastopne godine.',
      '2025.: Gianluigi Donnarumma (Italija) - njegova druga nagrada Yashin Trophy, čime postaje drugi vratar (nakon Martíneza) koji ju je osvojio više puta.',
    ],
  },
  {
    heading: 'Dobitnici nagrade Gerd Müller Trophy',
    items: [
      'France Football dodjeljuje i nagradu za najboljeg strijelca godine (klub i reprezentacija zajedno) uz Zlatnu loptu svake godine od 2021. - isprva pod nazivom "Striker of the Year", a od 2022. preimenovanu u Gerd Müller Trophy u čast njemačkog i bayernovog napadača (dobitnika Zlatne lopte 1970., vidi tablicu dobitnika iznad) nakon njegove smrti u kolovozu 2021. - za razliku od nagrada Kopa Trophy i Yashin Trophy iznad, nema godinu u kojoj nije dodijeljena, jer je pokrenuta godinu nakon otkazivanja 2020., a ne prije njega.',
      '2021.: Robert Lewandowski (Poljska) - prvi dobitnik nagrade, pod izvornim nazivom.',
      '2022.: Robert Lewandowski (Poljska) - prvi dobitnik pod preimenovanim nazivom Gerd Müller Trophy, i prvi igrač koji je nagradu osvojio dva puta.',
      '2023.: Erling Haaland (Norveška).',
      '2024.: Harry Kane (Engleska) i Kylian Mbappé (Francuska) - prvo dijeljenje nagrade, obojica proglašena zajedničkim pobjednicima s istim brojem golova.',
      '2025.: Viktor Gyökeres (Švedska).',
    ],
  },
  {
    heading: 'Dobitnici nagrade Johan Cruyff Trophy',
    items: [
      'France Football dodjeljuje i nagradu Johan Cruyff Trophy, popratnu nagradu za "najboljeg muškog izbornika/trenera" nazvanu po nizozemskom velikanu (trostrukom dobitniku Zlatne lopte, vidi tablicu dobitnika iznad), uz Zlatnu loptu svake godine od 2024. - najnoviju od tri popratne nagrade na ovoj stranici, bez godine u kojoj nije dodijeljena jer je pokrenuta nakon što su nagrade Kopa Trophy, Yashin Trophy i Gerd Müller Trophy već uspostavile taj obrazac.',
      '2024.: Carlo Ancelotti (Real Madrid) - prvi dobitnik nagrade, nagrađen za osvojeni naslov La Lige i Lige prvaka s Real Madridom.',
      '2025.: Luis Enrique (Paris Saint-Germain) - nagrađen za osvojenu Ligue 1, Kup Francuske i prvi naslov u Ligi prvaka u povijesti PSG-a.',
    ],
  },
  {
    heading: 'Dobitnici nagrade Sócrates',
    items: [
      'France Football dodjeljuje i nagradu Sócrates, popratnu humanitarnu nagradu nazvanu po brazilskom velikanu Sócratesu i dodijeljenu u suradnji s organizacijom Peace and Sport, uz Zlatnu loptu svake godine od 2022. - za razliku od nagrada Kopa Trophy, Yashin Trophy, Gerd Müller Trophy i Johan Cruyff Trophy iznad, nije ograničena na muški nogometni učinak: dobila ju je i nogometašica, a 2025. dobrotvorna zaklada, a ne pojedinačni igrač.',
      '2022.: Sadio Mané (Senegal) - prvi dobitnik nagrade, nagrađen za financiranje bolnice, srednje škole i druge infrastrukture u svom rodnom selu Bambali.',
      '2023.: Vinícius Júnior (Brazil) - nagrađen za rad Instituta Vini Jr. protiv rasizma i obrazovne nejednakosti u Brazilu.',
      '2024.: Jennifer Hermoso (Španjolska) - prva dobitnica nagrade, nagrađena za zalaganje protiv seksualnog zlostavljanja i uznemiravanja u sportu.',
      '2025.: Xana Foundation - zaklada koju su osnovali dobitnik nagrade Johan Cruyff Trophy Luis Enrique (vidi iznad) i njegova supruga Elena Cullell u spomen na kćer Xanu, preminulu 2019. godine; prvi dobitnik nagrade koji nije pojedinačni nogometaš.',
    ],
  },
  {
    heading: 'Nezaboravni trenuci',
    items: CROATIAN_MOMENTS,
  },
  {
    heading: 'Napomene',
    items: [
      'Lev Jašin ostaje jedini vratar koji je osvojio ovu mušku nagradu.',
      'George Weah je 1995. postao prvi afrički dobitnik nagrade.',
      'Luka Modrić je nagradu osvojio 2018. godine.',
      'Nagrada za 2020. godinu nije dodijeljena.',
      'Ousmane Dembélé osvojio je nagradu za 2025. godinu.',
    ],
  },
];

// "Dodirni godinu za priču": joins the Croatian Memorable-moments bullets
// above onto the matching edition row by year, same as the English page's
// CompetitionView does with the English bullets - see buildYearStories() in
// src/lib/editions.ts.
const stories = buildYearStories(data.editions, CROATIAN_MOMENTS);

const headerLabels: Record<string, string> = {
  Year: 'Godina',
  Winner: 'Pobjednik',
  'National team': 'Reprezentacija',
  'Ceremony date': 'Datum svečanosti',
};
---

<BaseLayout
  title={title}
  description="Svaki dobitnik muške Zlatne lopte od 1956., s reprezentacijom i generiranim brojem nagrada. Filtriraj po dobitniku, godini i reprezentaciji."
  locale="hr"
  alternateHref={withBase('/competitions/ballon-dor')}
  jsonLd={jsonLd}
>
  <article class="competition stack">
    <header class="competition__header">
      <p class="eyebrow badge">{statusText}</p>
      <h1>{title}</h1>
      <p class="competition__intro">
        France Football je 1956. godine pokrenuo Zlatnu loptu. Pravila
        prihvatljivosti mijenjala su se tijekom vremena: nagrada je isprva
        bila ograničena na europske igrače, 1995. otvorena je igračima bilo
        koje nacionalnosti u europskim klubovima, a od 2007. postala je
        potpuno globalna. Od 2010. do 2015. dodjeljivala se zajedno s
        FIFA-om.
      </p>
      <PrintDownloadLink
        slug="ballon-dor-hr"
        label="Preuzmi PDF za ispis"
        hint="A4 položeno, ista tablica i zbrojevi kao na ovoj stranici."
      />
    </header>

    <TournamentTable
      id="ballon-dor"
      caption="Dobitnici Zlatne lopte, od 1956. do danas"
      table={data.table}
      editions={data.editions}
      winners={data.winners}
      hosts={data.hosts}
      teams={data.teams}
      yearLinks={yearLinks}
      locale="hr"
      headerLabels={headerLabels}
      winnerLabel="Pobjednik"
      winnerAllLabel="Svi pobjednici"
      yearLabel="Godina"
      yearAllLabel="Sve godine"
      teamLabel="Reprezentacija"
      teamAllLabel="Sve reprezentacije"
      sortByLabel="Sortiraj po"
      resetLabel="Poništi"
      filterAriaLabel="Filtriraj dobitnike Zlatne lopte"
      showingAllTemplate="Prikazano svih {n} izdanja."
      showingFilteredTemplate="Prikazano {shown} od {total} izdanja ({bits})."
      bitWinnerPrefix="pobjednik"
      bitYearPrefix="godina"
      bitTeamPrefix="reprezentacija"
      emptyText="Nijedno izdanje ne odgovara odabranim filterima."
      clearFiltersLabel="Očisti filtere"
      storyColumn={stories.size > 0 ? { label: 'Priča', values: stories } : undefined}
      storySummaryLabel="📖 Dodirni za priču"
    />

    <ChampionsSummary
      champions={data.champions}
      scaleMax={data.editions.length}
      heading="Prvaci po broju naslova"
      description="Automatski generirano iz gornje tablice izdanja. Zbrojevi grupiraju naciju s njezinim sportskim nasljednikom samo tamo gdje to čini izvorni sadržaj; svaki drugi naziv broji se onako kako je zapisan."
      unit={['naslov', 'naslova']}
      winningYearsLabel="Godine osvajanja: "
      ofLabel="od"
    />

    <EditorialNotes sections={notes} />

    <References
      sources={data.sources}
      lastReviewed={data.lastReviewed}
      status={data.status}
      heading="Izvori i provjera"
      statusPrefix="Status:"
      statusText={statusText}
      lastReviewedPrefix="Zadnja provjera:"
      dateLocale="hr-HR"
      noSourcesText="Za ovu stranicu još nisu navedene poveznice na izvore."
      noteText="Prednost imaju primarni izvori. Povijesni formati i nazivi reprezentacija bilježe se onako kako su korišteni u to vrijeme; kontekst potražite u napomenama uz svako izdanje."
    />
  </article>
</BaseLayout>

<style>
  .competition__header {
    margin-bottom: 0.5rem;
  }

  .eyebrow {
    margin-bottom: 0.6rem;
  }

  .competition__header h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }

  .competition__intro {
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 1.05rem;
  }
</style>
