// competition's own finals only - see that function's own comment in
// src/lib/quiz.ts for why, same as quiz.astro's own identical helper.
const rivalriesFor = (title: string, editions: Edition[]) =>
  buildRivalries(buildFinalsMeetings([{ title, slug: title, editions }]));

