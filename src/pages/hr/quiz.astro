    questions: topScorerByYearQuestions(
      goldenBootEuro.editions,
      GOLDEN_BOOT_EURO_NAME,
      'golden-boot-euro',
      'hr',
    ),
    take: 2,
    seed: 'pick:golden-boot-euro:scorer',
  },
  {
    questions: mostTitlesQuestion(
      goldenBootEuro.champions,
      GOLDEN_BOOT_EURO_NAME,
      'golden-boot-euro',
      'player',
      'hr',
    ),
    take: 1,
    seed: 'pick:golden-boot-euro:most-titles',
  },
  {
    questions: longestStreakQuestion(
      buildLongestStreaks(goldenBootEuro.editions),
      GOLDEN_BOOT_EURO_NAME,
      'golden-boot-euro',
      'player',
      'hr',
    ),
    take: 1,
    seed: 'pick:golden-boot-euro:longest-streak',
  },
  {
    questions: longestTitleGapQuestion(
      buildLongestTitleGaps(goldenBootEuro.editions),
      GOLDEN_BOOT_EURO_NAME,
      'golden-boot-euro',
      'player',
      'hr',
    ),
    take: 1,
    seed: 'pick:golden-boot-euro:longest-gap',
  },
  {
    questions: fiercestRivalryQuestion(fiercestRivalries, 'fiercest-rivalry', 'hr'),
    take: 1,
    seed: 'pick:fiercest-rivalry',
  },
];

const questions = selectQuiz(pools, 'family-quiz:v1');

// Same "chronological order" ranking questions as the English page, with a
// Croatian item label and locale: 'hr' for the Croatian prompt wording. The
// three individual awards sample only uniqueWinnerEditions() the same way
// the English page does - see that page's own comment for why.
const hostedByLabel = (edition: Edition) => `${edition.winner} (domaćin: ${edition.host ?? '—'})`;
const winnerLabel = (edition: Edition) => edition.winner;
const orderQuestions = [
  ...chronologicalOrderQuestions(worldCup.editions, WORLD_CUP_NAME, 'world-cup', hostedByLabel, 4, 'hr'),
  ...chronologicalOrderQuestions(euro.editions, EURO_NAME, 'euro', hostedByLabel, 4, 'hr'),
  ...chronologicalOrderQuestions(copaAmerica.editions, COPA_AMERICA_NAME, 'copa-america', hostedByLabel, 4, 'hr'),
  ...chronologicalOrderQuestions(
    nationsLeague.editions,
    NATIONS_LEAGUE_NAME,
    'nations-league',
    hostedByLabel,
    4,
    'hr',
  ),
  ...chronologicalOrderQuestions(
    uniqueWinnerEditions(ballonDor.editions),
    BALLON_DOR_NAME,
    'ballon-dor',
    winnerLabel,
    4,
    'hr',
  ),
  ...chronologicalOrderQuestions(
    uniqueWinnerEditions(goldenBootWorldCup.editions),
    GOLDEN_BOOT_WORLD_CUP_NAME,
    'golden-boot-world-cup',
    winnerLabel,
    4,
    'hr',
  ),
  ...chronologicalOrderQuestions(
    uniqueWinnerEditions(goldenBootEuro.editions),
    GOLDEN_BOOT_EURO_NAME,
    'golden-boot-euro',
    winnerLabel,
    4,
    'hr',
  ),
];

const sources = disambiguateLabels(
  [
    ...worldCup.sources,
    ...euro.sources,
    ...copaAmerica.sources,
    ...nationsLeague.sources,
    ...ballonDor.sources,
    ...goldenBootWorldCup.sources,
    ...goldenBootEuro.sources,
  ].filter((source, index, all) => all.findIndex((s) => s.url === source.url) === index),
);

const lastReviewed = [
  worldCup.lastReviewed,
  euro.lastReviewed,
  copaAmerica.lastReviewed,
  nationsLeague.lastReviewed,
  ballonDor.lastReviewed,
  goldenBootWorldCup.lastReviewed,
  meta.lastReviewed,
]
  .sort()
  .at(-1) as string;

// Croatian counterpart of src/pages/quiz.astro's jsonLd block. The
// `questions` pool already carries Croatian prompt/choice text (every
// builder above was called with `'hr'`), so no separate translation is
// needed here beyond the schema's own `name`.
const jsonLd: JsonLdObject[] = [
  buildQuizJsonLd(questions, {
    pageUrl: absolutePageUrl(Astro.url, Astro.site),
    name: 'Kompletna nogometna referenca - obiteljski kviz',
    dateModified: lastReviewed,
  }),
];
---

<BaseLayout
  title="Obiteljski kviz"
  description="Obiteljski nogometni kviz iz tablica Svjetskog prvenstva, EURA, Copa América, Lige nacija, Zlatne lopte i Zlatne kopačke - prvaci i domaćini."
  locale="hr"
  alternateHref={withBase('/quiz')}
  jsonLd={jsonLd}
  dateModified={lastReviewed}
>
  <article class="quiz stack">
    <header class="quiz__header">
      <p class="eyebrow badge">{t('hr', 'quizEyebrow')}</p>
      <h1>Obiteljski kviz</h1>
      <p class="quiz__intro">
        Provjeri svoje znanje o povijesti nogometa kvizom generiranim izravno
        iz tablica natjecanja na ovoj stranici - prvaci, domaćini, finala i
        najbolji strijelci Svjetskog prvenstva, UEFA EURA, natjecanja Copa
        América, UEFA Lige nacija, Zlatne lopte i Zlatne kopačke. Ništa ovdje
        nije ručno napisana trivia, pa kviz ostaje usklađen kako se dodaju
        nova izdanja.
      </p>
    </header>

    <EditorialNotes sections={notes} />

    <div class="quiz__score card no-print" id="quiz-score" hidden>
      <p>
        {t('hr', 'quizScoreLabel')}{' '}
        <strong id="quiz-score-value">0</strong> / <span id="quiz-score-total">{questions.length}</span>
      </p>
      <button type="button" id="quiz-restart">{t('hr', 'quizRestart')}</button>
    </div>

    <ol class="quiz__list">
      {
        questions.map((question, index) => (
          <li>
            <QuizCard question={question} index={index} locale="hr" />
          </li>
        ))
      }
    </ol>

    {
      orderQuestions.length > 0 && (
        <section class="quiz__order-section" aria-labelledby="quiz-order-heading">
          <h2 id="quiz-order-heading">{t('hr', 'quizOrderHeading')}</h2>
          <p class="quiz__order-intro">{t('hr', 'quizOrderIntro')}</p>
          <ol class="quiz__list">
            {orderQuestions.map((question, index) => (
              <li>
                <QuizOrderCard question={question} index={index} locale="hr" />
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <References
      sources={sources}
      lastReviewed={lastReviewed}
      status={meta.status}
      heading="Izvori i provjera"
      statusPrefix="Status:"
      statusText={meta.status === 'verified' ? 'Provjereno' : 'U pregledu'}
      lastReviewedPrefix="Zadnja provjera:"
      noSourcesText="Za ovaj kviz još nisu navedene poveznice na izvore."
      noteText="Prednost imaju primarni izvori. Povijesni formati i nazivi reprezentacija bilježe se onako kako su korišteni u to vrijeme; pogledajte napomene svakog izdanja za kontekst."
      dateLocale="hr-HR"
    />
  </article>
</BaseLayout>

<style>
  .quiz__header {
    margin-bottom: 0.5rem;
  }

  .eyebrow {
    margin-bottom: 0.6rem;
  }

  .quiz__header h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }

  .quiz__intro {
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .quiz__score {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    position: sticky;
    /* Nav.astro measures its own real (often multi-line) height into this
       custom property; 3.6rem is only the no-JS fallback and undershoots
       the real header almost everywhere, since eleven nav links don't fit
       one line even at the container's max-width. */
    top: var(--site-header-height, 3.6rem);
    z-index: 10;
  }

  /* The flex display above would otherwise override [hidden]'s display:none
     (author styles beat the UA stylesheet at equal specificity), so a no-JS
     reader would see this sticky score bar - and its dead "Restart" button,
     since QuizScript.astro never runs to wire it up - permanently pinned
     under the header. Same fix TournamentTable.astro's filtered rows and
     three of Nav.astro's own script-driven elements already use. */
  .quiz__score[hidden] {
    display: none;
  }

  .quiz__score p {
    margin: 0;
    font-weight: 600;
  }

  #quiz-restart {
    font: inherit;
    padding: 0.5rem 0.9rem;
    /* AGENTS.md's "Interactive targets are at least 44px in any
       touch-facing control" - the padding above alone only reaches ~43px
       tall, short of that floor. Measured with a real Playwright
       boundingBox() at 360px, not assumed from the CSS. */
    min-height: 2.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    color: var(--text);
    cursor: pointer;
  }

  #quiz-restart:hover {
    border-color: var(--accent);
  }

  .quiz__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .quiz__order-section {
    margin-top: 1.5rem;
  }

  .quiz__order-section h2 {
    font-size: clamp(1.3rem, 4vw, 1.7rem);
    margin-bottom: 0.35rem;
  }

  .quiz__order-intro {
    max-width: 62ch;
    color: var(--text-muted);
    margin-top: 0;
    margin-bottom: 1rem;
  }
</style>

<style is:global>
  /* This page has a second sticky bar (the score bar) below the sticky site
     header, so scroll-into-view targets here need to clear both heights, not
     just the header's - global.css's own scroll-padding-top only knows
     about the header. QuizScript.astro sets --quiz-score-height once the
     score bar is visible. */
  html:has(#quiz-score) {
    scroll-padding-top: calc(var(--site-header-height, 3.6rem) + var(--quiz-score-height, 4.5rem));
  }
</style>

<QuizScript />
