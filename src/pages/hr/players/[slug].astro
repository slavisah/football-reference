---
// Croatian translation of src/pages/players/[slug].astro. getStaticPaths()
// mirrors the English page's slug-collision guard exactly (same
// playerProfileSlug(), same fail-loudly precedent) so a build error there
// catches a collision here too, and the two pages can never end up with a
// different set of player profiles. Only the three award display names
// (passed into buildAllPlayerProfiles() via this file's own Croatian `sources`
// array titles) and this page's own prose/labels are translated - every
// appearance/year/total is computed by the exact same builder the English
// page calls, so the two pages can never disagree on the underlying record.
// The "goalsLabel" option translates the one unit word in an appearance's
// detail line ("8 goals" -> "8 golova"); the team name and ceremony date in
// that same line are source-derived data, left as-is like every other
// historical label on the Croatian site.
import BaseLayout from '../../../layouts/BaseLayout.astro';
import References from '../../../components/References.astro';
import { loadCompetition } from '../../../lib/competition';
import {
  buildAllPlayerProfiles,
  playerProfileSlug,
  type PlayerAwardSource,
  type PlayerProfile,
} from '../../../lib/playerProfile';
import { buildPlayerProfileItemList, type JsonLdObject } from '../../../lib/jsonLd';
import type { SourceLink } from '../../../lib/sources';
import { absolutePageUrl, withBase } from '../../../lib/url';

export async function getStaticPaths() {
  const [ballonDor, worldCupGoldenBoot, euroGoldenBoot] = await Promise.all([
    loadCompetition('ballon-dor', { editionsHeading: 'Winners', sourcesHeading: "Ballon d'Or" }),
    loadCompetition('golden-boot', {
      editionsHeading: 'FIFA World Cup top scorers',
      sourcesHeading: 'FIFA World Cup',
    }),
    loadCompetition('golden-boot', {
      editionsHeading: 'UEFA EURO top scorers',
      sourcesHeading: 'UEFA EURO',
    }),
  ]);

  const sources: PlayerAwardSource[] = [
    { title: 'Zlatna lopta', slug: 'ballon-dor', editions: ballonDor.editions },
    { title: 'Zlatna kopačka Svjetskog prvenstva', slug: 'golden-boot', editions: worldCupGoldenBoot.editions },
    { title: 'Zlatna kopačka EURA', slug: 'golden-boot', editions: euroGoldenBoot.editions },
  ];

  const profiles = buildAllPlayerProfiles(sources, { goalsLabel: 'golova' });

  const combinedSources = [ballonDor.sources, worldCupGoldenBoot.sources, euroGoldenBoot.sources]
    .flat()
    .filter((source, index, all) => all.findIndex((s) => s.url === source.url) === index);
  const lastReviewed = [ballonDor.lastReviewed, worldCupGoldenBoot.lastReviewed, euroGoldenBoot.lastReviewed]
    .sort()
    .at(-1) as string;

  const seenSlugs = new Set<string>();
  return profiles.map((profile) => {
    const slug = playerProfileSlug(profile.id);
    if (seenSlugs.has(slug)) {
      throw new Error(`Two players produced the same /hr/players/ slug: "${slug}"`);
    }
    seenSlugs.add(slug);
    return {
      params: { slug },
      props: { profile, sources: combinedSources, lastReviewed },
    };
  });
}

type Props = {
  profile: PlayerProfile;
  sources: SourceLink[];
  lastReviewed: string;
};

const { profile, sources, lastReviewed } = Astro.props as Props;
const slug = playerProfileSlug(profile.id);

const jsonLd: JsonLdObject[] =
  profile.awards.length > 0
    ? [
        buildPlayerProfileItemList(profile, {
          pageUrl: absolutePageUrl(Astro.url, Astro.site),
          name: `${profile.displayName} - cjelovita povijest nagrada`,
        }),
      ]
    : [];
---

<BaseLayout
  title={`${profile.displayName} - cjelovita povijest nagrada`}
  description={`Svaka muška Zlatna lopta i Zlatna kopačka Svjetskog prvenstva/EURA za igrača ${profile.displayName}, generirano iz tablice pobjednika svake nagrade.`}
  locale="hr"
  alternateHref={withBase(`/players/${slug}`)}
  jsonLd={jsonLd}
>
  <article class="player-profile stack">
    <header class="player-profile__header">
      <p class="eyebrow badge">Generirano iz tablica nagrada</p>
      <h1>{profile.displayName}</h1>
      <p class="player-profile__intro">
        Cjeloviti učinak igrača {profile.displayName} u muškoj Zlatnoj lopti te Zlatnoj kopački
        Svjetskog prvenstva i EURA - svaka nagrada, generirano izravno iz tablice pobjednika svake
        nagrade.
      </p>
    </header>

    <section class="player-profile__totals card" aria-labelledby="totals-heading">
      <h2 id="totals-heading" class="visually-hidden">Ukupni zbroj</h2>
      <dl class="player-profile__totals-grid">
        <div>
          <dt>Ukupno nagrada</dt>
          <dd>{profile.totalAwards}</dd>
        </div>
      </dl>
    </section>

    {
      profile.awards.map((award, index) => (
        <section class="card stack" aria-labelledby={`award-${index}-heading`}>
          <h2 id={`award-${index}-heading`}>
            <a href={withBase(`/hr/competitions/${award.slug}`)}>{award.title}</a>
          </h2>
          <ol class="player-profile__list">
            {award.appearances.map((a) => (
              <li class="is-title">
                <span class="player-profile__year">{a.year}</span>
                <span aria-hidden="true">🏆</span>
                {a.detail && <span class="player-profile__detail">{a.detail}</span>}
              </li>
            ))}
          </ol>
        </section>
      ))
    }

    <References
      sources={sources}
      lastReviewed={lastReviewed}
      status="verified"
      heading="Izvori i provjera"
      statusPrefix="Status:"
      statusText="Provjereno"
      lastReviewedPrefix="Zadnja provjera:"
      dateLocale="hr-HR"
      noSourcesText="Za ovu stranicu još nisu navedene poveznice na izvore."
      noteText="Prednost imaju primarni izvori. Povijesni formati i nazivi bilježe se onako kako su korišteni u to vrijeme; kontekst potražite u napomenama uz svako izdanje."
    />
  </article>
</BaseLayout>

<style>
  .player-profile__header {
    margin-bottom: 0.5rem;
  }

  .eyebrow {
    margin-bottom: 0.6rem;
  }

  .player-profile__header h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }

  .player-profile__intro {
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .player-profile__totals-grid {
    margin: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    text-align: center;
  }

  .player-profile__totals-grid dt {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .player-profile__totals-grid dd {
    margin: 0.2rem 0 0;
    font-size: 1.6rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--accent);
  }

  .player-profile__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .player-profile__list li {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.5rem 0.8rem;
    background: var(--bg-elevated);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
  }

  .player-profile__year {
    font-weight: 700;
    min-width: 4.5rem;
    font-variant-numeric: tabular-nums;
  }

  .player-profile__detail {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>
