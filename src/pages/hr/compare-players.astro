---
// Croatian translation of src/pages/compare-players.astro. Same two-step
// rollout /players and /teams both followed (English-only launch, then a
// second run for the Croatian page + NAV_LINKS/TRANSLATED_PATHS promotion) -
// see docs/PROJECT_STATUS.md's 2026-08-21 "/compare-players" entries for the
// English launch and the "left for a future pass" note naming this as the
// natural next slice. Loads the exact same live data as the English page
// (loadCompetition x3 with the same editionsHeading/sourcesHeading pairs,
// buildAllPlayerProfiles, buildAllComparePlayerRecords), so every award
// count/year can never drift between languages - only this page's own
// headings/prose and the three award display names (passed into
// buildAllPlayerProfiles()/the awardDefs list via this file's own Croatian
// `sources` array titles, the same pattern hr/players/[slug].astro already
// uses) are translated. Player names stay as-is, matching every other
// Croatian page's precedent (winner/champion names are the underlying data,
// not UI chrome).
import BaseLayout from '../../layouts/BaseLayout.astro';
import References from '../../components/References.astro';
import PrintDownloadLink from '../../components/PrintDownloadLink.astro';
import { loadCompetition, loadPageMeta } from '../../lib/competition';
import { buildAllPlayerProfiles } from '../../lib/playerProfile';
import type { PlayerAwardSource } from '../../lib/playerProfile';
import {
  buildAllComparePlayerRecords,
  buildSharedAwardYears,
  type ComparePlayerAwardDef,
} from '../../lib/comparePlayers';
import { playerProfileSlug } from '../../lib/playerProfile';
import { absolutePageUrl, withBase } from '../../lib/url';
import { buildPlayersDirectoryItemList, type JsonLdObject } from '../../lib/jsonLd';

const meta = await loadPageMeta('compare-players');

const [ballonDor, worldCupGoldenBoot, euroGoldenBoot] = await Promise.all([
  loadCompetition('ballon-dor', { editionsHeading: 'Winners', sourcesHeading: "Ballon d'Or" }),
  loadCompetition('golden-boot', {
    editionsHeading: 'FIFA World Cup top scorers',
    sourcesHeading: 'FIFA World Cup',
  }),
  loadCompetition('golden-boot', {
    editionsHeading: 'UEFA EURO top scorers',
    sourcesHeading: 'UEFA EURO',
  }),
]);

const sources: PlayerAwardSource[] = [
  { title: 'Zlatna lopta', slug: 'ballon-dor', editions: ballonDor.editions },
  { title: 'Zlatna kopačka Svjetskog prvenstva', slug: 'golden-boot', editions: worldCupGoldenBoot.editions },
  { title: 'Zlatna kopačka EURA', slug: 'golden-boot', editions: euroGoldenBoot.editions },
];

const awardDefs: ComparePlayerAwardDef[] = sources.map((s) => ({ title: s.title, slug: s.slug }));

const profiles = buildAllPlayerProfiles(sources, { goalsLabel: 'golova' });
const sortedByName = [...profiles].sort((a, b) => a.displayName.localeCompare(b.displayName));

const allRecords = buildAllComparePlayerRecords(profiles, awardDefs);

// Default head-to-head pair: the two most-decorated players, so the panel
// shows something meaningful before any JS runs or a URL param is read.
const [defaultA, defaultB] = allRecords;
const defaultSharedYears = buildSharedAwardYears(defaultA, defaultB);

const combinedSources = [ballonDor.sources, worldCupGoldenBoot.sources, euroGoldenBoot.sources]
  .flat()
  .filter((source, index, all) => all.findIndex((s) => s.url === source.url) === index);

const lastReviewed = [ballonDor.lastReviewed, worldCupGoldenBoot.lastReviewed, euroGoldenBoot.lastReviewed]
  .concat(meta.lastReviewed)
  .sort()
  .at(-1) as string;

const statusText = meta.status === 'verified' ? 'Provjereno' : 'U pregledu';

// Panel "jedan protiv jednoga": jedan redak po statistici, s vrijednostima
// obaju igrača jednu do druge (isti oblik kao engleska stranica i /compare).
function leaderOf(a: number, b: number): 'a' | 'b' | 'tie' {
  if (a > b) return 'a';
  if (b > a) return 'b';
  return 'tie';
}

function yearsText(years: { year: string }[]): string {
  return years.map((y) => y.year).join(', ') || '—';
}

const recordsForClient = allRecords.map((r) => ({
  id: r.id,
  displayName: r.displayName,
  totalAwards: r.totalAwards,
  awards: r.awards.map((a) => ({ title: a.title, slug: a.slug, count: a.count, years: a.years })),
}));

// Croatian counterpart of src/pages/compare-players.astro's jsonLd block -
// same data (ranked by total awards, not alphabetical, like the English
// page), a Croatian item-list name, and the same describe() translation
// pattern hr/players/index.astro already uses for its own directory ItemList.
const jsonLd: JsonLdObject[] = [
  buildPlayersDirectoryItemList(profiles, {
    pageUrl: absolutePageUrl(Astro.url, Astro.site),
    name: 'Igrači poredani po ukupnom broju osvojenih Zlatnih lopti/kopački',
    describe: (profile) =>
      `${profile.totalAwards} ${profile.totalAwards === 1 ? 'nagrada' : 'nagrade'} u muškoj Zlatnoj lopti i Zlatnoj kopački Svjetskog prvenstva/EURA`,
  }),
];
---

<BaseLayout
  title="Usporedi igrače"
  description="Usporedite dvojicu dobitnika muške Zlatne lopte ili Zlatne kopačke Svjetskog prvenstva/EURA izravno, generirano iz istih tablica nagrada kao i stranica Igrači."
  locale="hr"
  alternateHref={withBase('/compare-players')}
  jsonLd={jsonLd}
>
  <article class="compare stack">
    <header class="compare__header">
      <p class="eyebrow badge">Generirano iz tablica nagrada</p>
      <h1>Usporedi igrače</h1>
      <p class="compare__intro">
        Odaberite dva igrača za usporedbu njihovog učinka u muškoj Zlatnoj
        lopti te Zlatnoj kopački Svjetskog prvenstva i EURA - koliko je puta
        svaki od njih osvojio svaku nagradu, generirano izravno iz istih
        tablica nagrada kao i stranica "Igrači". Reprezentacije ovdje nisu
        uključene; za tu usporedbu pogledajte "Usporedba".
      </p>
      <PrintDownloadLink
        slug="compare-players-hr"
        label="Preuzmi PDF za ispis"
        hint="A4 položeno, zadani par prikazan ispod te cjelokupni poredak igrača."
      />
    </header>

    <section class="card stack" aria-labelledby="head-to-head-heading">
      <h2 id="head-to-head-heading">Izravna usporedba</h2>

      <div class="compare__picker no-print">
        <div class="compare__field">
          <label for="compare-a">Igrač A</label>
          <select id="compare-a" name="a">
            {
              sortedByName.map((p) => (
                <option value={p.id} selected={p.id === defaultA.id}>
                  {p.displayName}
                </option>
              ))
            }
          </select>
        </div>

        <button type="button" id="compare-swap" class="compare__swap" aria-label="Zamijeni igrača A i B">
          &#8646; Zamijeni
        </button>

        <div class="compare__field">
          <label for="compare-b">Igrač B</label>
          <select id="compare-b" name="b">
            {
              sortedByName.map((p) => (
                <option value={p.id} selected={p.id === defaultB.id}>
                  {p.displayName}
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <p
        id="compare-status"
        class="visually-hidden"
        role="status"
        aria-live="polite"
        data-template="Usporedba: {a} protiv {b}."
      >
        {`Usporedba: ${defaultA.displayName} protiv ${defaultB.displayName}.`}
      </p>

      <div class="vs" id="compare-panel">
        <table class="vs__table">
          <caption
            class="visually-hidden"
            id="compare-caption"
            data-template="{a} u usporedbi s {b}, po nagradama"
          >
            {`${defaultA.displayName} u usporedbi s ${defaultB.displayName}, po nagradama`}
          </caption>
          <thead>
            <tr>
              <th scope="col" class="vs__team" id="compare-a-name">{defaultA.displayName}</th>
              <th scope="col" class="vs__stat-head">Nagrada</th>
              <th scope="col" class="vs__team" id="compare-b-name">{defaultB.displayName}</th>
            </tr>
          </thead>
          {
            defaultA.awards.map((award, index) => {
              const other = defaultB.awards[index];
              // Dva igrača koja nikad nisu osvojila ovu nagradu svode se na
              // jedan redak: reci s nulama i crticama na mobitelu su većina
              // visine panela, a nijedna informacija.
              const empty = award.count === 0 && other.count === 0;
              return (
                <tbody data-index={index} data-empty={String(empty)}>
                  <tr class="vs__group">
                    <th colspan="3" scope="colgroup">
                      {award.title}
                    </th>
                  </tr>
                  <tr class="vs__none">
                    <td colspan="3">Nijedan igrač nije osvojio ovu nagradu.</td>
                  </tr>
                  <tr data-metric="count" data-leader={leaderOf(award.count, other.count)}>
                    <td class="vs__value" data-side="a">{award.count}</td>
                    <th scope="row" class="vs__stat">Broj osvajanja</th>
                    <td class="vs__value" data-side="b">{other.count}</td>
                  </tr>
                  <tr data-metric="years" class="vs__years-row">
                    <td class="vs__years" data-side="a">{yearsText(award.years)}</td>
                    <th scope="row" class="vs__stat">Godine</th>
                    <td class="vs__years" data-side="b">{yearsText(other.years)}</td>
                  </tr>
                </tbody>
              );
            })
          }
          <tbody data-index="combined" class="vs__combined" data-empty="false">
            <tr class="vs__group">
              <th colspan="3" scope="colgroup">Ukupno</th>
            </tr>
            <tr
              data-metric="count"
              data-leader={leaderOf(defaultA.totalAwards, defaultB.totalAwards)}
            >
              <td class="vs__value" data-side="a">{defaultA.totalAwards}</td>
              <th scope="row" class="vs__stat">Ukupno nagrada</th>
              <td class="vs__value" data-side="b">{defaultB.totalAwards}</td>
            </tr>
          </tbody>
        </table>
      </div>

      <p class="muted compare__note">
        "Godine" navodi svaku godinu u kojoj je taj igrač osvojio nagradu u
        tom retku, od najstarije prema najnovijoj. Natjecanja reprezentacija
        (naslovi Svjetskog prvenstva, EURA, Copa Américe, Lige nacija) ovdje
        nisu uključena: ona nagrađuju reprezentacije, a ne pojedince - za tu
        usporedbu pogledajte <a href={withBase('/hr/compare')}>Usporedba</a>.
      </p>
    </section>

    <section class="card stack" aria-labelledby="shared-years-heading">
      <h2 id="shared-years-heading">Zajedničke godine</h2>
      <p class="muted" id="shared-years-intro">
        Svaka godina u kojoj su i <span id="shared-years-a-name">{defaultA.displayName}</span> i{' '}
        <span id="shared-years-b-name">{defaultB.displayName}</span> osvojili nagradu, bez obzira je
        li riječ o istoj nagradi.
      </p>
      <div
        id="shared-years-body"
        data-empty-text="Ova dva igrača nisu nikada iste godine osvojila nagradu."
      >
        {
          defaultSharedYears.length === 0 ? (
            <p class="muted" id="shared-years-empty">
              Ova dva igrača nisu nikada iste godine osvojila nagradu.
            </p>
          ) : (
            <ol class="shared-years__list" id="shared-years-list">
              {defaultSharedYears.map((s) => (
                <li>
                  <span class="shared-years__year">{s.year}</span>
                  <span class="shared-years__detail">
                    <strong>{defaultA.displayName}</strong>: {s.aAwards.join(', ')}
                  </span>
                  <span class="shared-years__detail">
                    <strong>{defaultB.displayName}</strong>: {s.bAwards.join(', ')}
                  </span>
                </li>
              ))}
            </ol>
          )
        }
      </div>
    </section>

    <section class="stack" aria-labelledby="all-players-heading">
      <h2 id="all-players-heading">Svi igrači</h2>
      <p class="muted">
        Svaki dobitnik Zlatne lopte ili Zlatne kopačke, poredan po ukupnom
        broju nagrada. Odaberite bilo koja dva iznad za izravnu usporedbu,
        ili odaberite ime u nastavku za cjeloviti pregled po godinama na{' '}
        <a href={withBase('/hr/players')}>stranici Igrači</a>.
      </p>
      <div
        class="t-wrap"
        tabindex="0"
        role="region"
        aria-label="Ukupan pregled nagrada svih igrača, poredanih po ukupnom broju nagrada"
      >
        <table class="compare__table compare__table--all">
          <caption class="visually-hidden">
            Ukupan pregled nagrada svih igrača, poredanih po ukupnom broju nagrada
          </caption>
          <thead>
            <tr>
              <th scope="col">Poredak</th>
              <th scope="col">Igrač</th>
              {awardDefs.map((a) => <th scope="col">{a.title}</th>)}
              <th scope="col">Ukupno</th>
            </tr>
          </thead>
          <tbody>
            {
              allRecords.map((r, i) => (
                <tr>
                  <td>{i + 1}</td>
                  <th scope="row">
                    <a href={withBase(`/hr/players/${playerProfileSlug(r.id)}`)}>{r.displayName}</a>
                  </th>
                  {r.awards.map((a) => (
                    <td>{a.count}</td>
                  ))}
                  <td>{r.totalAwards}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <References
      sources={combinedSources}
      lastReviewed={lastReviewed}
      status={meta.status}
      heading="Izvori i provjera"
      statusPrefix="Status:"
      statusText={statusText}
      lastReviewedPrefix="Zadnja provjera:"
      dateLocale="hr-HR"
      noSourcesText="Za ovu stranicu još nisu navedene poveznice na izvore."
      noteText="Prednost imaju primarni izvori. Povijesni formati i nazivi bilježe se onako kako su korišteni u to vrijeme; kontekst potražite u napomenama uz svako izdanje."
    />
  </article>
</BaseLayout>

<style>
  .compare__header {
    margin-bottom: 0.5rem;
  }

  .eyebrow {
    margin-bottom: 0.6rem;
  }

  .compare__header h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }

  .compare__intro {
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .compare__picker {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem 1rem;
    padding: 1rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .compare__field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 12rem;
    flex: 1 1 12rem;
  }

  .compare__field label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .compare__field select {
    font: inherit;
    padding: 0.5rem 0.6rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    width: 100%;
  }

  .compare__swap {
    font: inherit;
    padding: 0.55rem 0.9rem;
    color: var(--text);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    white-space: nowrap;
  }

  .compare__swap:hover {
    border-color: var(--accent);
  }

  /* "Versus" comparison table: one row per statistic, Team A's value on the
     left, Team B's on the right, the metric label between them. Transposed
     from the two separate per-team tables this panel used to render, which
     put the two numbers a reader wants to compare on different screens at
     360px - each table was wider than the viewport and they stacked
     vertically. Three narrow columns fit any phone with no horizontal
     scroll, so no .t-wrap wrapper is needed here (the "All national teams"
     ranking below still has one - it genuinely has one column per award). */
  .vs {
    container-type: inline-size;
  }

  .vs__table {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    table-layout: fixed;
  }

  .vs__table thead th {
    position: sticky;
    /* Sits directly under the sticky site header, whose real height varies
       by viewport and locale - Nav.astro measures it into this property. */
    top: var(--site-header-height, 3.5rem);
    z-index: 1;
    padding: 0.7rem 0.5rem;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
    text-align: center;
  }

  .vs__team {
    width: 34%;
    font-size: 1rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .vs__stat-head {
    width: 32%;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .vs__group th {
    padding: 0.55rem 0.7rem;
    background: var(--bg-subtle);
    border-block: 1px solid var(--border);
    text-align: left;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .vs__table tbody tr:not(.vs__group) th,
  .vs__table tbody tr:not(.vs__group) td {
    padding: 0.6rem 0.4rem;
    border-bottom: 1px solid var(--border);
  }

  .vs__stat {
    text-align: center;
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .vs__value {
    text-align: center;
    font-size: 1.35rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* The leading side. Weight, colour and a marker together, never colour
     alone - the same rule global.css documents for the winner cell in
     TournamentTable. */
  .vs__table tr[data-leader='a'] .vs__value[data-side='a'],
  .vs__table tr[data-leader='b'] .vs__value[data-side='b'] {
    color: var(--accent);
    font-weight: 800;
  }

  .vs__table tr[data-leader='a'] .vs__value[data-side='a']::after,
  .vs__table tr[data-leader='b'] .vs__value[data-side='b']::after {
    content: '';
    display: inline-block;
    width: 0;
    height: 0;
    margin-inline-start: 0.35rem;
    vertical-align: 0.15em;
    border-inline: 0.3rem solid transparent;
    border-bottom: 0.42rem solid currentColor;
  }

  @media (forced-colors: active) {
    .vs__table tr[data-leader='a'] .vs__value[data-side='a'],
    .vs__table tr[data-leader='b'] .vs__value[data-side='b'] {
      outline: 1px solid CanvasText;
      outline-offset: -3px;
    }
  }

  .vs__combined tr:not(.vs__group) td,
  .vs__combined tr:not(.vs__group) th {
    font-size: 1.05rem;
  }

  .vs__combined .vs__value {
    font-size: 1.5rem;
  }

  .vs__table tbody:last-child tr:last-child th,
  .vs__table tbody:last-child tr:last-child td {
    border-bottom: none;
  }

  /* Room for longer metric labels once the panel is wide enough. */
  @container (min-width: 34rem) {
    .vs__team {
      font-size: 1.15rem;
    }

    .vs__stat {
      font-size: 0.95rem;
    }

    .vs__table tbody tr:not(.vs__group) th,
    .vs__table tbody tr:not(.vs__group) td {
      padding: 0.7rem 1rem;
    }
  }

  .vs__years {
    text-align: center;
    font-size: 0.8rem;
    line-height: 1.4;
    color: var(--text-muted);
    overflow-wrap: anywhere;
  }

  .vs__none {
    display: none;
  }

  .vs__table tbody[data-empty='true'] tr[data-metric] {
    display: none;
  }

  .vs__table tbody[data-empty='true'] .vs__none {
    display: table-row;
  }

  .vs__none td {
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .t-wrap {
    overflow-x: auto;
    border-radius: var(--radius);
  }

  .compare__table {
    width: 100%;
    min-width: 28rem;
    border-collapse: collapse;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .compare__table--all {
    min-width: 34rem;
  }

  .compare__table th,
  .compare__table td {
    padding: 0.55rem 0.7rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    white-space: nowrap;
  }

  .compare__table thead th {
    background: var(--bg-subtle);
    font-size: 0.85rem;
  }

  .compare__table tfoot th,
  .compare__table tfoot td {
    font-weight: 700;
    border-top: 2px solid var(--border);
    border-bottom: none;
  }

  .compare__table tbody tr:last-child th,
  .compare__table tbody tr:last-child td {
    border-bottom: none;
  }

  .t-wrap {
    overflow-x: auto;
    border-radius: var(--radius);
  }

  .compare__table {
    width: 100%;
    min-width: 28rem;
    border-collapse: collapse;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .compare__table--all {
    min-width: 34rem;
  }

  .compare__table th,
  .compare__table td {
    padding: 0.55rem 0.7rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    white-space: nowrap;
  }

  .compare__table thead th {
    background: var(--bg-subtle);
    font-size: 0.85rem;
  }

  .compare__table tfoot th,
  .compare__table tfoot td {
    font-weight: 700;
    border-top: 2px solid var(--border);
    border-bottom: none;
  }

  .compare__table tbody tr:last-child th,
  .compare__table tbody tr:last-child td {
    border-bottom: none;
  }

  .compare__note {
    font-size: 0.85rem;
    max-width: 68ch;
  }

  .shared-years__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .shared-years__list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.8rem;
    padding: 0.6rem 0.8rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .shared-years__year {
    font-weight: 700;
    min-width: 3.2rem;
  }

  .shared-years__detail {
    color: var(--text-muted);
    font-size: 0.9rem;
  }
</style>

<script is:inline define:vars={{ records: recordsForClient }}>
  const selectA = document.getElementById('compare-a');
  const selectB = document.getElementById('compare-b');
  const swapBtn = document.getElementById('compare-swap');
  const status = document.getElementById('compare-status');
  const statusTemplate = status?.dataset.template ?? '{a} vs {b}';
  const byId = new Map(records.map((r) => [r.id, r]));
  const sharedYearsBody = document.getElementById('shared-years-body');
  const sharedYearsEmptyText = sharedYearsBody?.dataset.emptyText ?? '';

  // Fills the versus table: each award is one tbody carrying data-index, so
  // one pass sets both players' values and re-derives which side leads.
  // Replaces the old fill-one-side-at-a-time pass, which had a table each.
  const panel = document.getElementById('compare-panel');
  const caption = document.getElementById('compare-caption');
  const captionTemplate = caption?.dataset.template ?? '';

  function yearsText(years) {
    return years.length ? years.map((y) => y.year).join(', ') : '—';
  }

  function setLeader(row, aValue, bValue) {
    let leader = 'tie';
    if (aValue > bValue) leader = 'a';
    else if (bValue > aValue) leader = 'b';
    row.dataset.leader = leader;
  }

  function fillVersus(a, b) {
    const nameA = document.getElementById('compare-a-name');
    const nameB = document.getElementById('compare-b-name');
    if (nameA) nameA.textContent = a.displayName;
    if (nameB) nameB.textContent = b.displayName;
    if (caption && captionTemplate) {
      caption.textContent = captionTemplate
        .replace('{a}', a.displayName)
        .replace('{b}', b.displayName);
    }
    if (!panel) return;

    a.awards.forEach((award, index) => {
      const other = b.awards[index];
      const group = panel.querySelector(`tbody[data-index="${index}"]`);
      if (!group || !other) return;

      const countRow = group.querySelector('tr[data-metric="count"]');
      if (countRow) {
        countRow.querySelector('.vs__value[data-side="a"]').textContent = String(award.count);
        countRow.querySelector('.vs__value[data-side="b"]').textContent = String(other.count);
        setLeader(countRow, award.count, other.count);
      }

      const yearsRow = group.querySelector('tr[data-metric="years"]');
      if (yearsRow) {
        yearsRow.querySelector('.vs__years[data-side="a"]').textContent = yearsText(award.years);
        yearsRow.querySelector('.vs__years[data-side="b"]').textContent = yearsText(other.years);
      }

      group.dataset.empty = award.count === 0 && other.count === 0 ? 'true' : 'false';
    });

    const combined = panel.querySelector('tbody[data-index="combined"] tr[data-metric="count"]');
    if (combined) {
      combined.querySelector('.vs__value[data-side="a"]').textContent = String(a.totalAwards);
      combined.querySelector('.vs__value[data-side="b"]').textContent = String(b.totalAwards);
      setLeader(combined, a.totalAwards, b.totalAwards);
    }
  }

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function sharedAwardYears(a, b) {
    function yearsFor(record) {
      const map = new Map();
      for (const award of record.awards) {
        for (const y of award.years) {
          const entry = map.get(y.year) || { yearSort: y.yearSort, titles: [] };
          entry.titles.push(award.title);
          map.set(y.year, entry);
        }
      }
      return map;
    }
    const aYears = yearsFor(a);
    const bYears = yearsFor(b);
    const shared = [];
    for (const [year, aEntry] of aYears) {
      const bEntry = bYears.get(year);
      if (!bEntry) continue;
      shared.push({ year, yearSort: aEntry.yearSort, aAwards: aEntry.titles, bAwards: bEntry.titles });
    }
    return shared.sort((x, y) => x.yearSort - y.yearSort);
  }

  function renderSharedYears(a, b) {
    if (!sharedYearsBody) return;

    const aName = document.getElementById('shared-years-a-name');
    const bName = document.getElementById('shared-years-b-name');
    if (aName) aName.textContent = a.displayName;
    if (bName) bName.textContent = b.displayName;

    const shared = sharedAwardYears(a, b);

    if (shared.length === 0) {
      sharedYearsBody.innerHTML = `<p class="muted" id="shared-years-empty">${escapeHtml(sharedYearsEmptyText)}</p>`;
      return;
    }

    const items = shared
      .map(
        (s) =>
          `<li><span class="shared-years__year">${escapeHtml(s.year)}</span><span class="shared-years__detail"><strong>${escapeHtml(a.displayName)}</strong>: ${escapeHtml(s.aAwards.join(', '))}</span><span class="shared-years__detail"><strong>${escapeHtml(b.displayName)}</strong>: ${escapeHtml(s.bAwards.join(', '))}</span></li>`,
      )
      .join('');
    sharedYearsBody.innerHTML = `<ol class="shared-years__list" id="shared-years-list">${items}</ol>`;
  }

  function readParams() {
    const p = new URLSearchParams(window.location.search);
    return { a: p.get('a') || '', b: p.get('b') || '' };
  }

  function writeParams(a, b) {
    const p = new URLSearchParams(window.location.search);
    a ? p.set('a', a) : p.delete('a');
    b ? p.set('b', b) : p.delete('b');
    const qs = p.toString();
    const url = window.location.pathname + (qs ? `?${qs}` : '') + window.location.hash;
    window.history.replaceState({}, '', url);
  }

  function render() {
    const a = byId.get(selectA.value);
    const b = byId.get(selectB.value);
    if (a && b) {
      fillVersus(a, b);
      renderSharedYears(a, b);
    }
    if (status && a && b) {
      status.textContent = statusTemplate
        .replace('{a}', a.displayName)
        .replace('{b}', b.displayName);
    }
    writeParams(selectA.value, selectB.value);
  }

  // Restore a shared link's selection, if both ids are known.
  const initial = readParams();
  if (initial.a && byId.has(initial.a)) selectA.value = initial.a;
  if (initial.b && byId.has(initial.b)) selectB.value = initial.b;

  selectA.addEventListener('change', render);
  selectB.addEventListener('change', render);
  swapBtn?.addEventListener('click', () => {
    const a = selectA.value;
    selectA.value = selectB.value;
    selectB.value = a;
    render();
  });

  render();
</script>
