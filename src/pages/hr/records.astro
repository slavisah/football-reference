---
// Croatian translation of src/pages/records.astro. Third slice of the
// "optional Croatian/English localization" item from
// docs/WEBSITE_REQUIREMENTS.md - see docs/PROJECT_STATUS.md for the rollout
// plan. Loads the exact same live data as the English page (loadCompetition
// x7, buildTimeline), so every number, timeline entry and ranking can never
// drift between languages - only this page's own headings/prose, and the
// competition/award display names, are translated. The competition and
// award names reuse the exact Croatian strings already used on the Croatian
// home page (src/lib/homeCards.ts's CARD_TEXT) and sources page, so a
// competition is never called two different things across the site.
import BaseLayout from '../../layouts/BaseLayout.astro';
import ChampionsTimeline from '../../components/ChampionsTimeline.astro';
import ChampionsSummary from '../../components/ChampionsSummary.astro';
import References from '../../components/References.astro';
import PrintDownloadLink from '../../components/PrintDownloadLink.astro';
import { loadCompetition, loadPageMeta } from '../../lib/competition';
import {
  buildBiggestFinalMargins,
  buildHomeSoilTitles,
  buildHostsSummary,
  buildLongestStreaks,
  buildLongestTitleGaps,
  buildRunnerUpsWithoutTitle,
  buildTimeline,
} from '../../lib/editions';
import { absolutePageUrl, withBase } from '../../lib/url';
import { buildChampionsItemList, type JsonLdObject } from '../../lib/jsonLd';

const meta = await loadPageMeta('records-and-timelines');

const [worldCup, euro, copaAmerica, nationsLeague, ballonDor, goldenBootWorldCup, goldenBootEuro] =
  await Promise.all([
    loadCompetition('fifa-world-cup', {
      editionsHeading: 'Editions',
      sourcesHeading: 'FIFA World Cup',
    }),
    loadCompetition('uefa-euro', {
      editionsHeading: 'Editions',
      sourcesHeading: 'UEFA EURO',
    }),
    loadCompetition('copa-america', {
      editionsHeading: 'Champions timeline',
      sourcesHeading: 'Copa América',
      allowDuplicateYears: ['1959'],
    }),
    loadCompetition('uefa-nations-league', {
      editionsHeading: 'Finals',
      sourcesHeading: 'UEFA Nations League',
    }),
    loadCompetition('ballon-dor', {
      editionsHeading: 'Winners',
      sourcesHeading: "Ballon d'Or",
    }),
    loadCompetition('golden-boot', {
      editionsHeading: 'FIFA World Cup top scorers',
      sourcesHeading: 'FIFA World Cup',
    }),
    loadCompetition('golden-boot', {
      editionsHeading: 'UEFA EURO top scorers',
      sourcesHeading: 'UEFA EURO',
    }),
  ]);

const competitions = [
  { key: 'world-cup', label: 'FIFA Svjetsko prvenstvo', href: withBase('/competitions/world-cup'), data: worldCup },
  { key: 'euro', label: 'UEFA Europsko prvenstvo', href: withBase('/competitions/euro'), data: euro },
  {
    key: 'copa-america',
    label: 'Copa América',
    href: withBase('/competitions/copa-america'),
    data: copaAmerica,
  },
  {
    key: 'nations-league',
    label: 'UEFA Liga nacija',
    href: withBase('/competitions/nations-league'),
    data: nationsLeague,
  },
];

// Ballon d'Or and Golden Boot recognize a player, not a national team, so they
// are listed separately from the four team competitions above, matching the
// English page.
const individualAwards = [
  {
    key: 'ballon-dor',
    label: 'Zlatna lopta',
    href: withBase('/competitions/ballon-dor'),
    data: ballonDor,
  },
  {
    key: 'golden-boot-world-cup',
    label: 'Zlatna kopačka (Svjetsko prvenstvo)',
    href: withBase('/competitions/golden-boot'),
    data: goldenBootWorldCup,
  },
  {
    key: 'golden-boot-euro',
    label: 'Zlatna kopačka (EURO)',
    href: withBase('/competitions/golden-boot'),
    data: goldenBootEuro,
  },
];

const allLoaded = [...competitions, ...individualAwards];
const sources = allLoaded
  .flatMap((c) => c.data.sources)
  .filter((source, index, all) => all.findIndex((s) => s.url === source.url) === index);

const lastReviewed = allLoaded
  .map((c) => c.data.lastReviewed)
  .sort()
  .at(-1) as string;

const statusText = meta.status === 'verified' ? 'Provjereno' : 'U pregledu';

// Croatian counterpart of src/pages/records.astro's jsonLd block - same
// generated data, own Croatian ItemList names, matching how every other
// translated competition page names its structured data (see
// hr/competitions/copa-america.astro).
const pageUrl = absolutePageUrl(Astro.url, Astro.site);
const jsonLd: JsonLdObject[] = [
  ...competitions.map((c) =>
    buildChampionsItemList(c.data.champions, { pageUrl, name: `${c.label} - najuspješnije reprezentacije` }),
  ),
  ...competitions.map((c) =>
    buildChampionsItemList(buildHostsSummary(c.data.editions), {
      pageUrl,
      name: `${c.label} - najčešći domaćini`,
      unit: ['put domaćin', 'puta domaćin'],
    }),
  ),
  ...competitions.flatMap((c) => {
    const homeSoil = buildHomeSoilTitles(c.data.editions);
    return homeSoil.length > 0
      ? [
          buildChampionsItemList(homeSoil, {
            pageUrl,
            name: `${c.label} - naslovi osvojeni na domaćem terenu`,
            unit: ['naslov na domaćem terenu', 'naslova na domaćem terenu'],
          }),
        ]
      : [];
  }),
  ...allLoaded.flatMap((c) => {
    const streaks = buildLongestStreaks(c.data.editions);
    return streaks.length > 0
      ? [
          buildChampionsItemList(streaks, {
            pageUrl,
            name: `${c.label} - uzastopni prvaci`,
            unit: ['uzastopno izdanje', 'uzastopna izdanja'],
          }),
        ]
      : [];
  }),
  ...competitions.flatMap((c) => {
    const nearlyChampions = buildRunnerUpsWithoutTitle(c.data.editions);
    return nearlyChampions.length > 0
      ? [
          buildChampionsItemList(nearlyChampions, {
            pageUrl,
            name: `${c.label} - vječiti drugoplasirani`,
            unit: ['finale bez naslova', 'finala bez naslova'],
          }),
        ]
      : [];
  }),
  ...allLoaded.flatMap((c) => {
    const gaps = buildLongestTitleGaps(c.data.editions);
    return gaps.length > 0
      ? [
          buildChampionsItemList(gaps, {
            pageUrl,
            name: `${c.label} - najduže čekanje na novi naslov`,
            unit: ['godina', 'godine'],
          }),
        ]
      : [];
  }),
  ...competitions.flatMap((c) => {
    const margins = buildBiggestFinalMargins(c.data.editions);
    return margins.length > 0
      ? [
          buildChampionsItemList(margins, {
            pageUrl,
            name: `${c.label} - najveće pobjede u finalu`,
            unit: ['gol', 'gola'],
          }),
        ]
      : [];
  }),
  ...individualAwards.map((a) =>
    buildChampionsItemList(a.data.champions, {
      pageUrl,
      name: `${a.label} - najviše nagrada`,
      unit: ['nagrada', 'nagrade'],
    }),
  ),
];
---

<BaseLayout
  title="Rekordi i vremenska crta"
  description="Vremenske crte prvaka, poredak najuspješnijih reprezentacija, najčešći domaćini, naslovi osvojeni na domaćem terenu, uzastopni prvaci, vječiti drugoplasirani, najduže čekanje na novi naslov i najveće pobjede u finalu generirani iz tablica Svjetskog prvenstva, EURA, Copa Américe i Lige nacija, uz vremensku crtu i poredak za Zlatnu loptu i Zlatnu kopačku, te objašnjenje kako se grupiraju povijesni nazivi država."
  locale="hr"
  alternateHref={withBase('/records')}
  jsonLd={jsonLd}
>
  <article class="records stack">
    <header class="records__header">
      <p class="eyebrow badge">Generirano iz tablica natjecanja</p>
      <h1>Rekordi i vremenska crta</h1>
      <p class="records__intro">
        Svaki prvak, domaćin i konačni rezultat na jednom mjestu, uz poredak
        najuspješnijih reprezentacija i pojedinačnih nagrada - sve generirano
        izravno iz podataka koje već koriste stranice pojedinih natjecanja.
      </p>
      <PrintDownloadLink
        slug="records-hr"
        label="Preuzmi PDF za ispis"
        hint="A4 položeno, svi poredci i vremenske crte s ove stranice."
      />
    </header>

    <section class="stack" aria-labelledby="timeline-heading">
      <h2 id="timeline-heading">Vremenska crta prvaka</h2>
      <p class="muted">
        Svaki prvak, domaćin i konačni rezultat, od najnovijeg prema
        najstarijem. Generirano izravno iz tablice izdanja svakog natjecanja -
        ništa ovdje nije ručno upisano.
      </p>
      {
        competitions.map((c) => (
          <ChampionsTimeline
            id={`timeline-${c.key}`}
            heading={c.label}
            entries={buildTimeline(c.data.editions)}
            hostedByLabel="Domaćin:"
            runnerUpLabel="Drugo mjesto:"
          />
        ))
      }
    </section>

    <section class="stack" aria-labelledby="teams-heading">
      <h2 id="teams-heading">Najuspješnije reprezentacije</h2>
      <p class="muted">
        Broj naslova poredan zasebno po natjecanju. Cijelu tablicu izdanje po
        izdanje pogledajte na stranici svakog natjecanja.
      </p>
      <div class="records__teams-grid">
        {
          competitions.map((c) => (
            <div>
              <ChampionsSummary
                id={`teams-${c.key}`}
                champions={c.data.champions}
                scaleMax={c.data.editions.length}
                heading={c.label}
                description={`Generirano iz ${c.data.editions.length} izdanja natjecanja ${c.label}.`}
                winningYearsLabel="Godine osvajanja: "
                ofLabel="od"
              />
              <a class="records__teams-link" href={c.href}>
                Pogledajte cijelu tablicu - {c.label} &rarr;
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <section class="stack" aria-labelledby="hosts-heading">
      <h2 id="hosts-heading">Najčešći domaćini</h2>
      <p class="muted">
        Koliko je puta svaka država bila domaćin, poredano zasebno po
        natjecanju. Za razliku od zbroja naslova iznad, ovdje se Zapadna
        Njemačka ne ubraja u Njemačku - domaćinstvo je činjenica o
        pojedinom izdanju, a ne pitanje sportskog nasljednika, pa se Zapadna
        Njemačka (SP 1974., EURO 1988.) i Njemačka (SP 2006., EURO 2024.)
        vode zasebno. Izdanje sa zajedničkim domaćinstvom (npr. "Belgija i
        Nizozemska") broji se kao jedan zajednički domaćin, isto kao što to
        već čini filtar domaćina na stranici svakog natjecanja.
      </p>
      <div class="records__teams-grid">
        {
          competitions.map((c) => (
            <div>
              <ChampionsSummary
                id={`hosts-${c.key}`}
                champions={buildHostsSummary(c.data.editions)}
                scaleMax={c.data.editions.length}
                heading={c.label}
                description={`Generirano iz ${c.data.editions.length} izdanja natjecanja ${c.label}.`}
                icon="🏟️"
                unit={['put domaćin', 'puta domaćin']}
                winningYearsLabel="Godine domaćinstva: "
                ofLabel="od"
              />
              <a class="records__teams-link" href={c.href}>
                Pogledajte cijelu tablicu - {c.label} &rarr;
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <section class="stack" aria-labelledby="home-soil-heading">
      <h2 id="home-soil-heading">Naslovi osvojeni na domaćem terenu</h2>
      <p class="muted">
        Izdanja u kojima je prvak ujedno i domaćin tog izdanja, poredana po
        broju - generirano uspoređivanjem stupaca "Pobjednik" i "Domaćin"
        svake tablice, ne ručno odabrano. Zajednički naziv domaćina kod
        izdanja sa zajedničkim domaćinstvom (npr. "Kanada, Meksiko i
        Sjedinjene Američke Države") broji se kao pogodak samo uz točno
        podudaranje, pa jedan od nekoliko zajedničkih domaćina koji na kraju
        osvoji naslov ovdje nije uračunat - naslov Španjolske na SP-u 2026.,
        čiji su domaćini bile tri druge države, upravo je takav stvaran
        primjer. Grupirano na isti način na koji "Najuspješnije
        reprezentacije" ubraja Zapadnu Njemačku u Njemačku.
      </p>
      <div class="records__teams-grid">
        {
          competitions.map((c) => {
            const homeSoil = buildHomeSoilTitles(c.data.editions);
            return (
              <div>
                {homeSoil.length > 0 ? (
                  <ChampionsSummary
                    id={`home-soil-${c.key}`}
                    champions={homeSoil}
                    scaleMax={Math.max(...homeSoil.map((s) => s.titles))}
                    heading={c.label}
                    description={`Generirano iz ${c.data.editions.length} izdanja natjecanja ${c.label}.`}
                    icon="🏠"
                    unit={['naslov na domaćem terenu', 'naslova na domaćem terenu']}
                    winningYearsLabel="Godine domaćeg naslova: "
                    ofLabel="od"
                  />
                ) : (
                  <>
                    <h2>{c.label}</h2>
                    <p class="muted">Nijedan domaćin još nije osvojio vlastito izdanje.</p>
                  </>
                )}
                <a class="records__teams-link" href={c.href}>
                  Pogledajte cijelu tablicu - {c.label} &rarr;
                </a>
              </div>
            );
          })
        }
      </div>
    </section>

    <section class="stack" aria-labelledby="streaks-heading">
      <h2 id="streaks-heading">Uzastopni prvaci</h2>
      <p class="muted">
        Svaki niz od dva ili više <em>uzastopnih izdanja</em> koje je osvojila
        ista reprezentacija, igrač ili skupina igrača s podijeljenom nagradom
        - generirano iz istih tablica kao i ostatak ove stranice, ne ručno
        odabrano. Godina bez rezultata (Zlatna lopta 2020.) prekida niz koji
        bi je premostio, a Zapadna Njemačka i Njemačka i ovdje se vode
        zasebno, isto kao u odjeljku "Najčešći domaćini" iznad.
      </p>
      <div class="records__teams-grid">
        {
          allLoaded.map((c) => {
            const streaks = buildLongestStreaks(c.data.editions);
            return (
              <div>
                {streaks.length > 0 ? (
                  <ChampionsSummary
                    id={`streaks-${c.key}`}
                    champions={streaks}
                    scaleMax={Math.max(...streaks.map((s) => s.titles))}
                    heading={c.label}
                    description={`Generirano iz ${c.data.editions.length} izdanja natjecanja ${c.label}.`}
                    icon="🔥"
                    unit={['uzastopno izdanje', 'uzastopna izdanja']}
                    winningYearsLabel="Godine niza: "
                    ofLabel="od"
                  />
                ) : (
                  <>
                    <h2>{c.label}</h2>
                    <p class="muted">Nitko još nije osvojio dva izdanja zaredom.</p>
                  </>
                )}
                <a class="records__teams-link" href={c.href}>
                  Pogledajte cijelu tablicu - {c.label} &rarr;
                </a>
              </div>
            );
          })
        }
      </div>
    </section>

    <section class="stack" aria-labelledby="nearly-champions-heading">
      <h2 id="nearly-champions-heading">Vječiti drugoplasirani</h2>
      <p class="muted">
        Reprezentacije koje su igrale finale - generirano iz stupca
        "Drugo mjesto" svake tablice - ali nikada nisu osvojile natjecanje,
        poredane po broju izgubljenih finala. Reprezentacija se briše s ovog
        popisa čim jednom osvoji naslov, pa se ranije izgubljeno finale ne
        "pripisuje" reprezentaciji koja je kasnije ipak osvojila trofej.
        Grupirano na isti način na koji "Najuspješnije reprezentacije" iznad
        ubraja Zapadnu Njemačku u Njemačku.
      </p>
      <div class="records__teams-grid">
        {
          competitions.map((c) => {
            const nearlyChampions = buildRunnerUpsWithoutTitle(c.data.editions);
            return (
              <div>
                {nearlyChampions.length > 0 ? (
                  <ChampionsSummary
                    id={`nearly-champions-${c.key}`}
                    champions={nearlyChampions}
                    scaleMax={Math.max(...nearlyChampions.map((s) => s.titles))}
                    heading={c.label}
                    description={`Generirano iz ${c.data.editions.length} izdanja natjecanja ${c.label}.`}
                    icon="🥈"
                    unit={['finale bez naslova', 'finala bez naslova']}
                    winningYearsLabel="Godine finala: "
                    ofLabel="od"
                  />
                ) : (
                  <>
                    <h2>{c.label}</h2>
                    <p class="muted">Svaki dosadašnji finalist na kraju je osvojio naslov.</p>
                  </>
                )}
                <a class="records__teams-link" href={c.href}>
                  Pogledajte cijelu tablicu - {c.label} &rarr;
                </a>
              </div>
            );
          })
        }
      </div>
    </section>

    <section class="stack" aria-labelledby="title-gaps-heading">
      <h2 id="title-gaps-heading">Najduže čekanje na novi naslov</h2>
      <p class="muted">
        Za svaku reprezentaciju, igrača ili skupinu igrača s podijeljenom
        nagradom koja ima barem dva naslova, najveći razmak u godinama između
        dvije pobjede - generirano iz istih godina osvajanja kao i
        "Najuspješnije reprezentacije" iznad, ne ručno odabrano. Suprotno
        pitanje od "Uzastopnih prvaka": taj odjeljak traži najkraći mogući
        razmak (sljedeće izdanje), a ovaj najduži razmak u karijeri
        pojedinog naslova. Grupirano na isti način na koji "Najuspješnije
        reprezentacije" ubraja Zapadnu Njemačku u Njemačku.
      </p>
      <div class="records__teams-grid">
        {
          allLoaded.map((c) => {
            const gaps = buildLongestTitleGaps(c.data.editions);
            return (
              <div>
                {gaps.length > 0 ? (
                  <ChampionsSummary
                    id={`title-gaps-${c.key}`}
                    champions={gaps}
                    scaleMax={Math.max(...gaps.map((g) => g.titles))}
                    heading={c.label}
                    description={`Generirano iz ${c.data.editions.length} izdanja natjecanja ${c.label}.`}
                    icon="⏳"
                    unit={['godina', 'godine']}
                    winningYearsLabel="Razmak: "
                    ofLabel="od"
                  />
                ) : (
                  <>
                    <h2>{c.label}</h2>
                    <p class="muted">Nitko to još nije osvojio dvaput.</p>
                  </>
                )}
                <a class="records__teams-link" href={c.href}>
                  Pogledajte cijelu tablicu - {c.label} &rarr;
                </a>
              </div>
            );
          })
        }
      </div>
    </section>

    <section class="stack" aria-labelledby="final-margins-heading">
      <h2 id="final-margins-heading">Najveće pobjede u finalu</h2>
      <p class="muted">
        Svako finale rangirano po razlici u pogocima, generirano izravno iz
        retka "Finale" svake tablice - jedanaesterci se igraju samo nakon
        neriješenog rezultata, pa finale odlučeno jedanaestercima ispravno
        završava na dnu popisa s razlikom 0, umjesto da se rezultat
        jedanaesteraca pogrešno računa kao razlika u pogocima. Tablica Copa
        Américe nema stupac s rezultatom finala, pa nije rangirana ovdje
        (detalje po utakmicama, gdje postoje, potražite na njezinoj
        stranici).
      </p>
      <div class="records__teams-grid">
        {
          competitions.map((c) => {
            const margins = buildBiggestFinalMargins(c.data.editions);
            return (
              <div>
                {margins.length > 0 ? (
                  <ChampionsSummary
                    id={`final-margins-${c.key}`}
                    champions={margins}
                    scaleMax={Math.max(...margins.map((m) => m.titles))}
                    heading={c.label}
                    description={`Generirano iz ${c.data.editions.length} izdanja natjecanja ${c.label}.`}
                    icon="⚽"
                    unit={['gol', 'gola']}
                    winningYearsLabel="Godina: "
                    ofLabel="od"
                  />
                ) : (
                  <>
                    <h2>{c.label}</h2>
                    <p class="muted">
                      Tablica ovog natjecanja nema stupac s rezultatom finala pa se ne može rangirati po razlici u pogocima.
                    </p>
                  </>
                )}
                <a class="records__teams-link" href={c.href}>
                  Pogledajte cijelu tablicu - {c.label} &rarr;
                </a>
              </div>
            );
          })
        }
      </div>
    </section>

    <section class="stack" aria-labelledby="award-timeline-heading">
      <h2 id="award-timeline-heading">Vremenska crta pojedinačnih nagrada</h2>
      <p class="muted">
        Zlatna lopta i Zlatna kopačka nagrađuju igrača, a ne reprezentaciju,
        pa su njihovi dobitnici ovdje prikazani zasebno od natjecanja
        reprezentacija iznad.
      </p>
      {
        individualAwards.map((a) => (
          <ChampionsTimeline
            id={`timeline-${a.key}`}
            heading={a.label}
            entries={buildTimeline(a.data.editions)}
            hostedByLabel="Domaćin:"
            runnerUpLabel="Drugo mjesto:"
          />
        ))
      }
    </section>

    <section class="stack" aria-labelledby="award-rankings-heading">
      <h2 id="award-rankings-heading">Najviše nagrada</h2>
      <p class="muted">
        Broj nagrada poredan zasebno po nagradi. Cijelu tablicu godina po
        godinu pogledajte na stranici svake nagrade.
      </p>
      <div class="records__teams-grid">
        {
          individualAwards.map((a) => (
            <div>
              <ChampionsSummary
                id={`awards-${a.key}`}
                champions={a.data.champions}
                scaleMax={a.data.editions.length}
                heading={a.label}
                description={`Generirano iz ${a.data.editions.length} izdanja nagrade ${a.label}.`}
                unit={['nagrada', 'nagrade']}
                winningYearsLabel="Godine osvajanja: "
                ofLabel="od"
              />
              <a class="records__teams-link" href={a.href}>
                Pogledajte cijelu tablicu - {a.label} &rarr;
              </a>
            </div>
          ))
        }
      </div>
    </section>

    <section class="card stack" aria-labelledby="identity-heading">
      <h2 id="identity-heading">Kako se postupa s povijesnim nazivima država</h2>
      <p>
        Tablice izdanja i vremenske crte prvaka iznad uvijek zadržavaju naziv
        pod kojim je reprezentacija nastupala u to vrijeme (npr. "Zapadna
        Njemačka", "Sovjetski Savez", "Čehoslovačka", "Jugoslavija") - povijest
        se nikada ne mijenja naknadno. Samo <strong>generirani zbroj naslova</strong>
        u odjeljku "Najuspješnije reprezentacije" primjenjuje mali, jasno
        određen skup pravila grupiranja:
      </p>
      <ul>
        <li>
          <strong>Zapadna Njemačka se u zbroju naslova ubraja u Njemačku</strong>,
          prikazano kao "Njemačka (uklj. Zapadnu Njemačku)" - jedini slučaj
          sportskog nasljednika koji sam izvorni sadržaj tako grupira.
        </li>
        <li>
          <strong>Sovjetski Savez i Rusija se ne spajaju.</strong> Vode se kao
          zasebni unosi sa zasebnim brojem naslova.
        </li>
        <li>
          <strong>Čehoslovačka i Češka Republika/Češka se ne spajaju</strong>
          bez izričitog uredničkog pravila; takvo pravilo danas ne postoji, pa
          se svaka broji zasebno.
        </li>
        <li>
          <strong>Rezultati Jugoslavije ostaju označeni kao Jugoslavija</strong>
          i ne pripisuju se nijednoj od njezinih država nasljednica.
        </li>
      </ul>
    </section>

    <References
      sources={sources}
      lastReviewed={lastReviewed}
      status={meta.status}
      heading="Izvori i provjera"
      statusPrefix="Status:"
      statusText={statusText}
      lastReviewedPrefix="Zadnja provjera:"
      dateLocale="hr-HR"
      noSourcesText="Za ovu stranicu još nisu navedene poveznice na izvore."
      noteText="Prednost imaju primarni izvori. Povijesni formati i nazivi reprezentacija bilježe se onako kako su korišteni u to vrijeme; kontekst potražite u napomenama uz svako izdanje."
    />
  </article>
</BaseLayout>

