---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuizCard from '../components/QuizCard.astro';
import QuizOrderCard from '../components/QuizOrderCard.astro';
import QuizScript from '../components/QuizScript.astro';
import References from '../components/References.astro';
import { loadCompetition, loadPageMeta } from '../lib/competition';
import { buildTimeline } from '../lib/editions';
import { t } from '../lib/i18n';
import { withBase } from '../lib/url';
import type { Edition } from '../lib/types';
import {
  championByYearQuestions,
  chronologicalOrderQuestions,
  hostByYearQuestions,
  runnerUpByYearQuestions,
  topScorerByYearQuestions,
  selectQuiz,
  type QuizPool,
} from '../lib/quiz';

const meta = await loadPageMeta('quiz');

const [worldCup, euro, copaAmerica, nationsLeague, ballonDor, goldenBootWorldCup, goldenBootEuro] =
  await Promise.all([
    loadCompetition('fifa-world-cup', {
      editionsHeading: 'Editions',
      sourcesHeading: 'FIFA World Cup',
    }),
    loadCompetition('uefa-euro', {
      editionsHeading: 'Editions',
      sourcesHeading: 'UEFA EURO',
    }),
    loadCompetition('copa-america', {
      editionsHeading: 'Champions timeline',
      sourcesHeading: 'Copa América',
      allowDuplicateYears: ['1959'],
    }),
    loadCompetition('uefa-nations-league', {
      editionsHeading: 'Finals',
      sourcesHeading: 'UEFA Nations League',
    }),
    loadCompetition('ballon-dor', {
      editionsHeading: 'Winners',
      sourcesHeading: "Ballon d'Or",
    }),
    loadCompetition('golden-boot', {
      editionsHeading: 'FIFA World Cup top scorers',
      sourcesHeading: 'FIFA World Cup',
    }),
    loadCompetition('golden-boot', {
      editionsHeading: 'UEFA EURO top scorers',
      sourcesHeading: 'UEFA EURO',
    }),
  ]);

// Each pool draws from one competition's real data; `take` caps how many of
// its generated questions make the final quiz, kept modest so the quiz stays
// a few minutes long rather than covering every edition ever played.
const pools: QuizPool[] = [
  {
    questions: championByYearQuestions(worldCup.editions, 'FIFA World Cup', 'world-cup'),
    take: 3,
    seed: 'pick:world-cup:champion',
  },
  {
    questions: hostByYearQuestions(worldCup.editions, 'FIFA World Cup', 'world-cup'),
    take: 2,
    seed: 'pick:world-cup:host',
  },
  {
    questions: runnerUpByYearQuestions(buildTimeline(worldCup.editions), 'FIFA World Cup', 'world-cup'),
    take: 1,
    seed: 'pick:world-cup:runner-up',
  },
  {
    questions: championByYearQuestions(euro.editions, 'UEFA EURO', 'euro'),
    take: 2,
    seed: 'pick:euro:champion',
  },
  {
    questions: hostByYearQuestions(euro.editions, 'UEFA EURO', 'euro'),
    take: 2,
    seed: 'pick:euro:host',
  },
  {
    questions: runnerUpByYearQuestions(buildTimeline(euro.editions), 'UEFA EURO', 'euro'),
    take: 1,
    seed: 'pick:euro:runner-up',
  },
  {
    questions: championByYearQuestions(copaAmerica.editions, 'Copa América', 'copa-america'),
    take: 2,
    seed: 'pick:copa-america:champion',
  },
  {
    questions: hostByYearQuestions(copaAmerica.editions, 'Copa América', 'copa-america'),
    take: 1,
    seed: 'pick:copa-america:host',
  },
  {
    questions: runnerUpByYearQuestions(buildTimeline(copaAmerica.editions), 'Copa América', 'copa-america'),
    take: 1,
    seed: 'pick:copa-america:runner-up',
  },
  {
    questions: championByYearQuestions(nationsLeague.editions, 'UEFA Nations League', 'nations-league'),
    take: 2,
    seed: 'pick:nations-league:champion',
  },
  {
    questions: hostByYearQuestions(nationsLeague.editions, 'UEFA Nations League', 'nations-league'),
    take: 2,
    seed: 'pick:nations-league:host',
  },
  {
    questions: championByYearQuestions(ballonDor.editions, "Ballon d'Or", 'ballon-dor'),
    take: 3,
    seed: "pick:ballon-dor:champion",
  },
  {
    questions: topScorerByYearQuestions(goldenBootWorldCup.editions, 'World Cup Golden Boot', 'golden-boot-world-cup'),
    take: 2,
    seed: 'pick:golden-boot-world-cup:scorer',
  },
  {
    questions: topScorerByYearQuestions(goldenBootEuro.editions, 'EURO Golden Boot', 'golden-boot-euro'),
    take: 2,
    seed: 'pick:golden-boot-euro:scorer',
  },
];

const questions = selectQuiz(pools, 'family-quiz:v1');

// "Put the champions in chronological order" - a ranking question rather
// than multiple choice, so it's generated and rendered separately from the
// pool above (see chronologicalOrderQuestions / QuizOrderCard.astro). Only
// the four team competitions with a host column are used: the host makes
// each sampled champion's display label unique even when the same country
// wins more than once, which an individual award (e.g. a repeat Ballon d'Or
// winner) can't guarantee.
const hostedByLabel = (edition: Edition) => `${edition.winner} (host: ${edition.host ?? '—'})`;
const orderQuestions = [
  ...chronologicalOrderQuestions(worldCup.editions, 'FIFA World Cup', 'world-cup', hostedByLabel),
  ...chronologicalOrderQuestions(euro.editions, 'UEFA EURO', 'euro', hostedByLabel),
  ...chronologicalOrderQuestions(copaAmerica.editions, 'Copa América', 'copa-america', hostedByLabel),
  ...chronologicalOrderQuestions(nationsLeague.editions, 'UEFA Nations League', 'nations-league', hostedByLabel),
];

const sources = [
  ...worldCup.sources,
  ...euro.sources,
  ...copaAmerica.sources,
  ...nationsLeague.sources,
  ...ballonDor.sources,
  ...goldenBootWorldCup.sources,
  ...goldenBootEuro.sources,
].filter((source, index, all) => all.findIndex((s) => s.url === source.url) === index);

const lastReviewed = [
  worldCup.lastReviewed,
  euro.lastReviewed,
  copaAmerica.lastReviewed,
  nationsLeague.lastReviewed,
  ballonDor.lastReviewed,
  goldenBootWorldCup.lastReviewed,
  meta.lastReviewed,
]
  .sort()
  .at(-1) as string;
---

<BaseLayout
  title={meta.title}
  description="A family football quiz generated from the World Cup, EURO, Copa América, Nations League, Ballon d'Or and Golden Boot tables - champions, hosts, finals and top scorers."
  alternateHref={withBase('/hr/quiz')}
>
  <article class="quiz stack">
    <header class="quiz__header">
      <p class="eyebrow badge">{t('en', 'quizEyebrow')}</p>
      <h1>{meta.title}</h1>
      <p class="quiz__intro">{meta.intro}</p>
    </header>

    <div class="quiz__score card no-print" id="quiz-score" hidden>
      <p>
        {t('en', 'quizScoreLabel')}
        <strong id="quiz-score-value">0</strong> / <span id="quiz-score-total">{questions.length}</span>
      </p>
      <button type="button" id="quiz-restart">{t('en', 'quizRestart')}</button>
    </div>

    <ol class="quiz__list">
      {
        questions.map((question, index) => (
          <li>
            <QuizCard question={question} index={index} />
          </li>
        ))
      }
    </ol>

    {
      orderQuestions.length > 0 && (
        <section class="quiz__order-section" aria-labelledby="quiz-order-heading">
          <h2 id="quiz-order-heading">{t('en', 'quizOrderHeading')}</h2>
          <p class="quiz__order-intro">{t('en', 'quizOrderIntro')}</p>
          <ol class="quiz__list">
            {orderQuestions.map((question, index) => (
              <li>
                <QuizOrderCard question={question} index={index} />
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <References sources={sources} lastReviewed={lastReviewed} status={meta.status} />
  </article>
</BaseLayout>

<style>
  .quiz__header {
    margin-bottom: 0.5rem;
  }

  .eyebrow {
    margin-bottom: 0.6rem;
  }

  .quiz__header h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }

  .quiz__intro {
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .quiz__score {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    flex-wrap: wrap;
    position: sticky;
    top: 3.6rem;
    z-index: 10;
  }

  .quiz__score p {
    margin: 0;
    font-weight: 600;
  }

  #quiz-restart {
    font: inherit;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    cursor: pointer;
  }

  #quiz-restart:hover {
    border-color: var(--accent);
  }

  .quiz__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }

  .quiz__order-section {
    margin-top: 1.5rem;
  }

  .quiz__order-section h2 {
    font-size: clamp(1.3rem, 4vw, 1.7rem);
    margin-bottom: 0.35rem;
  }

  .quiz__order-intro {
    max-width: 62ch;
    color: var(--text-muted);
    margin-top: 0;
    margin-bottom: 1rem;
  }
</style>

<QuizScript />
