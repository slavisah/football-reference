---
import BaseLayout from '../layouts/BaseLayout.astro';
import References from '../components/References.astro';
import PrintDownloadLink from '../components/PrintDownloadLink.astro';
import { loadPageMeta } from '../lib/competition';
import {
  buildAllCountryRecords,
  buildFinalsMeetings,
  finalsMeetingsBetween,
  tracksSemifinalColumn,
} from '../lib/compare';
import { loadTeamCompetitions } from '../lib/teamCompetitions';
import { teamProfileSlug } from '../lib/teamProfile';
import { absolutePageUrl, withBase } from '../lib/url';
import { buildCountryRecordsItemList, type JsonLdObject } from '../lib/jsonLd';

const meta = await loadPageMeta('compare-countries');

const { worldCup, euro, copaAmerica, nationsLeague, competitions } = await loadTeamCompetitions();

const tracksSemifinal = competitions.map((c) => tracksSemifinalColumn(c.editions));

const allRecords = buildAllCountryRecords(competitions);
const sortedByName = [...allRecords].sort((a, b) => a.displayName.localeCompare(b.displayName));

// Default head-to-head pair: the two most-titled teams, so the panel shows
// something meaningful before any JS runs or a URL param is read.
const [defaultA, defaultB] = allRecords;

// Every final actually played across these four competitions - the data set
// the "Finals meetings" panel below filters by the current picker pair.
const finalsMeetings = buildFinalsMeetings(competitions);
const defaultMeetings = finalsMeetingsBetween(defaultA.id, defaultB.id, finalsMeetings);

// The head-to-head panel is a "versus" table: one row per statistic, with
// Team A's value and Team B's value side by side on that same row (see
// docs/PROJECT_STATUS.md). `null` means this competition doesn't track the
// statistic at all, which is never a lead for either side.
function leaderOf(a: number | null, b: number | null): 'a' | 'b' | 'tie' {
  if (a === null || b === null) return 'tie';
  if (a > b) return 'a';
  if (b > a) return 'b';
  return 'tie';
}

function cellText(value: number | null): string {
  return value === null ? '—' : String(value);
}

const sources = [worldCup, euro, copaAmerica, nationsLeague]
  .flatMap((c) => c.sources)
  .filter((source, index, all) => all.findIndex((s) => s.url === source.url) === index);

const lastReviewed = [worldCup, euro, copaAmerica, nationsLeague]
  .map((c) => c.lastReviewed)
  .concat(meta.lastReviewed)
  .sort()
  .at(-1) as string;

const recordsForClient = allRecords.map((r) => ({
  id: r.id,
  displayName: r.displayName,
  totalTitles: r.totalTitles,
  totalRunnerUps: r.totalRunnerUps,
  totalSemifinals: r.totalSemifinals,
  totalFinals: r.totalFinals,
  competitions: r.competitions.map((c) => ({
    slug: c.slug,
    titles: c.titles,
    runnerUps: c.runnerUps,
    semifinals: c.semifinals,
  })),
}));

const finalsMeetingsForClient = finalsMeetings.map((m) => ({
  competition: m.competition,
  year: m.year,
  yearSort: m.yearSort,
  winnerId: m.winnerId,
  winnerName: m.winnerName,
  runnerUpId: m.runnerUpId,
  runnerUpName: m.runnerUpName,
  score: m.score ?? null,
}));

// One ItemList for the "All national teams" ranking below - the only
// ChampionSummary-shaped ranking this page has (the head-to-head panel is an
// interactive two-team picker, not a list, so it has no ItemList equivalent).
// See docs/PROJECT_STATUS.md for why /compare was the named next gap after
// /records gained the same structured data.
const jsonLd: JsonLdObject[] = [
  buildCountryRecordsItemList(allRecords, {
    pageUrl: absolutePageUrl(Astro.url, Astro.site),
    name: 'All national teams - combined World Cup, EURO, Copa América and Nations League record',
  }),
];
---

<BaseLayout
  title={meta.title}
  description="Compare two national teams' World Cup, EURO, Copa América and Nations League record - titles, runner-up and semifinal finishes."
  alternateHref={withBase('/hr/compare')}
  jsonLd={jsonLd}
>
  <article class="compare stack">
    <header class="compare__header">
      <p class="eyebrow badge">Generated from the competition tables</p>
      <h1>{meta.title}</h1>
      <p class="compare__intro">{meta.intro}</p>
      <PrintDownloadLink
        slug="compare"
        hint="A4 landscape, the default pair shown below plus the full team ranking."
      />
    </header>

    <section class="card stack" aria-labelledby="head-to-head-heading">
      <h2 id="head-to-head-heading">Head-to-head</h2>

      <div class="compare__picker no-print">
        <div class="compare__field">
          <label for="compare-a">Team A</label>
          <select id="compare-a" name="a">
            {
              sortedByName.map((r) => (
                <option value={r.id} selected={r.id === defaultA.id}>
                  {r.displayName}
                </option>
              ))
            }
          </select>
        </div>

        <button type="button" id="compare-swap" class="compare__swap" aria-label="Swap Team A and Team B">
          &#8646; Swap
        </button>

        <div class="compare__field">
          <label for="compare-b">Team B</label>
          <select id="compare-b" name="b">
            {
              sortedByName.map((r) => (
                <option value={r.id} selected={r.id === defaultB.id}>
                  {r.displayName}
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <p
        id="compare-status"
        class="visually-hidden"
        role="status"
        aria-live="polite"
        data-template="Comparing {a} vs {b}."
      >
        {`Comparing ${defaultA.displayName} vs ${defaultB.displayName}.`}
      </p>

      <div class="vs" id="compare-panel">
        <table class="vs__table">
          <caption
            class="visually-hidden"
            id="compare-caption"
            data-template="{a} compared with {b}, by competition"
          >
            {`${defaultA.displayName} compared with ${defaultB.displayName}, by competition`}
          </caption>
          <thead>
            <tr>
              <th scope="col" class="vs__team" id="compare-a-name">{defaultA.displayName}</th>
              <th scope="col" class="vs__stat-head">Statistic</th>
              <th scope="col" class="vs__team" id="compare-b-name">{defaultB.displayName}</th>
            </tr>
          </thead>
          {
            competitions.map((competition, index) => {
              const a = defaultA.competitions[index];
              const b = defaultB.competitions[index];
              const tracks = tracksSemifinal[index];
              const metrics = [
                { field: 'titles', label: 'Titles', a: a.titles, b: b.titles },
                { field: 'runnerUps', label: 'Runner-up', a: a.runnerUps, b: b.runnerUps },
                {
                  field: 'semifinals',
                  label: 'Semifinal / 4th',
                  a: tracks ? a.semifinals : null,
                  b: tracks ? b.semifinals : null,
                },
                {
                  field: 'finals',
                  label: 'Finals reached',
                  a: a.titles + a.runnerUps,
                  b: b.titles + b.runnerUps,
                },
              ];
              // A pair with nothing at all in this competition (every South
              // American team on the EURO, say) collapses to one line instead
              // of four rows of zeros - on a phone those rows are most of the
              // panel's height and none of its information.
              const empty = metrics.every((m) => (m.a ?? 0) === 0 && (m.b ?? 0) === 0);
              return (
                <tbody data-slug={a.slug} data-tracks-semifinal={tracks} data-empty={String(empty)}>
                  <tr class="vs__group">
                    <th colspan="3" scope="colgroup">
                      {competition.title}
                    </th>
                  </tr>
                  <tr class="vs__none">
                    <td colspan="3">Neither team has a record here.</td>
                  </tr>
                  {metrics.map((metric) => (
                    <tr data-metric={metric.field} data-leader={leaderOf(metric.a, metric.b)}>
                      <td class="vs__value" data-side="a">{cellText(metric.a)}</td>
                      <th scope="row" class="vs__stat">{metric.label}</th>
                      <td class="vs__value" data-side="b">{cellText(metric.b)}</td>
                    </tr>
                  ))}
                </tbody>
              );
            })
          }
          <tbody data-slug="combined" class="vs__combined">
            <tr class="vs__group">
              <th colspan="3" scope="colgroup">Combined</th>
            </tr>
            {
              [
                {
                  field: 'titles',
                  label: 'Titles',
                  a: defaultA.totalTitles,
                  b: defaultB.totalTitles,
                },
                {
                  field: 'runnerUps',
                  label: 'Runner-up',
                  a: defaultA.totalRunnerUps,
                  b: defaultB.totalRunnerUps,
                },
                {
                  field: 'semifinals',
                  label: 'Semifinal / 4th',
                  a: defaultA.totalSemifinals,
                  b: defaultB.totalSemifinals,
                },
                {
                  field: 'finals',
                  label: 'Finals reached',
                  a: defaultA.totalFinals,
                  b: defaultB.totalFinals,
                },
              ].map((metric) => (
                <tr data-metric={metric.field} data-leader={leaderOf(metric.a, metric.b)}>
                  <td class="vs__value" data-side="a">{cellText(metric.a)}</td>
                  <th scope="row" class="vs__stat">{metric.label}</th>
                  <td class="vs__value" data-side="b">{cellText(metric.b)}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <p class="muted compare__note">
        "Semifinal / 4th" counts third/fourth-place or "other semifinalist"
        finishes, where that competition's table tracks one, shown as "—"
        when it doesn't. Copa América only has third/fourth data for its
        knockout-final era (1987, 1993 onward) - earlier editions had no
        standalone third-place match, so a semifinal finish before 1987
        isn't counted here. Individual awards (Ballon d'Or, Golden Boot)
        aren't included: they recognize players, not national teams.
      </p>
    </section>

    <section class="card stack" aria-labelledby="finals-meetings-heading">
      <h2 id="finals-meetings-heading">Finals meetings</h2>
      <p class="muted" id="finals-meetings-intro">
        Every time <span id="finals-meetings-a-name">{defaultA.displayName}</span> and{' '}
        <span id="finals-meetings-b-name">{defaultB.displayName}</span> have met in a World Cup, EURO,
        Copa América or Nations League final, oldest first.
      </p>
      <div
        id="finals-meetings-body"
        data-empty-text="These two haven't met in a final across these four competitions."
      >
        {
          defaultMeetings.length === 0 ? (
            <p class="muted" id="finals-meetings-empty">
              These two haven't met in a final across these four competitions.
            </p>
          ) : (
            <ol class="finals-meetings__list" id="finals-meetings-list">
              {defaultMeetings.map((m) => (
                <li>
                  <span class="finals-meetings__year">{m.year}</span>
                  <span class="finals-meetings__competition">{m.competition}</span>
                  <strong>{m.winnerName}</strong> beat {m.runnerUpName}
                  {m.score ? <span class="finals-meetings__score">{m.score}</span> : null}
                </li>
              ))}
            </ol>
          )
        }
      </div>
    </section>

    <section class="stack" aria-labelledby="all-teams-heading">
      <h2 id="all-teams-heading">All national teams</h2>
      <p class="muted">
        Every team that has won, been runner-up, or reached a tracked
        semifinal in at least one of these four competitions, ranked by
        titles. Pick any two above to compare them directly, or select a name
        below for its full year-by-year record on{' '}
        <a href={withBase('/teams')}>the Teams page</a>.
      </p>
      <div
        class="t-wrap"
        tabindex="0"
        role="region"
        aria-label="All national teams' combined record, ranked by titles"
      >
        <table class="compare__table compare__table--all">
          <caption class="visually-hidden">All national teams' combined record, ranked by titles</caption>
          <thead>
            <tr>
              <th scope="col">Rank</th>
              <th scope="col">Team</th>
              <th scope="col">Titles</th>
              <th scope="col">Runner-up</th>
              <th scope="col">Semifinal / 4th</th>
              <th scope="col">Finals reached</th>
            </tr>
          </thead>
          <tbody>
            {
              allRecords.map((r, i) => (
                <tr>
                  <td>{i + 1}</td>
                  <th scope="row">
                    <a href={withBase(`/teams/${teamProfileSlug(r.id)}`)}>{r.displayName}</a>
                  </th>
                  <td>{r.totalTitles}</td>
                  <td>{r.totalRunnerUps}</td>
                  <td>{r.totalSemifinals}</td>
                  <td>{r.totalFinals}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    <References sources={sources} lastReviewed={lastReviewed} status={meta.status} />
  </article>
</BaseLayout>

<style>
  .compare__header {
    margin-bottom: 0.5rem;
  }

  .eyebrow {
    margin-bottom: 0.6rem;
  }

  .compare__header h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }

  .compare__intro {
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .compare__picker {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem 1rem;
    padding: 1rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .compare__field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 12rem;
    flex: 1 1 12rem;
  }

  .compare__field label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .compare__field select {
    font: inherit;
    padding: 0.5rem 0.6rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    width: 100%;
  }

  .compare__swap {
    font: inherit;
    padding: 0.55rem 0.9rem;
    color: var(--text);
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
    white-space: nowrap;
  }

  .compare__swap:hover {
    border-color: var(--accent);
  }

  /* "Versus" comparison table: one row per statistic, Team A's value on the
     left, Team B's on the right, the metric label between them. Transposed
     from the two separate per-team tables this panel used to render, which
     put the two numbers a reader wants to compare on different screens at
     360px - each table was wider than the viewport and they stacked
     vertically. Three narrow columns fit any phone with no horizontal
     scroll, so no .t-wrap wrapper is needed here (the "All national teams"
     ranking below still has one - it genuinely has six columns). */
  .vs {
    container-type: inline-size;
  }

  .vs__table {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    table-layout: fixed;
  }

  .vs__table thead th {
    position: sticky;
    /* Sits directly under the sticky site header, whose real height varies
       by viewport and locale - Nav.astro measures it into this property. */
    top: var(--site-header-height, 3.5rem);
    z-index: 1;
    padding: 0.7rem 0.5rem;
    background: var(--bg-subtle);
    border-bottom: 1px solid var(--border);
    text-align: center;
  }

  .vs__team {
    width: 34%;
    font-size: 1rem;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .vs__stat-head {
    width: 32%;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .vs__group th {
    padding: 0.55rem 0.7rem;
    background: var(--bg-subtle);
    border-block: 1px solid var(--border);
    text-align: left;
    font-size: 0.8rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .vs__table tbody tr:not(.vs__group) th,
  .vs__table tbody tr:not(.vs__group) td {
    padding: 0.6rem 0.4rem;
    border-bottom: 1px solid var(--border);
  }

  .vs__stat {
    text-align: center;
    font-weight: 500;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .vs__value {
    text-align: center;
    font-size: 1.35rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* The leading side. Weight, colour and a marker together, never colour
     alone - the same rule global.css documents for the winner cell in
     TournamentTable. */
  .vs__table tr[data-leader='a'] .vs__value[data-side='a'],
  .vs__table tr[data-leader='b'] .vs__value[data-side='b'] {
    color: var(--accent);
    font-weight: 800;
  }

  .vs__table tr[data-leader='a'] .vs__value[data-side='a']::after,
  .vs__table tr[data-leader='b'] .vs__value[data-side='b']::after {
    content: '';
    display: inline-block;
    width: 0;
    height: 0;
    margin-inline-start: 0.35rem;
    vertical-align: 0.15em;
    border-inline: 0.3rem solid transparent;
    border-bottom: 0.42rem solid currentColor;
  }

  @media (forced-colors: active) {
    .vs__table tr[data-leader='a'] .vs__value[data-side='a'],
    .vs__table tr[data-leader='b'] .vs__value[data-side='b'] {
      outline: 1px solid CanvasText;
      outline-offset: -3px;
    }
  }

  /* Collapsed group: the four metric rows give way to one "nothing here"
     line. Rows are hidden with CSS rather than removed so the client script
     only has to flip one attribute when the pair changes. */
  .vs__none {
    display: none;
  }

  .vs__table tbody[data-empty='true'] tr[data-metric] {
    display: none;
  }

  .vs__table tbody[data-empty='true'] .vs__none {
    display: table-row;
  }

  .vs__none td {
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .vs__combined tr:not(.vs__group) td,
  .vs__combined tr:not(.vs__group) th {
    font-size: 1.05rem;
  }

  .vs__combined .vs__value {
    font-size: 1.5rem;
  }

  .vs__table tbody:last-child tr:last-child th,
  .vs__table tbody:last-child tr:last-child td {
    border-bottom: none;
  }

  /* Room for longer metric labels once the panel is wide enough. */
  @container (min-width: 34rem) {
    .vs__team {
      font-size: 1.15rem;
    }

    .vs__stat {
      font-size: 0.95rem;
    }

    .vs__table tbody tr:not(.vs__group) th,
    .vs__table tbody tr:not(.vs__group) td {
      padding: 0.7rem 1rem;
    }
  }

  .t-wrap {
    overflow-x: auto;
    border-radius: var(--radius);
  }

  .compare__table {
    width: 100%;
    min-width: 28rem;
    border-collapse: collapse;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .compare__table--all {
    min-width: 34rem;
  }

  .compare__table th,
  .compare__table td {
    padding: 0.55rem 0.7rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    white-space: nowrap;
  }

  .compare__table thead th {
    background: var(--bg-subtle);
    font-size: 0.85rem;
  }

  .compare__table tfoot th,
  .compare__table tfoot td {
    font-weight: 700;
    border-top: 2px solid var(--border);
    border-bottom: none;
  }

  .compare__table tbody tr:last-child th,
  .compare__table tbody tr:last-child td {
    border-bottom: none;
  }

  .compare__note {
    font-size: 0.85rem;
    max-width: 68ch;
  }

  .finals-meetings__list {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .finals-meetings__list li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.6rem 0.8rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .finals-meetings__year {
    font-weight: 700;
    min-width: 3.2rem;
  }

  .finals-meetings__competition {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .finals-meetings__score {
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .finals-meetings__score::before {
    content: '(';
  }

  .finals-meetings__score::after {
    content: ')';
  }
</style>

<script is:inline define:vars={{ records: recordsForClient, finalsMeetings: finalsMeetingsForClient }}>
  const selectA = document.getElementById('compare-a');
  const selectB = document.getElementById('compare-b');
  const swapBtn = document.getElementById('compare-swap');
  const status = document.getElementById('compare-status');
  const statusTemplate = status?.dataset.template ?? '{a} vs {b}';
  const byId = new Map(records.map((r) => [r.id, r]));
  const finalsMeetingsBody = document.getElementById('finals-meetings-body');
  const finalsMeetingsEmptyText = finalsMeetingsBody?.dataset.emptyText ?? '';

  // Fills the versus table: every row carries data-slug (its competition, or
  // "combined") and data-metric, so one pass over the rows can set both
  // sides' values and re-derive which side leads. Replaces the old
  // fill-one-side-at-a-time pass, which had a table per team.
  const panel = document.getElementById('compare-panel');
  const caption = document.getElementById('compare-caption');
  const captionTemplate = caption?.dataset.template ?? '';

  function metricsOf(record) {
    const bySlug = { combined: {
      titles: record.totalTitles,
      runnerUps: record.totalRunnerUps,
      semifinals: record.totalSemifinals,
      finals: record.totalFinals,
    } };
    for (const comp of record.competitions) {
      bySlug[comp.slug] = {
        titles: comp.titles,
        runnerUps: comp.runnerUps,
        semifinals: comp.semifinals,
        finals: comp.titles + comp.runnerUps,
      };
    }
    return bySlug;
  }

  function fillVersus(a, b) {
    const nameA = document.getElementById('compare-a-name');
    const nameB = document.getElementById('compare-b-name');
    if (nameA) nameA.textContent = a.displayName;
    if (nameB) nameB.textContent = b.displayName;
    if (caption && captionTemplate) {
      caption.textContent = captionTemplate
        .replace('{a}', a.displayName)
        .replace('{b}', b.displayName);
    }
    if (!panel) return;

    const aMetrics = metricsOf(a);
    const bMetrics = metricsOf(b);

    for (const group of panel.querySelectorAll('tbody[data-slug]')) {
      const slug = group.dataset.slug;
      // A competition that doesn't track a semifinal/third-place column
      // shows "—" on both sides, and neither side leads.
      const tracksSemifinal = group.dataset.tracksSemifinal !== 'false';
      let allZero = true;
      for (const row of group.querySelectorAll('tr[data-metric]')) {
        const metric = row.dataset.metric;
        const untracked = metric === 'semifinals' && !tracksSemifinal;
        const aValue = untracked ? null : aMetrics[slug]?.[metric] ?? null;
        const bValue = untracked ? null : bMetrics[slug]?.[metric] ?? null;
        const cellA = row.querySelector('.vs__value[data-side="a"]');
        const cellB = row.querySelector('.vs__value[data-side="b"]');
        if (cellA) cellA.textContent = aValue === null ? '—' : String(aValue);
        if (cellB) cellB.textContent = bValue === null ? '—' : String(bValue);
        let leader = 'tie';
        if (aValue !== null && bValue !== null) {
          if (aValue > bValue) leader = 'a';
          else if (bValue > aValue) leader = 'b';
        }
        row.dataset.leader = leader;
        if ((aValue ?? 0) !== 0 || (bValue ?? 0) !== 0) allZero = false;
      }
      // "Combined" always shows its numbers, even when both are zero: it is
      // the panel's summary line, not one competition among several.
      group.dataset.empty = slug !== 'combined' && allZero ? 'true' : 'false';
    }
  }

  function escapeHtml(value) {
    return String(value)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');
  }

  function renderFinalsMeetings(a, b) {
    if (!finalsMeetingsBody) return;

    const aName = document.getElementById('finals-meetings-a-name');
    const bName = document.getElementById('finals-meetings-b-name');
    if (aName) aName.textContent = a.displayName;
    if (bName) bName.textContent = b.displayName;

    const meetings = finalsMeetings
      .filter(
        (m) =>
          (m.winnerId === a.id && m.runnerUpId === b.id) || (m.winnerId === b.id && m.runnerUpId === a.id),
      )
      .sort((x, y) => x.yearSort - y.yearSort);

    if (meetings.length === 0) {
      finalsMeetingsBody.innerHTML = `<p class="muted" id="finals-meetings-empty">${escapeHtml(finalsMeetingsEmptyText)}</p>`;
      return;
    }

    const items = meetings
      .map((m) => {
        const score = m.score
          ? `<span class="finals-meetings__score">${escapeHtml(m.score)}</span>`
          : '';
        return `<li><span class="finals-meetings__year">${escapeHtml(m.year)}</span><span class="finals-meetings__competition">${escapeHtml(m.competition)}</span><strong>${escapeHtml(m.winnerName)}</strong> beat ${escapeHtml(m.runnerUpName)}${score}</li>`;
      })
      .join('');
    finalsMeetingsBody.innerHTML = `<ol class="finals-meetings__list" id="finals-meetings-list">${items}</ol>`;
  }

  function readParams() {
    const p = new URLSearchParams(window.location.search);
    return { a: p.get('a') || '', b: p.get('b') || '' };
  }

  function writeParams(a, b) {
    const p = new URLSearchParams(window.location.search);
    a ? p.set('a', a) : p.delete('a');
    b ? p.set('b', b) : p.delete('b');
    const qs = p.toString();
    const url = window.location.pathname + (qs ? `?${qs}` : '') + window.location.hash;
    window.history.replaceState({}, '', url);
  }

  function render() {
    const a = byId.get(selectA.value);
    const b = byId.get(selectB.value);
    if (a && b) {
      fillVersus(a, b);
      renderFinalsMeetings(a, b);
    }
    if (status && a && b) {
      status.textContent = statusTemplate
        .replace('{a}', a.displayName)
        .replace('{b}', b.displayName);
    }
    writeParams(selectA.value, selectB.value);
  }

  // Restore a shared link's selection, if both ids are known.
  const initial = readParams();
  if (initial.a && byId.has(initial.a)) selectA.value = initial.a;
  if (initial.b && byId.has(initial.b)) selectB.value = initial.b;

  selectA.addEventListener('change', render);
  selectB.addEventListener('change', render);
  swapBtn?.addEventListener('click', () => {
    const a = selectA.value;
    selectA.value = selectB.value;
    selectB.value = a;
    render();
  });

  render();
</script>
