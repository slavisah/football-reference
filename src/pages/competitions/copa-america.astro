---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompetitionView from '../../components/CompetitionView.astro';
import { loadCompetition } from '../../lib/competition';
import { buildPodiums, buildHostMapPoints } from '../../lib/editions';
import { buildEditionLinks, buildEditionProfiles } from '../../lib/editionProfile';
import { COPA_AMERICA_HOST_COORDINATES, COPA_AMERICA_REGION_ORDER } from '../../lib/hostCoordinates';
import { absolutePageUrl, withBase } from '../../lib/url';
import {
  buildChampionsItemList,
  buildCollectionPageJsonLd,
  buildLatestEditionSportsEvent,
  type JsonLdObject,
} from '../../lib/jsonLd';

const data = await loadCompetition('copa-america', {
  editionsHeading: 'Champions timeline',
  sourcesHeading: 'Copa América',
  allowDuplicateYears: ['1959'],
  noteHeadings: [
    'How it works',
    'Best Player winners',
    'Golden Glove winners',
    'Golden Boot winners',
    'Winning managers',
    'Memorable moments',
  ],
});

const podium = buildPodiums(data.editions);
const hostMap = buildHostMapPoints(data.editions, COPA_AMERICA_HOST_COORDINATES, COPA_AMERICA_REGION_ORDER);
const yearLinks = buildEditionLinks(buildEditionProfiles(data.editions), '/competitions/copa-america');

const pageUrl = absolutePageUrl(Astro.url, Astro.site);
const championsName = `${data.title} - Champions by titles`;
const jsonLd = [
  buildCollectionPageJsonLd(buildChampionsItemList(data.champions, { pageUrl, name: championsName }), {
    pageUrl,
    name: championsName,
  }),
  buildLatestEditionSportsEvent(data.editions, data.title),
].filter((item): item is JsonLdObject => item !== undefined);
---

<BaseLayout
  title={data.title}
  description="Every Copa América champion since 1916, hosts and runners-up, with a generated title count. Filter by winner, year, host and team."
  alternateHref={withBase('/hr/competitions/copa-america')}
  jsonLd={jsonLd}
>
  <CompetitionView
    data={data}
    tableId="copa-america"
    tableCaption="Copa América champions, 1916 to present"
    pdfSlug="copa-america"
    podium={podium}
    podiumHeading="Podium by edition"
    hostMap={hostMap}
    yearLinks={yearLinks}
  />
</BaseLayout>
