---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompetitionView from '../../components/CompetitionView.astro';
import { loadCompetition } from '../../lib/competition';
import { withBase } from '../../lib/url';

const data = await loadCompetition('copa-america', {
  editionsHeading: 'Champions timeline',
  sourcesHeading: 'Copa América',
  allowDuplicateYears: ['1959'],
  noteHeadings: ['Memorable moments'],
});
---

<BaseLayout
  title={data.title}
  description="Every Copa América champion since 1916, hosts and runners-up, with a generated title count. Filter by winner, year and host."
  alternateHref={withBase('/hr/competitions/copa-america')}
>
  <CompetitionView
    data={data}
    tableId="copa-america"
    tableCaption="Copa América champions, 1916 to present"
    pdfSlug="copa-america"
  />
</BaseLayout>
