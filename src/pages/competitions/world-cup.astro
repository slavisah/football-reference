---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompetitionView from '../../components/CompetitionView.astro';
import { loadCompetition } from '../../lib/competition';
import { buildTopScorerFacts, buildPodiums, buildHostMapPoints } from '../../lib/editions';
import { buildEditionLinks, buildEditionProfiles } from '../../lib/editionProfile';
import { WORLD_CUP_HOST_COORDINATES, HOST_REGION_ORDER } from '../../lib/hostCoordinates';
import { absolutePageUrl, withBase } from '../../lib/url';
import {
  buildChampionsItemList,
  buildCollectionPageJsonLd,
  buildLatestEditionSportsEvent,
  type JsonLdObject,
} from '../../lib/jsonLd';

const [data, goldenBoot] = await Promise.all([
  loadCompetition('fifa-world-cup', {
    editionsHeading: 'Editions',
    sourcesHeading: 'FIFA World Cup',
    noteHeadings: [
      'How it works',
      'Format milestones',
      'Golden Ball winners',
      'Silver Ball and Bronze Ball winners',
      'Golden Glove winners',
      'Young Player Award winners',
      'Memorable moments',
      'Editorial notes',
    ],
  }),
  loadCompetition('golden-boot', {
    editionsHeading: 'FIFA World Cup top scorers',
    sourcesHeading: 'FIFA World Cup',
  }),
]);

const topScorers = buildTopScorerFacts(goldenBoot.editions);
const podium = buildPodiums(data.editions);
const hostMap = buildHostMapPoints(data.editions, WORLD_CUP_HOST_COORDINATES, HOST_REGION_ORDER);
const yearLinks = buildEditionLinks(buildEditionProfiles(data.editions), '/competitions/world-cup');

const pageUrl = absolutePageUrl(Astro.url, Astro.site);
const championsName = `${data.title} - Champions by titles`;
const jsonLd = [
  buildCollectionPageJsonLd(buildChampionsItemList(data.champions, { pageUrl, name: championsName }), {
    pageUrl,
    name: championsName,
  }),
  buildLatestEditionSportsEvent(data.editions, data.title),
].filter((item): item is JsonLdObject => item !== undefined);
---

<BaseLayout
  title={data.title}
  description="Every FIFA World Cup edition, hosts, finalists and champions, with a generated title count. Filter by winner, year, host and team."
  alternateHref={withBase('/hr/competitions/world-cup')}
  jsonLd={jsonLd}
>
  <CompetitionView
    data={data}
    tableId="world-cup"
    tableCaption="FIFA World Cup editions, 1930 onward"
    extraColumn={{ label: 'Top scorer', values: topScorers }}
    pdfSlug="world-cup"
    podium={podium}
    podiumHeading="Podium by edition"
    hostMap={hostMap}
    yearLinks={yearLinks}
  />
</BaseLayout>
