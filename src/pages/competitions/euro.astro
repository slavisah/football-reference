---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompetitionView from '../../components/CompetitionView.astro';
import { loadCompetition } from '../../lib/competition';
import { buildTopScorerFacts } from '../../lib/editions';

const [data, goldenBoot] = await Promise.all([
  loadCompetition('uefa-euro', {
    editionsHeading: 'Editions',
    sourcesHeading: 'UEFA EURO',
    noteHeadings: ['Historical format note', 'Memorable moments'],
  }),
  loadCompetition('golden-boot', {
    editionsHeading: 'UEFA EURO top scorers',
    sourcesHeading: 'UEFA EURO',
  }),
]);

const topScorers = buildTopScorerFacts(goldenBoot.editions);
---

<BaseLayout
  title={data.title}
  description="Every UEFA European Championship edition, hosts, finalists and champions, with a generated title count. Filter by winner, year and host."
>
  <CompetitionView
    data={data}
    tableId="euro"
    tableCaption="UEFA European Championship editions, 1960 onward"
    extraColumn={{ label: 'Top scorer', values: topScorers }}
  />
</BaseLayout>
