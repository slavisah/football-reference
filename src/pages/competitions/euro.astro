---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompetitionView from '../../components/CompetitionView.astro';
import { loadCompetition } from '../../lib/competition';
import { buildTopScorerFacts, buildHostMapPoints } from '../../lib/editions';
import { buildEditionLinks, buildEditionProfiles } from '../../lib/editionProfile';
import { EURO_HOST_COORDINATES } from '../../lib/hostCoordinates';
import { absolutePageUrl, withBase } from '../../lib/url';
import {
  buildChampionsItemList,
  buildCollectionPageJsonLd,
  buildLatestEditionSportsEvent,
  type JsonLdObject,
} from '../../lib/jsonLd';

const [data, goldenBoot] = await Promise.all([
  loadCompetition('uefa-euro', {
    editionsHeading: 'Editions',
    sourcesHeading: 'UEFA EURO',
    noteHeadings: [
      'How it works',
      'Historical format note',
      'Player of the Tournament winners',
      'Young Player of the Tournament winners',
      'Team of the Tournament winners',
      'Winning managers',
      'Winning captains',
      'Memorable moments',
    ],
  }),
  loadCompetition('golden-boot', {
    editionsHeading: 'UEFA EURO top scorers',
    sourcesHeading: 'UEFA EURO',
  }),
]);

const topScorers = buildTopScorerFacts(goldenBoot.editions);
const hostMap = buildHostMapPoints(data.editions, EURO_HOST_COORDINATES);
const yearLinks = buildEditionLinks(buildEditionProfiles(data.editions), '/competitions/euro');

const pageUrl = absolutePageUrl(Astro.url, Astro.site);
const championsName = `${data.title} - Champions by titles`;
const jsonLd = [
  buildCollectionPageJsonLd(buildChampionsItemList(data.champions, { pageUrl, name: championsName }), {
    pageUrl,
    name: championsName,
  }),
  buildLatestEditionSportsEvent(data.editions, data.title),
].filter((item): item is JsonLdObject => item !== undefined);
---

<BaseLayout
  title={data.title}
  description="Every UEFA European Championship edition, hosts, finalists and champions, with a generated title count. Filter by winner, year, host and team."
  alternateHref={withBase('/hr/competitions/euro')}
  jsonLd={jsonLd}
>
  <CompetitionView
    data={data}
    tableId="euro"
    tableCaption="UEFA European Championship editions, 1960 onward"
    extraColumn={{ label: 'Top scorer', values: topScorers }}
    pdfSlug="euro"
    hostMap={hostMap}
    yearLinks={yearLinks}
  />
</BaseLayout>
