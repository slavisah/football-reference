---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TournamentTable from '../../components/TournamentTable.astro';
import ChampionsSummary from '../../components/ChampionsSummary.astro';
import EditorialNotes from '../../components/EditorialNotes.astro';
import References from '../../components/References.astro';
import PrintDownloadLink from '../../components/PrintDownloadLink.astro';
import { loadCompetition } from '../../lib/competition';
import { buildYearStories } from '../../lib/editions';
import { buildEditionLinks, buildEditionProfiles } from '../../lib/editionProfile';
import { absolutePageUrl, withBase } from '../../lib/url';
import {
  buildChampionsItemList,
  buildCollectionPageJsonLd,
  buildLatestEditionSportsEvent,
  type JsonLdObject,
} from '../../lib/jsonLd';

const [worldCup, euro] = await Promise.all([
  loadCompetition('golden-boot', {
    editionsHeading: 'FIFA World Cup top scorers',
    sourcesHeading: 'FIFA World Cup',
    noteHeadings: [
      'How it works',
      'World Cup notes',
      'World Cup Silver Boot and Bronze Boot winners',
      'World Cup memorable moments',
    ],
  }),
  loadCompetition('golden-boot', {
    editionsHeading: 'UEFA EURO top scorers',
    sourcesHeading: 'UEFA EURO',
    noteHeadings: [
      'EURO notes',
      'EURO Silver Boot and Bronze Boot winners',
      'EURO memorable moments',
    ],
  }),
]);

// "Tap a year to reveal a short story", same convention CompetitionView
// applies for every other competition - built by hand here since this page
// composes its own layout (two tables, not the shared CompetitionView) the
// same way it already hand-builds worldCupYearLinks/euroYearLinks below.
const worldCupStories = buildYearStories(
  worldCup.editions,
  worldCup.notes.find((section) => section.heading === 'World Cup memorable moments')?.items ?? [],
);
const euroStories = buildYearStories(
  euro.editions,
  euro.notes.find((section) => section.heading === 'EURO memorable moments')?.items ?? [],
);

// Each table gets its own edition-page route tree (golden-boot/world-cup vs
// golden-boot/euro - see docs/PROJECT_STATUS.md), so each needs its own
// `yearLinks` map keyed against its own editions, unlike every other
// competition page here that only has one table to link.
const worldCupYearLinks = buildEditionLinks(
  buildEditionProfiles(worldCup.editions),
  '/competitions/golden-boot/world-cup',
);
const euroYearLinks = buildEditionLinks(
  buildEditionProfiles(euro.editions),
  '/competitions/golden-boot/euro',
);

// Both loads read the same content file, so title/intro/status/review date are
// identical; the source links differ because each table cites its own section
// of docs/SOURCES.md.
const sources = [...worldCup.sources, ...euro.sources].filter(
  (source, index, all) => all.findIndex((s) => s.url === source.url) === index,
);

// Two separate ItemLists, matching how ChampionsSummary itself is duplicated
// below - one Golden Boot ranking per competition, not a merged one. Same
// story for the SportsEvent blocks: `worldCup.title`/`euro.title` are both
// the generic content-frontmatter "Golden Boot Winners" (one shared source
// file), which can't stand in for a single per-award name the way
// `data.title` does on the other five index pages, so each call gets an
// explicit name here instead - the same "FIFA World Cup Golden Boot"/"UEFA
// EURO Golden Boot" convention the per-edition pages already established
// (see src/pages/competitions/golden-boot/{world-cup,euro}/[year].astro).
const pageUrl = absolutePageUrl(Astro.url, Astro.site);
const jsonLd = [
  buildCollectionPageJsonLd(
    [
      buildChampionsItemList(worldCup.champions, {
        pageUrl,
        name: 'Most World Cup Golden Boots',
        unit: ['award', 'awards'],
      }),
      buildChampionsItemList(euro.champions, {
        pageUrl,
        name: 'Most EURO top-scorer awards',
        unit: ['award', 'awards'],
      }),
    ],
    { pageUrl, name: worldCup.title },
  ),
  buildLatestEditionSportsEvent(worldCup.editions, 'FIFA World Cup Golden Boot'),
  buildLatestEditionSportsEvent(euro.editions, 'UEFA EURO Golden Boot'),
].filter((item): item is JsonLdObject => item !== undefined);
---

<BaseLayout
  title={worldCup.title}
  description="FIFA World Cup and UEFA EURO top-scorer awards, with player, team and goals. Filter each table by player, year and team."
  alternateHref={withBase('/hr/competitions/golden-boot')}
  jsonLd={jsonLd}
>
  <article class="competition stack">
    <header class="competition__header">
      <p class="eyebrow badge">
        {worldCup.status === 'verified' ? 'Verified' : 'In review'}
      </p>
      <h1>{worldCup.title}</h1>
      <p class="competition__intro">{worldCup.intro}</p>
      <PrintDownloadLink slug="golden-boot" />
    </header>

    <section class="stack">
      <h2>FIFA World Cup top scorers</h2>
      <TournamentTable
        id="golden-boot-world-cup"
        paramPrefix="world-cup"
        caption="FIFA World Cup top scorers, 1930 to present"
        table={worldCup.table}
        editions={worldCup.editions}
        winners={worldCup.winners}
        hosts={worldCup.hosts}
        teams={worldCup.teams}
        winnerLabel="Player"
        storyColumn={worldCupStories.size > 0 ? { label: 'Story', values: worldCupStories } : undefined}
        yearLinks={worldCupYearLinks}
      />
      <ChampionsSummary
        id="golden-boot-world-cup-champions"
        champions={worldCup.champions}
        scaleMax={worldCup.editions.length}
        heading="Most World Cup Golden Boots"
        description="Generated automatically from the table above. Tied top scorers are counted as the joint entry shown in the table, exactly as the source lists them."
        unit={['award', 'awards']}
      />
    </section>

    <section class="stack">
      <h2>UEFA EURO top scorers</h2>
      <TournamentTable
        id="golden-boot-euro"
        paramPrefix="euro"
        caption="UEFA EURO top scorers, 1960 to present"
        table={euro.table}
        editions={euro.editions}
        winners={euro.winners}
        hosts={euro.hosts}
        teams={euro.teams}
        winnerLabel="Player"
        storyColumn={euroStories.size > 0 ? { label: 'Story', values: euroStories } : undefined}
        yearLinks={euroYearLinks}
      />
      <ChampionsSummary
        id="golden-boot-euro-champions"
        champions={euro.champions}
        scaleMax={euro.editions.length}
        heading="Most EURO top-scorer awards"
        description="Generated automatically from the table above. Tied top scorers are counted as the joint entry shown in the table, exactly as the source lists them."
        unit={['award', 'awards']}
      />
    </section>

    <EditorialNotes sections={[...worldCup.notes, ...euro.notes]} />

    <References
      sources={sources}
      lastReviewed={worldCup.lastReviewed}
      status={worldCup.status}
    />
  </article>
  <p class="golden-boot__players-link no-print">
    <a href={withBase('/players')}>Browse every player's full award history &rarr;</a>
  </p>
</BaseLayout>

<style>
  .competition__header {
    margin-bottom: 0.5rem;
  }

  .eyebrow {
    margin-bottom: 0.6rem;
  }

  .competition__header h1 {
    font-size: clamp(1.8rem, 5vw, 2.6rem);
  }

  .competition__intro {
    max-width: 62ch;
    color: var(--text-muted);
    font-size: 1.05rem;
  }

  .golden-boot__players-link {
    font-weight: 600;
  }
</style>
