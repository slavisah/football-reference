---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompetitionView from '../../components/CompetitionView.astro';
import { loadCompetition } from '../../lib/competition';
import { buildEditionLinks, buildEditionProfiles } from '../../lib/editionProfile';
import { absolutePageUrl, withBase } from '../../lib/url';
import { buildChampionsItemList, buildLatestEditionSportsEvent, type JsonLdObject } from '../../lib/jsonLd';

const data = await loadCompetition('ballon-dor', {
  editionsHeading: 'Winners',
  sourcesHeading: "Ballon d'Or",
  noteHeadings: ['How it works', 'Memorable moments', 'Notes'],
});

const yearLinks = buildEditionLinks(buildEditionProfiles(data.editions), '/competitions/ballon-dor');

// Unlike the four team competitions, an individual award has no host - the
// shared builder already omits `location` when none is given, so the same
// call the World Cup/EURO/Nations League/Copa América index pages use works
// here unchanged. `data.title` ("Men's Ballon d'Or") is unambiguous for this
// page, unlike golden-boot.astro's two same-titled loads below.
const pageUrl = absolutePageUrl(Astro.url, Astro.site);
const jsonLd = [
  buildChampionsItemList(data.champions, { pageUrl, name: `${data.title} - Most awards` }),
  buildLatestEditionSportsEvent(data.editions, data.title),
].filter((item): item is JsonLdObject => item !== undefined);
---

<BaseLayout
  title={data.title}
  description="Every Men's Ballon d'Or winner since 1956, with national team and a generated award count. Filter by winner, year and national team."
  alternateHref={withBase('/hr/competitions/ballon-dor')}
  jsonLd={jsonLd}
>
  <CompetitionView
    data={data}
    tableId="ballon-dor"
    tableCaption="Men's Ballon d'Or winners, 1956 to present"
    pdfSlug="ballon-dor"
    yearLinks={yearLinks}
  />
  <p class="ballon-dor__players-link no-print">
    <a href={withBase('/players')}>Browse every player's full award history &rarr;</a>
  </p>
</BaseLayout>

<style>
  .ballon-dor__players-link {
    font-weight: 600;
  }
</style>
