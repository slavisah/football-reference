---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompetitionView from '../../components/CompetitionView.astro';
import { loadCompetition } from '../../lib/competition';
import { buildPodiums, buildHostMapPoints } from '../../lib/editions';
import { buildEditionLinks, buildEditionProfiles } from '../../lib/editionProfile';
import { NATIONS_LEAGUE_HOST_COORDINATES } from '../../lib/hostCoordinates';
import { absolutePageUrl, withBase } from '../../lib/url';
import {
  buildChampionsItemList,
  buildLatestEditionSportsEvent,
  type JsonLdObject,
} from '../../lib/jsonLd';

const data = await loadCompetition('uefa-nations-league', {
  editionsHeading: 'Finals',
  sourcesHeading: 'UEFA Nations League',
  noteHeadings: ['How it works', 'Key facts', 'Memorable moments'],
});

const podium = buildPodiums(data.editions);
const hostMap = buildHostMapPoints(data.editions, NATIONS_LEAGUE_HOST_COORDINATES);
const yearLinks = buildEditionLinks(buildEditionProfiles(data.editions), '/competitions/nations-league');

const pageUrl = absolutePageUrl(Astro.url, Astro.site);
const jsonLd = [
  buildChampionsItemList(data.champions, { pageUrl, name: `${data.title} - Champions by titles` }),
  buildLatestEditionSportsEvent(data.editions, data.title),
].filter((item): item is JsonLdObject => item !== undefined);
---

<BaseLayout
  title={data.title}
  description="Every UEFA Nations League Finals edition, hosts, finalists and champions, with a generated title count. Filter by winner, season, host and team."
  alternateHref={withBase('/hr/competitions/nations-league')}
  jsonLd={jsonLd}
>
  <CompetitionView
    data={data}
    tableId="nations-league"
    tableCaption="UEFA Nations League Finals, 2018-19 onward"
    pdfSlug="nations-league"
    podium={podium}
    podiumHeading="Podium by edition"
    hostMap={hostMap}
    yearLinks={yearLinks}
  />
</BaseLayout>
