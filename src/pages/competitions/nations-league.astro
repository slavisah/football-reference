---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CompetitionView from '../../components/CompetitionView.astro';
import { loadCompetition } from '../../lib/competition';
import { withBase } from '../../lib/url';

const data = await loadCompetition('uefa-nations-league', {
  editionsHeading: 'Finals',
  sourcesHeading: 'UEFA Nations League',
  noteHeadings: ['Key facts'],
});
---

<BaseLayout
  title={data.title}
  description="Every UEFA Nations League Finals edition, hosts, finalists and champions, with a generated title count. Filter by winner, season and host."
  alternateHref={withBase('/hr/competitions/nations-league')}
>
  <CompetitionView
    data={data}
    tableId="nations-league"
    tableCaption="UEFA Nations League Finals, 2018-19 onward"
    pdfSlug="nations-league"
  />
</BaseLayout>
