---
import BaseLayout from '../layouts/BaseLayout.astro';
import OnThisDay from '../components/OnThisDay.astro';
import { withBase } from '../lib/url';
import { getEntry } from 'astro:content';
import { loadHomeCompetitions, buildHomeCards } from '../lib/homeCards';
import { buildOnThisDayEntries } from '../lib/onThisDay';

const home = await getEntry('pages', 'index');

// Pull a live champion count from each competition so the home cards stay in
// sync with the editorial tables instead of hard-coding numbers. Shared with
// the Croatian home page (src/pages/hr/index.astro) so both always agree on
// the numbers; only the surrounding prose differs per locale.
const competitions = await loadHomeCompetitions();
const cards = buildHomeCards('en', competitions);

// "On this day" widget: built from the World Cup and EURO editions already
// loaded above (both have a "Final date" column) - no extra data load. The
// other four competitions don't have that column yet; see
// docs/PROJECT_STATUS.md for the plan to extend this.
const onThisDayEntries = [
  ...buildOnThisDayEntries(competitions.worldCup.editions, 'FIFA World Cup'),
  ...buildOnThisDayEntries(competitions.euro.editions, 'UEFA European Championship'),
];
---

<BaseLayout
  title={home?.data.title ?? 'The Ultimate Football Reference'}
  description={home?.data.description}
  alternateHref={withBase('/hr/')}
>
  <section class="hero stack">
    <p class="badge">Family-friendly football history</p>
    <h1>The Ultimate Football Reference</h1>
    <p class="hero__lede">
      Tournaments, champions, hosts and finalists - compared in one calm,
      ad-free place. Built from Markdown, with historical team names preserved
      and every page linked to its sources.
    </p>
    <p class="hero__actions">
      <a class="btn btn--primary" href={withBase('/competitions/world-cup')}>
        Explore the World Cup
      </a>
      <a class="btn" href={withBase('/competitions/euro')}>Explore the EURO</a>
    </p>
  </section>

  <section class="cards" aria-label="Competitions">
    {
      cards.map((card) => (
        <a
          class="comp-card"
          href={card.href}
          style={`--card-accent:${card.accent};--card-accent-text-light:${card.accentTextLight};--card-accent-text-dark:${card.accentTextDark}`}
        >
          <span class="comp-card__bar" aria-hidden="true" />
          <h2><span aria-hidden="true">{card.icon}</span> {card.title}</h2>
          <p class="comp-card__blurb">{card.blurb}</p>
          <dl class="comp-card__stats">
            <div>
              <dt>Editions</dt>
              <dd>{card.editions}</dd>
            </div>
            {card.topChampion && (
              <div>
                <dt>{card.statLabel ?? 'Most titles'}</dt>
                <dd>
                  {card.topChampion.displayName} ({card.topChampion.titles})
                </dd>
              </div>
            )}
          </dl>
          <span class="comp-card__go">Open table &rarr;</span>
        </a>
      ))
    }
  </section>

  <OnThisDay entries={onThisDayEntries} />

  <section class="features card">
    <h2>What each competition page gives you</h2>
    <ul class="feature-list">
      <li><span aria-hidden="true">📱</span> A responsive edition-by-edition table that never overflows on a phone.</li>
      <li><span aria-hidden="true">🔎</span> Filter by winner and year, with a shareable link for any view.</li>
      <li><span aria-hidden="true">🏆</span> A champions summary generated straight from the table.</li>
      <li><span aria-hidden="true">📚</span> Source links and a visible "last reviewed" date.</li>
      <li><span aria-hidden="true">🖨️</span> Clean print output on A4 landscape, plus light and dark themes.</li>
    </ul>
    <p class="muted">
      Want champions timelines and title rankings across every competition on
      one page? See <a href={withBase('/records')}>Records and Timelines</a>.
    </p>
    <p class="muted">
      <a href={withBase('/compare')}>Compare two national teams</a> head-to-head
      - titles, runner-up and semifinal finishes across all four competitions.
    </p>
    <p class="muted">
      Or test what you know with the <a href={withBase('/quiz')}>Family Quiz</a>,
      generated from these same tables.
    </p>
  </section>
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(1rem, 4vw, 2.5rem) 0.5rem;
  }

  .hero h1 {
    font-size: clamp(2rem, 7vw, 3.4rem);
    max-width: 16ch;
  }

  .hero__lede {
    max-width: 60ch;
    font-size: 1.1rem;
    color: var(--text-muted);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .btn {
    display: inline-block;
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    background: var(--bg-elevated);
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
  }

  .btn:hover {
    border-color: var(--accent);
  }

  .btn--primary {
    background: var(--accent);
    color: var(--accent-contrast);
    border-color: var(--accent);
  }

  .cards {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    margin-block: 2rem;
  }

  .comp-card {
    position: relative;
    display: block;
    padding: 1.3rem;
    padding-top: 1.6rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.12s ease, border-color 0.12s ease;
  }

  .comp-card:hover {
    transform: translateY(-2px);
    border-color: var(--card-accent, var(--accent));
  }

  .comp-card__bar {
    position: absolute;
    inset: 0 0 auto 0;
    height: 4px;
    background: var(--card-accent, var(--accent));
  }

  .comp-card h2 {
    font-size: 1.3rem;
    margin-bottom: 0.35rem;
  }

  .comp-card__blurb {
    color: var(--text-muted);
    margin-top: 0;
  }

  .comp-card__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1.5rem;
    margin: 0.9rem 0;
  }

  .comp-card__stats dt {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-muted);
  }

  .comp-card__stats dd {
    margin: 0;
    font-weight: 700;
  }

  .comp-card__go {
    font-weight: 600;
    /* Each card's per-theme text variant, tuned for AA contrast against
       that theme's --bg-elevated (see homeCards.ts). */
    color: var(--card-accent-text-light, var(--card-accent, var(--accent)));
  }

  @media (prefers-color-scheme: dark) {
    /* :not([data-theme='light']) so an explicit manual "light" override
       (independent of the OS setting) isn't clobbered by this rule. */
    :root:not([data-theme='light']) .comp-card__go {
      color: var(--card-accent-text-dark, var(--card-accent, var(--accent)));
    }
  }

  :root[data-theme='dark'] .comp-card__go {
    color: var(--card-accent-text-dark, var(--card-accent, var(--accent)));
  }

  .feature-list {
    margin: 0.5rem 0 1rem;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
  }

  .feature-list li {
    max-width: 62ch;
  }
</style>
