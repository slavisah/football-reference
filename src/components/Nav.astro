---
import { withBase } from '../lib/url';
import { NAV_LINKS } from '../lib/routes';
import { t, TRANSLATED_PATHS, type Locale } from '../lib/i18n';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** Defaults to 'en'; only pages with a translation pass this. */
  locale?: Locale;
  /** The equivalent page in the other language, if one exists. Omit to hide the switcher. */
  alternateHref?: string;
}

const { locale = 'en', alternateHref } = Astro.props;

// Every NAV_LINKS path has a Croatian translation (TRANSLATED_PATHS), so on
// a Croatian page the nav itself - not just the language switcher - should
// stay in Croatian: same page, translated path and label, so a reader
// browsing /hr/... never gets silently bounced back to the English site by
// clicking a nav item other than the explicit language switch.
//
// At >=60rem the nav lays out as a single wrapping row (see the desktop
// media query in the <style> below) rather than the mobile drawer, and
// fifteen links plus both search widgets, the theme toggle and (on
// translated pages) the language switch don't fit on one line even at the
// container's own max-width - it wraps onto a second row instead. The six
// competition/award pages are the site's primary content (the same six
// cards the home page itself leads with), so they - plus Home - stay
// directly visible; the rest collapse into a "More" menu at that
// breakpoint. Below 60rem this grouping never applies - the mobile drawer
// still shows every link flat, exactly as before.
const SECONDARY_NAV_PATHS = new Set([
  '/records',
  '/compare',
  '/teams',
  '/players',
  '/compare-players',
  '/quiz',
  '/glossary',
  '/about/sources',
]);
const links = NAV_LINKS.map((link) => ({
  href: withBase(locale === 'hr' ? (TRANSLATED_PATHS[link.path] ?? link.path) : link.path),
  label: locale === 'hr' ? link.labelHr : link.label,
  secondary: SECONDARY_NAV_PATHS.has(link.path),
}));
const primaryLinks = links.filter((link) => !link.secondary);
const secondaryLinks = links.filter((link) => link.secondary);
const homeHref = withBase(locale === 'hr' ? TRANSLATED_PATHS['/'] : '/');
// Where the "find a team" search widget below sends a selected team - the
// same /compare?a=<id> shareable param the page's own head-to-head picker
// already reads (src/pages/compare.astro), just reached from anywhere on
// the site instead of only from /compare's own two <select> dropdowns.
const compareHref = withBase(locale === 'hr' ? TRANSLATED_PATHS['/compare'] : '/compare');
// Same idea, one level down: the "find a player" widget sends a selected
// player to /compare-players?a=<id>, the shareable param
// src/pages/compare-players.astro's own two <select> pickers already
// read/write. /player-index.json.ts already existed (built for
// scripts/generate-pdfs.mjs to enumerate /players/<slug> PDF targets) but
// was, until this widget, not read by any client-side code - see that
// file's own doc comment.
const playerCompareHref = withBase(
  locale === 'hr' ? TRANSLATED_PATHS['/compare-players'] : '/compare-players',
);

const here = Astro.url.pathname.replace(/\/$/, '');
function isCurrent(href: string): boolean {
  return href.replace(/\/$/, '') === here;
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={homeHref}>
      <span class="brand__mark" aria-hidden="true">⚽</span>
      <span class="brand__text">{t(locale, 'brand')}</span>
    </a>

    <button
      id="menu-toggle"
      class="menu-toggle no-print"
      type="button"
      aria-expanded="false"
      aria-controls="site-menu"
      aria-label={t(locale, 'menuOpenLabel')}
      data-label-open={t(locale, 'menuOpenLabel')}
      data-label-close={t(locale, 'menuCloseLabel')}
      hidden
    >
      <span class="menu-toggle__bars" aria-hidden="true"></span>
      <span class="menu-toggle__text">{t(locale, 'menuLabel')}</span>
    </button>

    <div id="site-menu" class="site-menu">
    <nav aria-label={t(locale, 'primaryNav')} class="site-menu__nav">
      <ul class="nav-list" id="nav-list">
        {
          primaryLinks.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
        <li class="nav-more-item">
          <button
            id="nav-more-toggle"
            class="nav-more-toggle"
            type="button"
            aria-haspopup="true"
            aria-expanded="false"
            aria-controls="nav-more-menu"
            hidden
          >
            {t(locale, 'navMoreLabel')}
            <span class="nav-more-toggle__caret" aria-hidden="true"></span>
          </button>
          <ul id="nav-more-menu" class="nav-more-menu" hidden></ul>
        </li>
        {
          secondaryLinks.map((link) => (
            <li data-nav-tier="secondary">
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="team-search no-print">
      <label for="team-search-input" class="visually-hidden">{t(locale, 'teamSearchLabel')}</label>
      <div class="team-search__field">
        <svg class="team-search__icon" aria-hidden="true" viewBox="0 0 20 20" width="15" height="15">
          <circle cx="8.3" cy="8.3" r="6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <line x1="13" y1="13" x2="18" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
          ></line>
        </svg>
        <input
          id="team-search-input"
          class="team-search__input"
          type="text"
          role="combobox"
          aria-expanded="false"
          aria-controls="team-search-listbox"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
          placeholder={t(locale, 'teamSearchPlaceholder')}
          data-endpoint={withBase('/team-index.json')}
          data-target={compareHref}
          data-no-results-template={t(locale, 'teamSearchNoResults')}
          data-loading-label={t(locale, 'teamSearchLoading')}
          data-error-label={t(locale, 'teamSearchError')}
        />
      </div>
      <ul
        id="team-search-listbox"
        class="team-search__listbox"
        role="listbox"
        aria-label={t(locale, 'teamSearchLabel')}
        hidden
      >
      </ul>
      <p id="team-search-status" class="visually-hidden" role="status" aria-live="polite"></p>
    </div>

    <div class="team-search no-print">
      <label for="player-search-input" class="visually-hidden">{t(locale, 'playerSearchLabel')}</label>
      <div class="team-search__field">
        <svg class="team-search__icon" aria-hidden="true" viewBox="0 0 20 20" width="15" height="15">
          <circle cx="8.3" cy="8.3" r="6" fill="none" stroke="currentColor" stroke-width="1.6"></circle>
          <line x1="13" y1="13" x2="18" y2="18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
          ></line>
        </svg>
        <input
          id="player-search-input"
          class="team-search__input"
          type="text"
          role="combobox"
          aria-expanded="false"
          aria-controls="player-search-listbox"
          aria-autocomplete="list"
          autocomplete="off"
          spellcheck="false"
          placeholder={t(locale, 'playerSearchPlaceholder')}
          data-endpoint={withBase('/player-index.json')}
          data-target={playerCompareHref}
          data-no-results-template={t(locale, 'playerSearchNoResults')}
          data-loading-label={t(locale, 'playerSearchLoading')}
          data-error-label={t(locale, 'playerSearchError')}
        />
      </div>
      <ul
        id="player-search-listbox"
        class="team-search__listbox"
        role="listbox"
        aria-label={t(locale, 'playerSearchLabel')}
        hidden
      >
      </ul>
      <p id="player-search-status" class="visually-hidden" role="status" aria-live="polite"></p>
    </div>

    {
      alternateHref && (
        <a
          class="lang-switch"
          href={alternateHref}
          hreflang={locale === 'en' ? 'hr' : 'en'}
          rel="alternate"
        >
          {t(locale, 'switchLanguageTo')}
        </a>
      )
    }

    <ThemeToggle locale={locale} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  /* Mobile first: the header row is brand + menu button only, and
     everything else (nav links, both search widgets, the language switch
     and the theme toggle) lives in the #site-menu drawer below it. The
     drawer is only collapsed once the inline script at the bottom of this
     file marks the header as script-driven (.site-header--js), so a
     no-JS reader still gets the old always-visible header rather than an
     inert button and no navigation at all. */
  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 0.5rem 1rem;
    flex-wrap: wrap;
    padding-block: 0.5rem;
  }

  .site-menu {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem 0.75rem;
  }

  .site-header--js .site-menu {
    display: none;
  }

  .site-header--js .site-menu.is-open {
    /* Anchored to the header rather than in its flow, so the sticky header
       itself stays one row tall - the --site-header-height custom property
       other sticky elements read (see the script below) keeps meaning
       "the bar at the top", not "the bar plus an open drawer". */
    position: absolute;
    inset-inline: 0;
    top: 100%;
    z-index: 21;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 0.75rem;
    max-height: calc(100dvh - var(--site-header-height, 3.5rem));
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 0.85rem clamp(0.85rem, 4vw, 2rem) 1.25rem;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-subtle);
    color: var(--text);
    font: inherit;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
  }

  .menu-toggle[hidden] {
    display: none;
  }

  .menu-toggle:hover {
    border-color: var(--accent);
  }

  .menu-toggle__bars,
  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    display: block;
    width: 1.05rem;
    height: 2px;
    border-radius: 2px;
    background: currentColor;
  }

  .menu-toggle__bars {
    position: relative;
  }

  .menu-toggle__bars::before,
  .menu-toggle__bars::after {
    content: '';
    position: absolute;
    inset-inline-start: 0;
  }

  .menu-toggle__bars::before {
    top: -6px;
  }

  .menu-toggle__bars::after {
    top: 6px;
  }

  /* The open state turns the three bars into a cross - a non-colour cue
     that survives forced-colors, alongside aria-expanded for assistive
     technology. */
  .menu-toggle[aria-expanded='true'] .menu-toggle__bars {
    background: transparent;
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-toggle__bars::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--text);
    margin-right: auto;
  }

  .brand__mark {
    font-size: 1.25rem;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* Inside the open drawer the same list becomes two columns of full-width,
     thumb-sized rows instead of a wrapping inline row. */
  .site-menu.is-open .nav-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.35rem;
  }

  .site-menu.is-open .nav-list a {
    display: flex;
    align-items: center;
    min-height: 2.75rem;
    padding-inline: 0.75rem;
    background: var(--bg-subtle);
    font-size: 1rem;
  }

  .site-menu.is-open .nav-list a[aria-current='page'] {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 18%, transparent);
  }

  .nav-list a {
    display: inline-block;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .nav-list a:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }

  .nav-list a[aria-current='page'] {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  /* Collapsed below 60rem regardless of JS - the mobile drawer already
     shows every link flat via .nav-list above, this menu only exists for
     the wide single-row layout. Hidden via `display: none` here (not the
     `hidden` attribute) since the *button* is what carries `hidden` in
     markup - see the no-JS note on .nav-more-toggle[hidden] below. */
  .nav-more-item {
    display: none;
  }

  .nav-more-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.7rem;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--text-muted);
    font: inherit;
    font-weight: 600;
    font-size: 0.95rem;
    cursor: pointer;
  }

  /* Ships hidden in markup - only the script that wires up open/close
     reveals it, the same no-JS-safe pattern .menu-toggle uses above. This
     rule has to exist outside any media query so it always wins regardless
     of the desktop display value set below. */
  .nav-more-toggle[hidden] {
    display: none;
  }

  .nav-more-toggle:hover,
  .nav-more-toggle[aria-expanded='true'] {
    color: var(--text);
    background: var(--bg-subtle);
  }

  .nav-more-toggle__caret {
    width: 0;
    height: 0;
    border-inline: 4px solid transparent;
    border-block-start: 5px solid currentColor;
  }

  .nav-more-menu {
    position: absolute;
    inset-block-start: calc(100% + 0.3rem);
    inset-inline-start: 0;
    z-index: 5;
    display: flex;
    flex-direction: column;
    min-width: 11rem;
    margin: 0;
    padding: 0.3rem;
    list-style: none;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
  }

  .nav-more-menu[hidden] {
    display: none;
  }

  .nav-more-menu a {
    display: block;
    padding: 0.5rem 0.6rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .nav-more-menu a:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }

  .nav-more-menu a[aria-current='page'] {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  /* Same "background/color alone loses its signal under forced-colors"
     concern the team-search listbox's own active-option rule addresses
     above. */
  @media (forced-colors: active) {
    .nav-more-toggle[aria-expanded='true'] {
      outline: 1px solid CanvasText;
      outline-offset: -2px;
    }

    .nav-more-menu a[aria-current='page'] {
      outline: 1px solid CanvasText;
      outline-offset: -1px;
    }
  }

  /* Shared by both the "find a team" and "find a player" widgets above -
     the class name predates the player widget (added later, reusing this
     structural/visual styling as-is; nothing here is team-specific). */
  .team-search {
    position: relative;
  }

  .team-search__field {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding-inline: 0.55rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg-subtle);
  }

  .team-search__field:focus-within {
    border-color: var(--accent);
    outline: 3px solid var(--focus);
    outline-offset: 2px;
  }

  .team-search__icon {
    flex: none;
    color: var(--text-muted);
  }

  .team-search__input {
    width: 9rem;
    max-width: 100%;
    padding-block: 0.4rem;
    border: 0;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.85rem;
  }

  .team-search__input:focus-visible {
    outline: none;
  }

  .team-search__input::placeholder {
    color: var(--text-muted);
  }

  .team-search__listbox {
    position: absolute;
    inset-block-start: calc(100% + 0.3rem);
    inset-inline-start: 0;
    z-index: 5;
    width: max(100%, 14rem);
    max-width: min(20rem, 90vw);
    max-height: 16rem;
    overflow-y: auto;
    margin: 0;
    padding: 0.3rem;
    list-style: none;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
  }

  .team-search__listbox[hidden] {
    display: none;
  }

  .team-search__listbox li {
    padding: 0.45rem 0.6rem;
    border-radius: var(--radius);
    font-size: 0.9rem;
    cursor: pointer;
  }

  .team-search__listbox li.is-active {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
    color: var(--accent);
  }

  /* Same "background/color alone loses its signal under forced-colors"
     concern global.css's own top-of-file comment documents for
     TournamentTable's .is-winner cell - the active option needs a
     non-color signal too. */
  @media (forced-colors: active) {
    .team-search__listbox li.is-active {
      outline: 1px solid CanvasText;
      outline-offset: -1px;
    }
  }

  .lang-switch {
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .lang-switch:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }

  .site-menu.is-open .team-search__input {
    width: 100%;
  }

  .site-menu.is-open .team-search__field,
  .site-menu.is-open .lang-switch {
    min-height: 2.75rem;
  }

  .site-menu.is-open .lang-switch {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* :global because the button belongs to ThemeToggle.astro's own scope -
     only its placement inside this drawer is Nav's business. */
  .site-menu.is-open :global(#theme-toggle) {
    justify-content: center;
    min-height: 2.75rem;
  }

  @media (max-width: 26rem) {
    .brand__text {
      font-size: 0.95rem;
    }
  }

  /* From here up the whole header fits on one row comfortably, so the
     drawer collapses back into the inline header it has always been and
     the menu button disappears. */
  @media (min-width: 60rem) {
    .site-header--js .site-menu,
    .site-header--js .site-menu.is-open {
      position: static;
      display: flex;
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
      gap: 0.5rem 0.75rem;
      max-height: none;
      overflow: visible;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
    }

    .site-header--js .site-menu.is-open .nav-list {
      display: flex;
      gap: 0.25rem;
    }

    .site-header--js .site-menu.is-open .nav-list a {
      display: inline-block;
      min-height: 0;
      padding: 0.4rem 0.7rem;
      background: none;
      font-size: 0.95rem;
    }

    .site-header--js .site-menu.is-open .nav-list a[aria-current='page'] {
      background: color-mix(in srgb, var(--accent) 14%, transparent);
    }

    .site-header--js .site-menu.is-open .team-search__input {
      width: 9rem;
    }

    .menu-toggle {
      display: none;
    }

    /* The "More" menu only makes sense once the nav is laid out as a single
       row rather than the mobile drawer - below this breakpoint the whole
       .nav-more-item stays display:none (see the base rule above) and every
       link renders flat, same as before this feature existed. */
    .nav-more-item {
      display: inline-flex;
      position: relative;
    }
  }
</style>

<script is:inline>
  // Mobile menu. The button ships hidden and the drawer ships expanded, so
  // a reader without JavaScript keeps the full, always-visible header; this
  // script is what swaps in the collapsed-by-default behaviour (it adds
  // .site-header--js, which is the only thing the collapsing CSS above keys
  // off) and reveals the button. Inline rather than bundled so the header
  // never renders in the wrong state for a frame.
  (function () {
    var header = document.querySelector('.site-header');
    var toggle = document.getElementById('menu-toggle');
    var menu = document.getElementById('site-menu');
    if (!header || !toggle || !menu) return;

    header.classList.add('site-header--js');
    toggle.hidden = false;

    function setOpen(open) {
      menu.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      var label = open ? toggle.dataset.labelClose : toggle.dataset.labelOpen;
      if (label) toggle.setAttribute('aria-label', label);
    }

    toggle.addEventListener('click', function () {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Escape closes and returns focus to the button, the usual disclosure
    // behaviour; clicking outside closes without stealing focus. (The
    // drawer's Tab-trap lives in the bundled script below - see its comment.)
    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', function (event) {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      var target = event.target;
      if (!(target instanceof Node)) return;
      if (!menu.contains(target) && !toggle.contains(target)) setOpen(false);
    });

    // Above the breakpoint the drawer is laid out inline again, so leaving
    // it "open" would mean coming back to a narrow viewport with the drawer
    // already down.
    window.matchMedia('(min-width: 60rem)').addEventListener('change', function (event) {
      if (event.matches) setOpen(false);
    });
  })();
</script>

<script is:inline>
  // The header's real height varies by viewport, page and locale: below the
  // 60rem breakpoint it is one bar plus a menu button, above it the nav
  // links wrap onto a second row (fifteen of them plus both search widgets,
  // the theme toggle and, on translated pages, the language switch don't fit
  // on one line even at the container's own max-width). Either way it is
  // nowhere near the single-line height a hardcoded CSS value would assume. Any other sticky element meant to sit just below this sticky,
  // higher-z-index header (e.g. the quiz page's score bar) needs that real
  // height, not a guess, or the header ends up covering it once both are
  // stuck. Exposed as a custom property so plain CSS can read it.
  (function () {
    var header = document.querySelector('.site-header');
    if (!header) return;

    function setHeaderHeight() {
      document.documentElement.style.setProperty('--site-header-height', header.offsetHeight + 'px');
    }

    setHeaderHeight();
    if ('ResizeObserver' in window) {
      new ResizeObserver(setHeaderHeight).observe(header);
    } else {
      window.addEventListener('resize', setHeaderHeight);
    }
  })();
</script>

<script>
  // "Find a team"/"Find a player" global quick-jump widgets - each an
  // editable ARIA 1.2 combobox
  // (https://www.w3.org/WAI/ARIA/apg/patterns/combobox/) that filters a
  // fetched name index as the reader types and sends Enter/click to
  // <target>?a=<id> (e.g. /compare?a=<id> or /compare-players?a=<id>,
  // English or Croatian) - the same shareable param each target page's own
  // two <select> pickers already read/write (src/pages/compare.astro,
  // src/pages/compare-players.astro), just reachable from anywhere on the
  // site instead of only from those pages' own dropdowns. Both widgets
  // share this one generic implementation below (initSearchWidget,
  // parameterized by idPrefix so their rendered option ids never collide,
  // e.g. `team-search-option-brazil` vs. `player-search-option-...`); only
  // their data-* config (endpoint, target, labels) and idPrefix differ. The
  // index is fetched lazily on first focus/keystroke rather than embedded
  // in every page's HTML (see src/pages/team-index.json.ts /
  // player-index.json.ts for why) - one shared bundled script (this file,
  // not is:inline, so it's a single cached chunk across every built page)
  // with no build-time data, config passed through each input's data-*
  // attributes the same way ThemeToggle.astro's script already does for
  // its Light/Dark labels.
  //
  // Internal names below (TeamIndexEntry, `teams`, `goToTeam`) predate the
  // player widget and are generic despite the name - both /team-index.json
  // and /player-index.json return the identical `{id, displayName}[]`
  // shape, so one implementation serves both without needing a rename.
  type TeamIndexEntry = { id: string; displayName: string };

  // Takes the three elements as typed parameters (rather than reading them
  // as closed-over module-level consts) so every nested helper below gets
  // definite, non-null types without needing a null check of its own -
  // TypeScript's flow narrowing from an outer `if` doesn't reliably persist
  // into nested function declarations.
  function initSearchWidget(
    input: HTMLInputElement,
    listbox: HTMLElement,
    status: HTMLElement,
    idPrefix: string,
  ) {
    const endpoint = input.dataset.endpoint ?? '';
    const target = input.dataset.target ?? '';
    const noResultsTemplate = input.dataset.noResultsTemplate ?? '';
    const loadingLabel = input.dataset.loadingLabel ?? '';
    const errorLabel = input.dataset.errorLabel ?? '';

    const MAX_RESULTS = 8;

    let teams: TeamIndexEntry[] | null = null;
    let loadPromise: Promise<TeamIndexEntry[]> | null = null;
    let activeId: string | null = null;
    let visible: TeamIndexEntry[] = [];

    // Diacritic-insensitive so e.g. typing "turkiye" still finds "Türkiye".
    function normalize(value: string): string {
      return value
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .toLowerCase()
        .trim();
    }

    function escapeHtml(value: string): string {
      return value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
    }

    function optionId(id: string): string {
      return `${idPrefix}-option-${id}`;
    }

    function closeListbox() {
      listbox.innerHTML = '';
      listbox.hidden = true;
      input.setAttribute('aria-expanded', 'false');
      input.removeAttribute('aria-activedescendant');
      activeId = null;
      visible = [];
    }

    function setActive(id: string | null) {
      activeId = id;
      for (const el of Array.from(listbox.querySelectorAll('[role="option"]'))) {
        const isActive = id !== null && el.id === optionId(id);
        el.setAttribute('aria-selected', isActive ? 'true' : 'false');
        el.classList.toggle('is-active', isActive);
      }
      if (id) {
        input.setAttribute('aria-activedescendant', optionId(id));
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    }

    function renderResults(query: string, matches: TeamIndexEntry[]) {
      visible = matches;

      if (matches.length === 0) {
        listbox.innerHTML = '';
        listbox.hidden = true;
        input.setAttribute('aria-expanded', 'false');
        input.removeAttribute('aria-activedescendant');
        activeId = null;
        status.textContent = noResultsTemplate.replace('{query}', query);
        return;
      }

      listbox.innerHTML = matches
        .map(
          (team) =>
            `<li role="option" id="${optionId(team.id)}" data-id="${escapeHtml(team.id)}" aria-selected="false">${escapeHtml(team.displayName)}</li>`,
        )
        .join('');
      listbox.hidden = false;
      input.setAttribute('aria-expanded', 'true');
      setActive(matches[0].id);
      status.textContent = '';
    }

    function filterAndRender() {
      const query = input.value.trim();
      if (!query || !teams) {
        closeListbox();
        status.textContent = '';
        return;
      }
      const needle = normalize(query);
      const matches = teams.filter((team) => normalize(team.displayName).includes(needle)).slice(0, MAX_RESULTS);
      renderResults(query, matches);
    }

    function ensureLoaded(): Promise<TeamIndexEntry[]> {
      if (teams) return Promise.resolve(teams);
      if (loadPromise) return loadPromise;
      status.textContent = loadingLabel;
      loadPromise = fetch(endpoint)
        .then((response) => {
          if (!response.ok) throw new Error(String(response.status));
          return response.json() as Promise<TeamIndexEntry[]>;
        })
        .then((data) => {
          teams = data;
          status.textContent = '';
          return data;
        })
        .catch(() => {
          status.textContent = errorLabel;
          loadPromise = null;
          return [] as TeamIndexEntry[];
        });
      return loadPromise;
    }

    function goToTeam(id: string) {
      if (!target) return;
      const url = new URL(target, window.location.origin);
      url.searchParams.set('a', id);
      window.location.href = `${url.pathname}${url.search}`;
    }

    input.addEventListener('focus', () => {
      ensureLoaded();
    });

    input.addEventListener('input', () => {
      ensureLoaded().then(filterAndRender);
    });

    input.addEventListener('keydown', (event) => {
      if (listbox.hidden && event.key !== 'ArrowDown') return;

      if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (listbox.hidden) {
          ensureLoaded().then(filterAndRender);
          return;
        }
        if (visible.length === 0) return;
        const currentIndex = visible.findIndex((team) => team.id === activeId);
        setActive(visible[(currentIndex + 1) % visible.length].id);
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (visible.length === 0) return;
        const currentIndex = visible.findIndex((team) => team.id === activeId);
        setActive(visible[(currentIndex - 1 + visible.length) % visible.length].id);
      } else if (event.key === 'Enter') {
        if (activeId) {
          event.preventDefault();
          goToTeam(activeId);
        }
      } else if (event.key === 'Escape') {
        if (!listbox.hidden) {
          event.preventDefault();
          closeListbox();
        } else {
          input.value = '';
        }
      }
    });

    listbox.addEventListener('click', (event) => {
      const option = event.target instanceof Element ? event.target.closest('[role="option"]') : null;
      const id = option?.getAttribute('data-id');
      if (id) goToTeam(id);
    });

    document.addEventListener('click', (event) => {
      if (!(event.target instanceof Node)) return;
      if (!input.contains(event.target) && !listbox.contains(event.target)) {
        closeListbox();
      }
    });
  }

  function initWidgetById(inputId: string, listboxId: string, statusId: string, idPrefix: string) {
    const input = document.getElementById(inputId);
    const listbox = document.getElementById(listboxId);
    const status = document.getElementById(statusId);
    if (input instanceof HTMLInputElement && listbox && status) {
      initSearchWidget(input, listbox, status, idPrefix);
    }
  }

  initWidgetById('team-search-input', 'team-search-listbox', 'team-search-status', 'team-search');
  initWidgetById('player-search-input', 'player-search-listbox', 'player-search-status', 'player-search');

  // Focus trap for the mobile nav drawer (#site-menu, toggled by
  // #menu-toggle in the is:inline script above - open/close and Escape stay
  // there, for the no-flash reason its own comment gives). Tab/Shift+Tab
  // cycles the toggle plus every focusable drawer control and wraps at
  // either end, instead of walking out into the page behind it. Lives in
  // this bundled, shared-across-pages script rather than the inline one: it
  // only matters after interaction, well after first paint, and keeping it
  // out of the per-page-duplicated inline script avoids growing every
  // single page's own HTML weight against check:perf's budget. Above the
  // 60rem breakpoint aria-expanded is always 'false' (see the inline
  // script's matchMedia listener), so the trap never engages there - the
  // nav is laid out inline at that width, not as a drawer overlay.
  (function initMenuFocusTrap() {
    const toggle = document.getElementById('menu-toggle');
    if (!toggle) return;

    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Tab' || toggle.getAttribute('aria-expanded') !== 'true') return;
      const items = [
        ...document.querySelectorAll<HTMLElement>('#menu-toggle,#site-menu :is(a,button,input)'),
      ].filter((el) => el.offsetParent !== null);
      const first = items[0];
      const last = items[items.length - 1];
      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });
  })();

  // Desktop-only "More" overflow menu (#nav-more-toggle/#nav-more-menu) -
  // see the frontmatter comment above SECONDARY_NAV_PATHS for why this
  // exists. Lives in this bundled script rather than the is:inline one for
  // the exact page-weight reason the focus trap above documents: this only
  // affects layout at >=60rem, and the inline script is duplicated raw into
  // every page's own HTML, which the site's heaviest pages (records,
  // hr/records) can no longer absorb without real headroom to spare (see
  // the 2026-08-23 focus-trap entry in docs/PROJECT_STATUS.md). The
  // tradeoff: since this script runs after first paint rather than inline,
  // a reader on a >=60rem viewport can see the un-collapsed, two-row nav
  // for a brief instant before it snaps into the single-row grouped layout,
  // instead of never seeing that state at all. Judged worth it - the
  // alternative (duplicating this per page) risks tipping records/hr-records
  // over check:perf's budget outright, a hard build failure, for a
  // sub-frame cosmetic flash.
  // Takes the elements as typed parameters (rather than reading them as
  // closed-over consts from inside the outer null check) for the same
  // reason initSearchWidget above does: TypeScript's flow narrowing from an
  // outer `if` doesn't reliably persist into nested function declarations.
  function initNavMore(list: HTMLElement, toggle: HTMLButtonElement, menu: HTMLElement, anchor: HTMLLIElement) {
    const items = [...list.querySelectorAll<HTMLLIElement>('li[data-nav-tier="secondary"]')];
    if (items.length === 0) return;

    let collapsed = false;

    function setOpen(open: boolean) {
      menu.hidden = !open;
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    // Moves the real <li> nodes between the flat row and the dropdown
    // rather than cloning them, so there is only ever one copy of each
    // link in the DOM - no duplicated hrefs for a screen reader to
    // announce twice, and no extra HTML weight either.
    function collapse() {
      if (collapsed) return;
      collapsed = true;
      for (const item of items) menu.appendChild(item);
      toggle.hidden = false;
    }

    function expand() {
      if (!collapsed) return;
      collapsed = false;
      setOpen(false);
      for (const item of items) list.insertBefore(item, anchor);
      toggle.hidden = true;
    }

    const query = window.matchMedia('(min-width: 60rem)');
    function sync() {
      if (query.matches) collapse();
      else expand();
    }

    sync();
    query.addEventListener('change', sync);

    toggle.addEventListener('click', () => {
      setOpen(toggle.getAttribute('aria-expanded') !== 'true');
    });

    // Escape-to-close plus click-outside, the same non-modal disclosure
    // pattern the mobile menu-toggle used before it grew a Tab-trap - this
    // dropdown never covers the viewport the way the mobile drawer does, so
    // per the WAI-ARIA APG it doesn't need one.
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener('click', (event) => {
      if (toggle.getAttribute('aria-expanded') !== 'true') return;
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (!menu.contains(target) && !toggle.contains(target)) setOpen(false);
    });
  }

  (function initNavMoreById() {
    const list = document.getElementById('nav-list');
    const toggle = document.getElementById('nav-more-toggle');
    const menu = document.getElementById('nav-more-menu');
    const anchor = toggle?.closest('li');
    if (
      list instanceof HTMLElement &&
      toggle instanceof HTMLButtonElement &&
      menu instanceof HTMLElement &&
      anchor instanceof HTMLLIElement
    ) {
      initNavMore(list, toggle, menu, anchor);
    }
  })();
</script>
