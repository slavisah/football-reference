---
import { withBase } from '../lib/url';
import { NAV_LINKS } from '../lib/routes';
import { t, type Locale } from '../lib/i18n';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  /** Defaults to 'en'; only pages with a translation pass this. */
  locale?: Locale;
  /** The equivalent page in the other language, if one exists. Omit to hide the switcher. */
  alternateHref?: string;
}

const { locale = 'en', alternateHref } = Astro.props;

const links = NAV_LINKS.map((link) => ({ href: withBase(link.path), label: link.label }));

const here = Astro.url.pathname.replace(/\/$/, '');
function isCurrent(href: string): boolean {
  return href.replace(/\/$/, '') === here;
}
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href={withBase('/')}>
      <span class="brand__mark" aria-hidden="true">⚽</span>
      <span class="brand__text">{t(locale, 'brand')}</span>
    </a>

    <nav aria-label="Primary">
      <ul class="nav-list">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                aria-current={isCurrent(link.href) ? 'page' : undefined}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    {
      alternateHref && (
        <a
          class="lang-switch"
          href={alternateHref}
          hreflang={locale === 'en' ? 'hr' : 'en'}
          rel="alternate"
        >
          {t(locale, 'switchLanguageTo')}
        </a>
      )
    }

    <ThemeToggle locale={locale} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: color-mix(in srgb, var(--bg-elevated) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: 0.75rem 1rem;
    flex-wrap: wrap;
    padding-block: 0.6rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--text);
    margin-right: auto;
  }

  .brand__mark {
    font-size: 1.25rem;
  }

  .nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-list a {
    display: inline-block;
    padding: 0.4rem 0.7rem;
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.95rem;
  }

  .nav-list a:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }

  .nav-list a[aria-current='page'] {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .lang-switch {
    padding: 0.4rem 0.6rem;
    border-radius: var(--radius);
    border: 1px solid var(--border);
    text-decoration: none;
    color: var(--text-muted);
    font-weight: 600;
    font-size: 0.85rem;
  }

  .lang-switch:hover {
    color: var(--text);
    background: var(--bg-subtle);
  }

  @media (max-width: 26rem) {
    .brand__text {
      font-size: 0.95rem;
    }
  }
</style>
