---
import type { QuizQuestion } from '../lib/quiz';
import { t, type Locale } from '../lib/i18n';

interface Props {
  question: QuizQuestion;
  index: number;
  /** Defaults to 'en'; only the Croatian quiz page passes 'hr'. */
  locale?: Locale;
}

const { question, index, locale = 'en' } = Astro.props;
const groupName = `quiz-${index}-answer`;
---

<div
  class="quiz-card card"
  id={`quiz-${index}`}
  data-answer-index={question.answerIndex}
  data-i18n-correct={t(locale, 'quizCorrect')}
  data-i18n-incorrect-prefix={t(locale, 'quizIncorrectPrefix')}
  data-i18n-incorrect-suffix={t(locale, 'quizIncorrectSuffix')}
  data-i18n-result-correct={t(locale, 'quizAnswerCorrectLabel')}
  data-i18n-result-incorrect={t(locale, 'quizAnswerIncorrectLabel')}
>
  <p class="quiz-card__category badge">{question.category}</p>

  <fieldset class="quiz-card__fieldset">
    <legend class="quiz-card__prompt">
      {index + 1}. {question.prompt}
    </legend>
    <div class="quiz-card__choices">
      {
        question.choices.map((choice, choiceIndex) => (
          <label class="quiz-card__choice">
            <input type="radio" name={groupName} value={choiceIndex} />
            <span>{choice}</span>
            <span class="quiz-card__result-badge"></span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <div class="quiz-card__controls no-print">
    <button type="button" class="quiz-card__check" hidden disabled>
      {t(locale, 'quizCheckAnswer')}
    </button>
    <p class="quiz-card__feedback" role="status" aria-live="polite"></p>
  </div>

  <details class="quiz-card__reveal">
    <summary>{t(locale, 'quizJustShowAnswer')}</summary>
    <p>{question.choices[question.answerIndex]}</p>
  </details>
</div>

<style>
  .quiz-card__category {
    margin: 0 0 0.6rem;
  }

  .quiz-card__fieldset {
    border: none;
    margin: 0;
    padding: 0;
  }

  .quiz-card__prompt {
    padding: 0;
    font-weight: 700;
    font-size: 1.05rem;
    margin-bottom: 0.7rem;
  }

  .quiz-card__choices {
    display: grid;
    gap: 0.5rem;
  }

  .quiz-card__choice {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    padding: 0.55rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg);
    cursor: pointer;
  }

  .quiz-card__choice:has(input:checked) {
    border-color: var(--accent);
  }

  .quiz-card__choice:has(input:disabled) {
    cursor: default;
  }

  .quiz-card__choice input {
    flex: none;
  }

  .quiz-card__choice.is-correct {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }

  .quiz-card__choice.is-incorrect {
    border-color: var(--danger);
    background: color-mix(in srgb, var(--danger) 16%, transparent);
  }

  /* Real DOM text, not ::after generated content - generated content isn't
     reliably exposed to screen readers, and this label is the only thing
     that isn't color alone conveying which choice was right/wrong (WCAG
     1.4.1). Populated by QuizScript.astro from the localized
     data-i18n-result-* attributes above; empty and untouched until the
     question is checked. */
  .quiz-card__result-badge {
    margin-left: auto;
    font-weight: 700;
    font-size: 0.8rem;
  }

  .quiz-card__choice.is-correct .quiz-card__result-badge {
    color: var(--accent);
  }

  .quiz-card__choice.is-incorrect .quiz-card__result-badge {
    color: var(--danger);
  }

  .quiz-card__controls {
    margin-top: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    min-height: 2.2rem;
  }

  .quiz-card__check {
    font: inherit;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius);
    border: 1px solid var(--accent);
    background: var(--accent);
    color: var(--accent-contrast);
    cursor: pointer;
  }

  .quiz-card__check:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .quiz-card__feedback {
    margin: 0;
    font-weight: 600;
  }

  .quiz-card__reveal {
    margin-top: 0.7rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .quiz-card__reveal summary {
    cursor: pointer;
  }
</style>
