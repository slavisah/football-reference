---
import type { ChampionSummary } from '../lib/types';

interface Props {
  champions: ChampionSummary[];
  /** Total editions, used to scale the bars. */
  scaleMax?: number;
  /** Unique id prefix, needed when more than one summary appears on a page. */
  id?: string;
  heading?: string;
  description?: string;
  /** Singular/plural noun for a count, e.g. ["award", "awards"]. */
  unit?: [string, string];
  /** Overridable for localized pages; default text matches the original English copy. */
  winningYearsLabel?: string;
  /** The word joining a bar's count and its scale, e.g. "3 of 5". Overridable for localized pages. */
  ofLabel?: string;
}

const {
  champions,
  scaleMax,
  id = 'champions',
  heading = 'Champions by titles',
  description = 'Generated automatically from the edition table above. Totals group a nation ' +
    'with its sporting predecessor only where the source content does (Germany ' +
    'includes West Germany); every other name is counted as written.',
  unit = ['title', 'titles'],
  winningYearsLabel = 'Winning years: ',
  ofLabel = 'of',
} = Astro.props;
const max = scaleMax ?? Math.max(1, ...champions.map((c) => c.titles));
const headingId = `${id}-heading`;
---

<section class="champions" aria-labelledby={headingId}>
  <h2 id={headingId}><span aria-hidden="true">🏆</span> {heading}</h2>
  <p class="muted">{description}</p>

  <ol class="champions__list">
    {
      champions.map((champion) => (
        <li class="champions__item">
          <div class="champions__row">
            <span class="champions__name">{champion.displayName}</span>
            <span class="champions__count">
              {champion.titles}
              <span class="visually-hidden">
                {champion.titles === 1 ? unit[0] : unit[1]}
              </span>
            </span>
          </div>
          <div
            class="champions__bar"
            role="img"
            aria-label={`${champion.titles} ${ofLabel} ${max}`}
          >
            <span
              class="champions__bar-fill"
              style={`width: ${(champion.titles / max) * 100}%`}
            />
          </div>
          <p class="champions__years">
            <span class="visually-hidden">{winningYearsLabel}</span>
            {champion.years.join(', ')}
          </p>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .champions__list {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.9rem;
  }

  .champions__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .champions__name {
    font-weight: 600;
  }

  .champions__count {
    font-variant-numeric: tabular-nums;
    font-weight: 700;
    color: var(--accent);
  }

  .champions__bar {
    margin: 0.35rem 0 0.3rem;
    height: 0.5rem;
    background: var(--bg-subtle);
    border-radius: 999px;
    overflow: hidden;
  }

  .champions__bar-fill {
    display: block;
    height: 100%;
    background: var(--accent);
    border-radius: 999px;
  }

  .champions__years {
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }
</style>
