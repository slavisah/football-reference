---
import type { Edition, MarkdownTable } from '../lib/types';
import { buildSortOptions, defaultSortValue } from '../lib/tableSort';
import type { Locale } from '../lib/i18n';

interface Props {
  /** Unique id prefix so multiple tables can coexist on a page. */
  id: string;
  caption: string;
  table: MarkdownTable;
  editions: Edition[];
  winners: string[];
  /** Distinct host values for the host filter; omit or pass [] to hide the filter. */
  hosts?: string[];
  /** Label for the winner filter/column, e.g. "Player" on a top-scorers table. */
  winnerLabel?: string;
  /**
   * An extra display-only column joined in by edition year, not part of the
   * source table (e.g. that edition's Golden Boot top scorer). Omitted rows
   * show an em dash rather than hiding the column.
   */
  extraColumn?: { label: string; values: Map<string, string> };
  /**
   * Overridable for localized pages; every default below matches the original
   * English copy, so existing call sites render byte-identical output.
   */
  locale?: Locale;
  /** Display-only column-header translations, keyed by the raw English header (e.g. "Year" -> "Godina"). */
  headerLabels?: Record<string, string>;
  yearLabel?: string;
  yearAllLabel?: string;
  hostLabel?: string;
  hostAllLabel?: string;
  winnerAllLabel?: string;
  sortByLabel?: string;
  resetLabel?: string;
  filterAriaLabel?: string;
  /** Uses the literal placeholder "{n}", replaced client-side with the edition count. */
  showingAllTemplate?: string;
  /** Uses the literal placeholders "{shown}", "{total}", "{bits}". */
  showingFilteredTemplate?: string;
  bitWinnerPrefix?: string;
  bitYearPrefix?: string;
  bitHostPrefix?: string;
  emptyText?: string;
  clearFiltersLabel?: string;
}

const {
  id,
  caption,
  table,
  editions,
  winners,
  hosts = [],
  winnerLabel = 'Winner',
  extraColumn,
  locale = 'en',
  headerLabels = {},
  yearLabel = 'Year',
  yearAllLabel = 'All years',
  hostLabel = 'Host',
  hostAllLabel = 'All hosts',
  winnerAllLabel = `All ${winnerLabel.toLowerCase()}s`,
  sortByLabel = 'Sort by',
  resetLabel = 'Reset',
  filterAriaLabel = `Filter ${caption}`,
  showingAllTemplate = 'Showing all {n} editions.',
  showingFilteredTemplate = 'Showing {shown} of {total} editions ({bits}).',
  bitWinnerPrefix = 'winner',
  bitYearPrefix = 'year',
  bitHostPrefix = 'host',
  emptyText = 'No editions match those filters.',
  clearFiltersLabel = 'Clear filters',
} = Astro.props;

// Years for the filter, newest first.
const years = [...editions]
  .sort((a, b) => b.yearSort - a.yearSort)
  .map((edition) => edition.year);

// Table rows, newest first (the source Markdown lists editions oldest first).
const displayEditions = [...editions].sort((a, b) => b.yearSort - a.yearSort);

// Which column holds the champion, so we can visually mark it.
const winnerColIndex = table.headers.findIndex((header) =>
  /winner|champion|player/i.test(header),
);

// A "Format" column (e.g. Copa América's league-table/final-playoff/
// knockout-final/home-and-away/special-edition audit) renders as a small
// badge, matching the existing status badge style, rather than plain text.
const formatColIndex = table.headers.findIndex((header) => /^format$/i.test(header.trim()));

// "Sort by" options: only the columns worth sorting by (Year/Season, Winner,
// Host, a numeric quantity column), detected the same way `buildEditions`
// derives those roles. Defaults to Year newest-first, matching the row order
// already rendered below, so no client-side re-sort is needed on first load.
const sortOptions = buildSortOptions(table.headers, { locale, headerLabels });
const defaultSort = defaultSortValue(sortOptions);
---

<section class="filters-and-table" aria-labelledby={`${id}-heading`}>
  <h2 id={`${id}-heading`} class="visually-hidden">{caption}</h2>

  <form
    class="filters no-print"
    id={`${id}-filters`}
    role="search"
    aria-label={filterAriaLabel}
  >
    <div class="filters__field">
      <label for={`${id}-winner`}>{winnerLabel}</label>
      <select id={`${id}-winner`} name="winner">
        <option value="">{winnerAllLabel}</option>
        {winners.map((winner) => <option value={winner}>{winner}</option>)}
      </select>
    </div>

    <div class="filters__field">
      <label for={`${id}-year`}>{yearLabel}</label>
      <select id={`${id}-year`} name="year">
        <option value="">{yearAllLabel}</option>
        {years.map((year) => <option value={year}>{year}</option>)}
      </select>
    </div>

    {
      hosts.length > 0 && (
        <div class="filters__field">
          <label for={`${id}-host`}>{hostLabel}</label>
          <select id={`${id}-host`} name="host">
            <option value="">{hostAllLabel}</option>
            {hosts.map((host) => <option value={host}>{host}</option>)}
          </select>
        </div>
      )
    }

    {
      sortOptions.length > 0 && (
        <div class="filters__field">
          <label for={`${id}-sort`}>{sortByLabel}</label>
          <select id={`${id}-sort`} name="sort">
            {sortOptions.map((option) => (
              <option
                value={option.value}
                selected={option.value === defaultSort}
                data-col={option.colIndex}
                data-dir={option.dir}
              >
                {option.label}
              </option>
            ))}
          </select>
        </div>
      )
    }

    <button type="button" class="filters__reset" id={`${id}-reset`}>
      {resetLabel}
    </button>

    <p class="filters__status" id={`${id}-status`} role="status" aria-live="polite">
      {showingAllTemplate.replace('{n}', String(editions.length))}
    </p>
  </form>

  <div class="t-wrap" tabindex="0" role="region" aria-label={caption}>
    <table class="t-table" id={`${id}-table`}>
      <caption>{caption}</caption>
      <thead>
        <tr>
          {table.headers.map((header) => <th scope="col">{headerLabels[header] ?? header}</th>)}
          {extraColumn && <th scope="col">{extraColumn.label}</th>}
        </tr>
      </thead>
      <tbody>
        {
          displayEditions.map((edition) => (
            <tr data-winner={edition.winner} data-year={edition.year} data-host={edition.host ?? ''}>
              {edition.cells.map((cell, index) => (
                <td
                  data-label={headerLabels[cell.label] ?? cell.label}
                  class={index === winnerColIndex ? 'is-winner' : undefined}
                >
                  {index === formatColIndex ? <span class="badge">{cell.value}</span> : cell.value}
                </td>
              ))}
              {extraColumn && (
                <td data-label={extraColumn.label}>
                  {extraColumn.values.get(edition.year) ?? '—'}
                </td>
              )}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>

  <p class="t-empty" id={`${id}-empty`} hidden>
    {emptyText} <button type="button" id={`${id}-empty-reset`} class="linkish">{clearFiltersLabel}</button>
  </p>
</section>

<style>
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    gap: 0.75rem 1rem;
    padding: 1rem;
    margin-bottom: 1rem;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .filters__field {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    min-width: 9rem;
    flex: 1 1 9rem;
  }

  .filters__field label {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-muted);
  }

  .filters select {
    font: inherit;
    padding: 0.5rem 0.6rem;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    width: 100%;
  }

  .filters__reset {
    font: inherit;
    padding: 0.55rem 0.9rem;
    color: var(--text);
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    cursor: pointer;
  }

  .filters__reset:hover {
    border-color: var(--accent);
  }

  .filters__status {
    flex-basis: 100%;
    margin: 0;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .t-wrap {
    overflow-x: auto;
    border-radius: var(--radius);
  }

  .t-table {
    width: 100%;
    border-collapse: collapse;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .t-table caption {
    text-align: left;
    padding: 0.75rem 0.85rem;
    font-weight: 600;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
  }

  .t-table th,
  .t-table td {
    padding: 0.55rem 0.7rem;
    text-align: left;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
  }

  .t-table thead th {
    position: sticky;
    top: 0;
    background: var(--bg-subtle);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .t-table tbody tr:hover {
    background: color-mix(in srgb, var(--accent) 7%, transparent);
  }

  .t-table td.is-winner {
    font-weight: 700;
    color: var(--accent);
  }

  .t-empty {
    padding: 1rem;
    text-align: center;
    color: var(--text-muted);
  }

  .linkish {
    font: inherit;
    color: var(--accent);
    background: none;
    border: none;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
  }

  /* --- Mobile: stack each row into a labelled card, no horizontal scroll --- */
  @media (max-width: 40rem) {
    .t-wrap {
      overflow-x: visible;
    }

    .t-table {
      border: none;
      background: transparent;
    }

    .t-table caption {
      border: none;
      padding-inline: 0.1rem;
    }

    .t-table thead {
      /* Keep headers available to assistive tech but off-screen visually. */
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .t-table tbody tr {
      display: block;
      margin-bottom: 0.85rem;
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      box-shadow: var(--shadow);
      overflow: hidden;
    }

    /* The block display above would otherwise override [hidden]'s display:none,
       so filtered-out rows must be re-hidden explicitly on mobile. */
    .t-table tbody tr[hidden] {
      display: none;
    }

    .t-table td {
      display: grid;
      grid-template-columns: 42% 1fr;
      gap: 0.5rem;
      border-bottom: 1px solid var(--border);
      padding: 0.5rem 0.7rem;
    }

    .t-table tbody tr td:last-child {
      border-bottom: none;
    }

    .t-table td::before {
      content: attr(data-label);
      font-weight: 600;
      font-size: 0.78rem;
      color: var(--text-muted);
    }

    .t-table td.is-winner {
      background: color-mix(in srgb, var(--accent) 9%, transparent);
    }
  }
</style>

<script
  is:inline
  define:vars={{
    id,
    total: editions.length,
    defaultSort,
    showingAllTemplate,
    showingFilteredTemplate,
    bitWinnerPrefix,
    bitYearPrefix,
    bitHostPrefix,
  }}
>
  const form = document.getElementById(`${id}-filters`);
  const winnerSel = document.getElementById(`${id}-winner`);
  const yearSel = document.getElementById(`${id}-year`);
  const hostSel = document.getElementById(`${id}-host`);
  const sortSel = document.getElementById(`${id}-sort`);
  const reset = document.getElementById(`${id}-reset`);
  const status = document.getElementById(`${id}-status`);
  const empty = document.getElementById(`${id}-empty`);
  const emptyReset = document.getElementById(`${id}-empty-reset`);
  const tbody = document.querySelector(`#${id}-table tbody`);
  const rows = Array.from(
    document.querySelectorAll(`#${id}-table tbody tr`),
  );

  // Numeric-aware, locale-collated compare so "2" sorts before "10" instead
  // of after it; blank cells and the "no data" em dash always sort last.
  // Mirrors src/lib/tableSort.ts's compareCellText (kept in sync manually -
  // this inline script can't import a module because of `define:vars`).
  const collator = new Intl.Collator(undefined, { numeric: true, sensitivity: 'base' });
  function compareCellText(a, b, dir) {
    const av = a.trim();
    const bv = b.trim();
    const aMissing = av === '' || av === '—';
    const bMissing = bv === '' || bv === '—';
    if (aMissing && bMissing) return 0;
    if (aMissing) return 1;
    if (bMissing) return -1;
    const cmp = collator.compare(av, bv);
    return dir === 'desc' ? -cmp : cmp;
  }

  function readParams() {
    const p = new URLSearchParams(window.location.search);
    return {
      winner: p.get('winner') || '',
      year: p.get('year') || '',
      host: p.get('host') || '',
      sort: p.get('sort') || '',
    };
  }

  function writeParams(winner, year, host, sort) {
    const p = new URLSearchParams(window.location.search);
    winner ? p.set('winner', winner) : p.delete('winner');
    year ? p.set('year', year) : p.delete('year');
    host ? p.set('host', host) : p.delete('host');
    sort && sort !== defaultSort ? p.set('sort', sort) : p.delete('sort');
    const qs = p.toString();
    const url = window.location.pathname + (qs ? `?${qs}` : '') + window.location.hash;
    window.history.replaceState({}, '', url);
  }

  function apply() {
    const winner = winnerSel.value;
    const year = yearSel.value;
    const host = hostSel ? hostSel.value : '';
    const sort = sortSel ? sortSel.value : '';
    let shown = 0;
    for (const row of rows) {
      const matchWinner = !winner || row.dataset.winner === winner;
      const matchYear = !year || row.dataset.year === year;
      const matchHost = !host || row.dataset.host === host;
      const visible = matchWinner && matchYear && matchHost;
      row.hidden = !visible;
      if (visible) shown += 1;
    }
    empty.hidden = shown !== 0;
    if (status) {
      if (!winner && !year && !host) {
        status.textContent = showingAllTemplate.replace('{n}', String(total));
      } else {
        const bits = [];
        if (winner) bits.push(`${bitWinnerPrefix} ${winner}`);
        if (year) bits.push(`${bitYearPrefix} ${year}`);
        if (host) bits.push(`${bitHostPrefix} ${host}`);
        status.textContent = showingFilteredTemplate
          .replace('{shown}', String(shown))
          .replace('{total}', String(total))
          .replace('{bits}', bits.join(', '));
      }
    }
    writeParams(winner, year, host, sort);
  }

  // Reorders the actual <tr> elements in the DOM; never touches a cell's
  // content, so any historical note in a row (e.g. Ballon d'Or's "Not
  // awarded" 2020 row) survives a sort verbatim, just in a new position.
  function applySort() {
    if (!sortSel || !tbody) return;
    const option = sortSel.selectedOptions[0];
    if (!option) return;
    const col = Number(option.dataset.col);
    const dir = option.dataset.dir;
    const sorted = [...rows].sort((a, b) => {
      const av = a.children[col]?.textContent ?? '';
      const bv = b.children[col]?.textContent ?? '';
      return compareCellText(av, bv, dir);
    });
    for (const row of sorted) tbody.appendChild(row);
  }

  function clearAll() {
    winnerSel.value = '';
    yearSel.value = '';
    if (hostSel) hostSel.value = '';
    if (sortSel) {
      sortSel.value = defaultSort;
      applySort();
    }
    apply();
  }

  // Restore filters (and sort) from the URL so shared links reproduce the view.
  const initial = readParams();
  if ([...winnerSel.options].some((o) => o.value === initial.winner)) {
    winnerSel.value = initial.winner;
  }
  if ([...yearSel.options].some((o) => o.value === initial.year)) {
    yearSel.value = initial.year;
  }
  if (hostSel && [...hostSel.options].some((o) => o.value === initial.host)) {
    hostSel.value = initial.host;
  }
  if (sortSel && initial.sort && [...sortSel.options].some((o) => o.value === initial.sort)) {
    sortSel.value = initial.sort;
    applySort();
  }

  winnerSel.addEventListener('change', apply);
  yearSel.addEventListener('change', apply);
  hostSel?.addEventListener('change', apply);
  sortSel?.addEventListener('change', () => {
    applySort();
    apply();
  });
  reset.addEventListener('click', clearAll);
  emptyReset?.addEventListener('click', clearAll);
  form.addEventListener('submit', (e) => e.preventDefault());

  apply();
</script>
