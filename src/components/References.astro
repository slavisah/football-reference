---
import type { SourceLink } from '../lib/sources';

interface Props {
  sources: SourceLink[];
  lastReviewed: string;
  status: string;
  /**
   * Overridable for localized pages; every default below matches the
   * original English copy, so existing call sites render byte-identical
   * output. `statusText` defaults to the raw `status` value (unchanged
   * behavior) - pass a translated word (e.g. "Provjereno") to override it.
   */
  heading?: string;
  statusPrefix?: string;
  statusText?: string;
  lastReviewedPrefix?: string;
  noSourcesText?: string;
  noteText?: string;
  dateLocale?: string;
}

const {
  sources,
  lastReviewed,
  status,
  heading = 'References & review',
  statusPrefix = 'Status:',
  statusText = status,
  lastReviewedPrefix = 'Last reviewed:',
  noSourcesText = 'No source links are listed for this competition yet.',
  noteText = "Primary sources are preferred. Historical formats and team names are recorded " +
    "as used at the time; see each edition's notes for context.",
  dateLocale = 'en-GB',
} = Astro.props;
const reviewed = new Date(`${lastReviewed}T00:00:00Z`);
const reviewedLabel = Number.isNaN(reviewed.getTime())
  ? lastReviewed
  : reviewed.toLocaleDateString(dateLocale, {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
      timeZone: 'UTC',
    });
---

<section class="references card" aria-labelledby="references-heading">
  <h2 id="references-heading"><span aria-hidden="true">📚</span> {heading}</h2>

  <p class="references__meta">
    <span class="badge">{statusPrefix} {statusText}</span>
    <span class="review">
      {lastReviewedPrefix}
      <time datetime={lastReviewed}>{reviewedLabel}</time>
    </span>
  </p>

  {
    sources.length > 0 ? (
      <ul class="references__list">
        {sources.map((source) => (
          <li>
            <a href={source.url} rel="nofollow noopener external" target="_blank">
              {source.label}
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="muted">{noSourcesText}</p>
    )
  }

  <p class="muted references__note">{noteText}</p>
</section>

<style>
  .references__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: 0;
  }

  .review {
    font-size: 0.9rem;
    color: var(--text-muted);
  }

  .references__list {
    margin: 0.75rem 0 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.35rem;
  }

  .references__list a {
    word-break: break-word;
  }

  .references__note {
    margin-bottom: 0;
    font-size: 0.85rem;
  }
</style>
