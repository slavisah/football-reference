---
import { renderInlineMarkdown, slugifyHeadings, type NoteSection } from '../lib/notes';

interface Props {
  sections: NoteSection[];
  /** Localized label for the jump-nav heading; defaults to English. */
  jumpNavLabel?: string;
}

const { sections, jumpNavLabel = 'Jump to a section' } = Astro.props;

// Decorative-only accent per section type; screen readers get the plain heading text.
function iconFor(heading: string): string {
  if (/moment/i.test(heading)) return '🎉';
  if (/how it works|kako funkcionira/i.test(heading)) return 'ℹ️';
  return '📝';
}

const ids = slugifyHeadings(sections.map((section) => section.heading));

// A short page (home, quiz) has too few cards for a jump nav to earn its
// keep; every competition/award page has well past this many.
const JUMP_NAV_MIN_SECTIONS = 4;
---

{
  sections.length > 0 && (
    <div class="notes stack">
      {sections.length >= JUMP_NAV_MIN_SECTIONS && (
        <nav class="notes__nav card no-print" aria-label={jumpNavLabel}>
          <ul class="notes__nav-list">
            {sections.map((section, index) => (
              <li>
                <a href={`#${ids[index]}`}>{section.heading}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
      {sections.map((section, index) => (
        <section class="notes__card card" id={ids[index]} aria-labelledby={`note-heading-${index}`}>
          <h2 id={`note-heading-${index}`}>
            <span aria-hidden="true">{iconFor(section.heading)}</span>{' '}
            {section.heading}
          </h2>
          {section.intro && <p class="notes__intro" set:html={renderInlineMarkdown(section.intro)} />}
          {section.items.length > 1 ? (
            <ul class="notes__list">
              {section.items.map((item) => (
                <li set:html={renderInlineMarkdown(item)} />
              ))}
            </ul>
          ) : (
            <p set:html={renderInlineMarkdown(section.items[0])} />
          )}
        </section>
      ))}
    </div>
  )
}

<style>
  .notes__nav-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .notes__nav-list a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    padding: 0.4rem 0.9rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--bg-subtle);
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  .notes__nav-list a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .notes__card h2 {
    font-size: 1.15rem;
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .notes__card p {
    margin-bottom: 0;
    color: var(--text-muted);
  }

  .notes__card p.notes__intro {
    margin-bottom: 0.6rem;
  }

  .notes__list {
    margin: 0;
    padding-left: 1.2rem;
    display: grid;
    gap: 0.4rem;
    color: var(--text-muted);
  }
</style>
