---
import { withBase } from '../lib/url';
import { t, type Locale } from '../lib/i18n';

interface Props {
  /** Defaults to 'en'; only pages with a translation pass this. */
  locale?: Locale;
}

const { locale = 'en' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p class="muted">{t(locale, 'footerTagline')}</p>
    <p class="muted">
      &copy; {year}. {t(locale, 'footerCopyright')}
      <a href={withBase(locale === 'hr' ? '/hr/about/sources' : '/about/sources')}>
        {t(locale, 'footerSourcesLink')}
      </a>.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
    padding-block: 1.5rem;
    margin-top: 2.5rem;
    font-size: 0.9rem;
  }

  .site-footer p {
    margin: 0.25rem 0;
    max-width: 60ch;
  }
</style>
