---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <p class="muted">
      The Ultimate Football Reference &middot; a family-friendly, source-conscious
      history project. Content is the editorial source of truth; historical team
      names are preserved.
    </p>
    <p class="muted">
      &copy; {year}. No tournament logos, betting content, ads, or trackers.
    </p>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background: var(--bg-elevated);
    padding-block: 1.5rem;
    margin-top: 2.5rem;
    font-size: 0.9rem;
  }

  .site-footer p {
    margin: 0.25rem 0;
    max-width: 60ch;
  }
</style>
