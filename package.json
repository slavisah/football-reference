{
  "name": "football-reference",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "The Ultimate Football Reference - a family-friendly static football-history website built from Markdown.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "build:pdfs": "node scripts/generate-pdfs.mjs",
    "generate:og-image": "node scripts/generate-og-image.mjs",
    "check:pdfs": "node scripts/check-pdf-freshness.mjs",
    "check:perf": "node scripts/check-page-weight.mjs",
    "check:links": "node scripts/check-internal-links.mjs",
    "check:sitemap": "node scripts/check-sitemap.mjs",
    "check:precache": "node scripts/check-precache.mjs",
    "check:lighthouse": "node scripts/check-lighthouse.mjs",
    "check:reflow": "node scripts/check-reflow.mjs",
    "check:text-zoom": "node scripts/check-text-zoom.mjs",
    "check:print-width": "node scripts/check-print-width.mjs",
    "check:html": "node scripts/check-html-validity.mjs",
    "check:jsonld": "node scripts/check-jsonld.mjs",
    "check:meta": "node scripts/check-meta.mjs",
    "check:spelling": "cspell --no-progress \"content/**/*.md\""
  },
  "dependencies": {
    "astro": "^7.3.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.0",
    "@vitest/coverage-v8": "5.0.0",
    "cspell": "^10.3.0",
    "html-validate": "^11.15.0",
    "lighthouse": "^13.4.1",
    "sharp": "0.35.4",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@9.15.9"
}
